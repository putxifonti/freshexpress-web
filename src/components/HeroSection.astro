---

---

<section class="bg-white min-h-[calc(100vh-80px)] flex items-center">
  <div class="container mx-auto px-4 py-12 lg:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-6 lg:space-y-8">
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-bold text-[#0047AB] leading-tight"
        >
          Frescor. Velocitat. Garantit en Menys de
          <span class="text-[#3BB143]">30 Minuts</span>.
        </h1>

        <p class="text-lg md:text-xl text-gray-700 leading-relaxed">
          La xarxa de microcentres més ràpida per a aliments, farmàcia i
          productes d'alta rotació a la teva ciutat.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 pt-4">
          <a
            href="#cobertura"
            class="inline-flex items-center justify-center px-8 py-4 bg-[#3BB143] text-white text-lg font-semibold rounded-lg hover:bg-[#32a039] transition-all duration-200 shadow-lg hover:shadow-xl hover:scale-105 transform"
          >
            Comprova la Cobertura al teu Barri
            <svg
              class="w-5 h-5 ml-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </a>

          <a
            href="#com-funciona"
            class="inline-flex items-center justify-center px-8 py-4 bg-white text-[#0047AB] text-lg font-semibold rounded-lg border-2 border-[#0047AB] hover:bg-[#0047AB] hover:text-white transition-all duration-200 shadow-md hover:shadow-lg"
          >
            Com Funciona
          </a>
        </div>

        <div
          class="flex flex-wrap items-center gap-6 pt-6 border-t border-gray-200"
        >
          <div class="flex items-center space-x-2">
            <svg
              class="w-6 h-6 text-[#3BB143]"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-sm font-medium text-gray-700"
              >Entrega en 30 min</span
            >
          </div>

          <div class="flex items-center space-x-2">
            <svg
              class="w-6 h-6 text-[#3BB143]"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-sm font-medium text-gray-700"
              >Productes frescos</span
            >
          </div>

          <div class="flex items-center space-x-2">
            <svg
              class="w-6 h-6 text-[#3BB143]"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-sm font-medium text-gray-700"
              >Sense comissions ocultes</span
            >
          </div>
        </div>
      </div>

      <div class="relative">
        <div class="relative z-10">
          <div
            class="absolute -top-10 -right-10 w-72 h-72 bg-[#3BB143] opacity-10 rounded-full blur-3xl"
          >
          </div>
          <div
            class="absolute -bottom-10 -left-10 w-72 h-72 bg-[#0047AB] opacity-10 rounded-full blur-3xl"
          >
          </div>

          <div
            class="relative bg-gradient-to-br from-[#0047AB] to-[#3BB143] rounded-2xl p-8 shadow-2xl"
          >
            <div class="aspect-square flex items-center justify-center">
              <svg
                class="w-full h-full text-white opacity-90"
                viewBox="0 0 400 400"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <circle
                  cx="200"
                  cy="140"
                  r="40"
                  fill="currentColor"
                  opacity="0.9"></circle>
                <rect
                  x="170"
                  y="180"
                  width="60"
                  height="80"
                  rx="10"
                  fill="currentColor"
                  opacity="0.9"></rect>
                <rect
                  x="150"
                  y="260"
                  width="30"
                  height="60"
                  rx="5"
                  fill="currentColor"
                  opacity="0.9"></rect>
                <rect
                  x="220"
                  y="260"
                  width="30"
                  height="60"
                  rx="5"
                  fill="currentColor"
                  opacity="0.9"></rect>

                <rect
                  x="260"
                  y="150"
                  width="100"
                  height="100"
                  rx="10"
                  fill="white"
                  opacity="0.95"></rect>
                <path
                  d="M310 180 L290 210 L310 210 L310 220 L330 190 L310 190 Z"
                  fill="#3BB143"></path>

                <line
                  x1="50"
                  y1="200"
                  x2="120"
                  y2="200"
                  stroke="currentColor"
                  stroke-width="4"
                  stroke-linecap="round"
                  opacity="0.6"></line>
                <line
                  x1="60"
                  y1="220"
                  x2="110"
                  y2="220"
                  stroke="currentColor"
                  stroke-width="4"
                  stroke-linecap="round"
                  opacity="0.4"></line>
                <line
                  x1="70"
                  y1="240"
                  x2="120"
                  y2="240"
                  stroke="currentColor"
                  stroke-width="4"
                  stroke-linecap="round"
                  opacity="0.3"></line>
              </svg>
            </div>

            <div
              class="absolute -top-6 -left-6 bg-white rounded-full p-4 shadow-xl border-4 border-[#3BB143]"
            >
              <div class="text-center">
                <div class="text-3xl font-bold text-[#0047AB]">30</div>
                <div class="text-xs font-semibold text-gray-600 uppercase">
                  Minuts
                </div>
              </div>
            </div>

            <div
              class="absolute -bottom-4 -right-4 bg-[#3BB143] rounded-full p-4 shadow-xl"
            >
              <svg
                class="w-12 h-12 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Animació subtil per al CTA */
  @keyframes pulse-gentle {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.02);
    }
  }
</style>
