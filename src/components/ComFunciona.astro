---

---

<section
  id="com-funciona"
  class="bg-white min-h-screen flex items-center py-20 flex-1"
>
  <div class="container mx-auto px-4">
    <div class="text-center mb-16 pt-8">
      <h2 class="text-4xl md:text-5xl font-bold text-[#3BB143] mb-4">
        La Clau de la Nostra Velocitat
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Tres passos senzills per portar els teus productes frescos en temps
        rècord
      </p>
    </div>

    <div class="max-w-5xl mx-auto">
      <div class="relative">
        <div
          class="hidden md:block absolute top-24 left-0 right-0 h-1 bg-gradient-to-r from-[#0047AB] via-[#3BB143] to-[#0047AB] opacity-20"
        >
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8">
          <div class="relative">
            <div class="flex items-center justify-center md:justify-start mb-6">
              <div
                class="w-16 h-16 bg-[#0047AB] rounded-full flex items-center justify-center shadow-lg relative z-10"
              >
                <span class="text-3xl font-bold text-white">1</span>
              </div>
              <div
                class="md:hidden absolute top-16 left-8 w-0.5 h-32 bg-gradient-to-b from-[#0047AB] to-[#3BB143] opacity-30"
              >
              </div>
            </div>

            <div
              class="bg-gradient-to-br from-[#0047AB] to-[#0047AB]/80 rounded-2xl p-8 text-white shadow-xl hover:shadow-2xl transition-all duration-300 hover:scale-105"
            >
              <!-- Icona il·lustrativa -->
              <div class="mb-6">
                <svg
                  class="w-16 h-16 text-white opacity-90"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                  ></path>
                </svg>
              </div>

              <h3 class="text-2xl font-bold mb-4">Comanda Entrant</h3>

              <p class="text-white/90 leading-relaxed mb-4">
                Reps una comanda a través de l'app o web. El sistema detecta
                automàticament el microcentre més proper a la destinació.
              </p>

              <ul class="space-y-2">
                <li class="flex items-start">
                  <svg
                    class="w-5 h-5 text-[#3BB143] mr-2 mt-0.5 flex-shrink-0"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-sm">Confirmació instantània</span>
                </li>
                <li class="flex items-start">
                  <svg
                    class="w-5 h-5 text-[#3BB143] mr-2 mt-0.5 flex-shrink-0"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-sm">Assignació intel·ligent</span>
                </li>
              </ul>
            </div>
          </div>

          <div class="relative">
            <div class="flex items-center justify-center md:justify-start mb-6">
              <div
                class="w-16 h-16 bg-[#3BB143] rounded-full flex items-center justify-center shadow-lg relative z-10"
              >
                <span class="text-3xl font-bold text-white">2</span>
              </div>
              <div
                class="md:hidden absolute top-16 left-8 w-0.5 h-32 bg-gradient-to-b from-[#3BB143] to-[#0047AB] opacity-30"
              >
              </div>
            </div>

            <div
              class="bg-gradient-to-br from-[#3BB143] to-[#3BB143]/80 rounded-2xl p-8 text-white shadow-xl hover:shadow-2xl transition-all duration-300 hover:scale-105"
            >
              <div class="mb-6">
                <svg
                  class="w-16 h-16 text-white opacity-90"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                  ></path>
                </svg>
              </div>

              <h3 class="text-2xl font-bold mb-4">Preparació al Microcentre</h3>

              <p class="text-white/90 leading-relaxed mb-4">
                El personal del microcentre més proper prepara la comanda amb
                els productes frescos emmagatzemats a temperatura controlada.
              </p>

              <ul class="space-y-2">
                <li class="flex items-start">
                  <svg
                    class="w-5 h-5 text-[#0047AB] mr-2 mt-0.5 flex-shrink-0"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-sm">Empaquetat professional</span>
                </li>
                <li class="flex items-start">
                  <svg
                    class="w-5 h-5 text-[#0047AB] mr-2 mt-0.5 flex-shrink-0"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-sm">Control de qualitat</span>
                </li>
              </ul>
            </div>
          </div>

          <div class="relative">
            <div class="flex items-center justify-center md:justify-start mb-6">
              <div
                class="w-16 h-16 bg-[#0047AB] rounded-full flex items-center justify-center shadow-lg relative z-10"
              >
                <span class="text-3xl font-bold text-white">3</span>
              </div>
            </div>

            <div
              class="bg-gradient-to-br from-[#0047AB] to-[#0047AB]/80 rounded-2xl p-8 text-white shadow-xl hover:shadow-2xl transition-all duration-300 hover:scale-105"
            >
              <div class="mb-6">
                <svg
                  class="w-16 h-16 text-white opacity-90"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M13 10V3L4 14h7v7l9-11h-7z"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"></path>
                </svg>
              </div>

              <h3 class="text-2xl font-bold mb-4">Repartiment (≤ 30 min)</h3>

              <p class="text-white/90 leading-relaxed mb-4">
                El rider recull la comanda i la porta directament a la porta de
                casa teva en menys de 30 minuts, garantint la frescor màxima.
              </p>

              <ul class="space-y-2">
                <li class="flex items-start">
                  <svg
                    class="w-5 h-5 text-[#3BB143] mr-2 mt-0.5 flex-shrink-0"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-sm">Seguiment en temps real</span>
                </li>
                <li class="flex items-start">
                  <svg
                    class="w-5 h-5 text-[#3BB143] mr-2 mt-0.5 flex-shrink-0"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-sm">Entrega contactless</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
