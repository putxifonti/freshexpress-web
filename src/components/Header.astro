---
// Header.astro - Component de capçalera dinàmic per FreshExpress
// Selecciona automàticament el header segons el rol de l'usuari
import { verifyToken, getUserById } from "../lib/auth";
import HeaderPublic from "./headers/HeaderPublic.astro";
import HeaderClient from "./headers/HeaderClient.astro";
import HeaderRepartidor from "./headers/HeaderRepartidor.astro";
import HeaderAdmin from "./headers/HeaderAdmin.astro";

// Verificar si l'usuari està autenticat
const token = Astro.cookies.get("auth_token")?.value;
let user = null;
let userRole = "public"; // public, cliente, repartidor, admin

if (token) {
  const payload = verifyToken(token);
  if (payload) {
    user = await getUserById(payload.userId);
    if (user) {
      userRole = user.rol || "cliente";
    }
  }
}
---

{
  userRole === "admin" && user ? (
    <HeaderAdmin user={user} />
  ) : userRole === "repartidor" && user ? (
    <HeaderRepartidor user={user} />
  ) : user ? (
    <HeaderClient user={user} />
  ) : (
    <HeaderPublic />
  )
}
