---
import Layout from "../../layouts/Layout.astro";
import { verifyToken, getUserById } from "../../lib/auth";
import { queryOperacional } from "../../lib/db";

// Verificar autenticació i rol
const token = Astro.cookies.get("auth_token")?.value;
let user = null;
let repartidor = null;

if (token) {
  const payload = verifyToken(token);
  if (payload) {
    user = await getUserById(payload.userId);
  }
}

if (!user || user.rol !== "repartidor") {
  return Astro.redirect("/dashboard");
}

// Obtenir dades del repartidor
try {
  const repartidorData = await queryOperacional<any[]>(
    "SELECT * FROM repartidores WHERE usuario_id = ?",
    [user.id]
  );
  repartidor = repartidorData[0] || null;
} catch (error) {
  console.error("Error obtenint dades repartidor:", error);
}

const vehiculosTipus = [
  { value: "bicicleta", label: "Bicicleta", icon: "🚲" },
  { value: "moto", label: "Moto", icon: "🏍️" },
  { value: "coche", label: "Cotxe", icon: "🚗" },
  { value: "furgoneta", label: "Furgoneta", icon: "🚐" },
  { value: "a_pie", label: "A peu", icon: "🚶" },
];
---

<Layout title="Configuració - Repartidor - FreshExpress">
  <div class="min-h-screen bg-gray-100 py-6">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Navegació -->
      <div class="mb-6">
        <a
          href="/repartidor"
          class="text-[#3BB143] hover:text-[#32a039] text-sm font-medium flex items-center"
        >
          <svg
            class="w-4 h-4 mr-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"></path>
          </svg>
          Tornar al panell
        </a>
      </div>

      <h1 class="text-2xl font-bold text-gray-900 mb-6">
        Configuració del perfil
      </h1>

      <!-- Informació personal -->
      <div class="bg-white rounded-xl shadow p-6 mb-6">
        <h2 class="font-semibold text-gray-900 mb-4 flex items-center">
          <svg
            class="w-5 h-5 mr-2 text-[#0047AB]"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
            ></path>
          </svg>
          Informació personal
        </h2>

        <form id="profile-form" class="space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Nom complet</label
              >
              <input
                type="text"
                name="nombre"
                value={user.nombre}
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3BB143] focus:border-transparent"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Email</label
              >
              <input
                type="email"
                name="email"
                value={user.email}
                disabled
                class="w-full px-4 py-2 border border-gray-200 rounded-lg bg-gray-50 text-gray-500 cursor-not-allowed"
              />
              <p class="text-xs text-gray-500 mt-1">
                L'email no es pot canviar
              </p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Telèfon</label
              >
              <input
                type="tel"
                name="telefono"
                value={user.telefono || ""}
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3BB143] focus:border-transparent"
              />
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1"
              >Adreça</label
            >
            <input
              type="text"
              name="direccion"
              value={user.direccion || ""}
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3BB143] focus:border-transparent"
              placeholder="Carrer, número, pis..."
            />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Ciutat</label
              >
              <input
                type="text"
                name="ciudad"
                value={user.ciudad || ""}
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3BB143] focus:border-transparent"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Codi postal</label
              >
              <input
                type="text"
                name="codigo_postal"
                value={user.codigo_postal || ""}
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3BB143] focus:border-transparent"
              />
            </div>
          </div>

          <div class="pt-4">
            <button
              type="submit"
              class="px-6 py-2 bg-[#3BB143] text-white font-semibold rounded-lg hover:bg-[#32a039] transition-colors"
            >
              Guardar canvis
            </button>
          </div>
        </form>
      </div>

      <!-- Canviar contrasenya -->
      <div class="bg-white rounded-xl shadow p-6 mb-6">
        <h2 class="font-semibold text-gray-900 mb-4 flex items-center">
          <svg
            class="w-5 h-5 mr-2 text-[#0047AB]"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
            ></path>
          </svg>
          Canviar contrasenya
        </h2>

        <form id="password-form" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1"
              >Contrasenya actual</label
            >
            <input
              type="password"
              name="current_password"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3BB143] focus:border-transparent"
            />
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Nova contrasenya</label
              >
              <input
                type="password"
                name="new_password"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3BB143] focus:border-transparent"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Confirmar nova contrasenya</label
              >
              <input
                type="password"
                name="confirm_password"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3BB143] focus:border-transparent"
              />
            </div>
          </div>
          <div class="pt-4">
            <button
              type="submit"
              class="px-6 py-2 bg-[#0047AB] text-white font-semibold rounded-lg hover:bg-[#003a8c] transition-colors"
            >
              Canviar contrasenya
            </button>
          </div>
        </form>
      </div>

      <!-- Zona perillosa: Deixar de ser repartidor -->
      <div class="bg-white rounded-xl shadow p-6 border-2 border-red-200">
        <h2 class="font-semibold text-red-600 mb-4 flex items-center">
          <svg
            class="w-5 h-5 mr-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
            ></path>
          </svg>
          Zona perillosa
        </h2>

        <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-4">
          <p class="text-sm text-red-800 mb-2">
            <strong>Atenció:</strong> Si deixes de ser repartidor, perdràs l'accés
            al panell de repartidor i:
          </p>
          <ul class="text-sm text-red-700 list-disc list-inside space-y-1">
            <li>No podràs acceptar més comandes</li>
            <li>Es deuran finalitzar totes les comandes pendents abans</li>
            <li>L'historial de guanys es mantindrà registrat</li>
            <li>El teu compte es convertirà en compte de client</li>
          </ul>
        </div>

        <div
          id="deixar-error"
          class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm mb-4"
        >
        </div>

        <button
          type="button"
          id="deixar-repartidor-btn"
          class="px-6 py-2 bg-red-600 text-white font-semibold rounded-lg hover:bg-red-700 transition-colors"
        >
          Deixar de ser repartidor
        </button>
      </div>

      <h2 class="text-xl font-bold text-gray-900 mb-4">
        Configuració de repartidor
      </h2>

      <form id="config-form" class="space-y-6">
        <!-- Estat Actiu/Inactiu -->
        <div class="bg-white rounded-xl shadow p-6">
          <h2 class="font-semibold text-gray-900 mb-4">
            Estat de disponibilitat
          </h2>
          <div
            class="flex items-center justify-between p-4 bg-gray-50 rounded-lg"
          >
            <div class="flex-1">
              <p class="font-medium text-gray-900" id="estat-text">
                {repartidor?.disponible === 1 ? "Actiu" : "Inactiu"}
              </p>
              <p class="text-sm text-gray-600 mt-1">
                {
                  repartidor?.disponible === 1
                    ? "Pots rebre comandes per repartir"
                    : "No rebràs comandes fins que activis aquest estat"
                }
              </p>
            </div>
            <button
              type="button"
              id="toggle-disponibilitat"
              class={`relative inline-flex h-8 w-14 items-center rounded-full transition-colors ${
                repartidor?.disponible === 1 ? "bg-[#3BB143]" : "bg-gray-300"
              }`}
              data-active={repartidor?.disponible === 1 ? "true" : "false"}
            >
              <span
                class={`inline-block h-6 w-6 transform rounded-full bg-white transition-transform ${
                  repartidor?.disponible === 1
                    ? "translate-x-7"
                    : "translate-x-1"
                }`}></span>
            </button>
          </div>
        </div>

        <!-- Tipus de vehicle -->
        <div class="bg-white rounded-xl shadow p-6">
          <h2 class="font-semibold text-gray-900 mb-4">Vehicle</h2>
          <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
            {
              vehiculosTipus.map((v) => (
                <label
                  class={`relative flex flex-col items-center p-4 rounded-lg border-2 cursor-pointer transition-all ${
                    repartidor?.vehiculo_tipo === v.value
                      ? "border-[#3BB143] bg-green-50"
                      : "border-gray-200 hover:border-gray-300"
                  }`}
                >
                  <input
                    type="radio"
                    name="vehiculo_tipo"
                    value={v.value}
                    checked={repartidor?.vehiculo_tipo === v.value}
                    class="sr-only"
                  />
                  <span class="text-2xl mb-1">{v.icon}</span>
                  <span class="text-sm text-gray-700">{v.label}</span>
                </label>
              ))
            }
          </div>

          <div class="mt-4" id="matricula-container" style="display: none;">
            <label class="block text-sm font-medium text-gray-700 mb-1"
              >Matrícula <span
                class="text-red-500"
                id="matricula-required"
                style="display: none;">*</span
              ></label
            >
            <input
              type="text"
              name="matricula"
              id="matricula-input"
              value={repartidor?.matricula || ""}
              placeholder="0000 XXX"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3BB143] focus:border-transparent outline-none"
            />
          </div>
        </div>

        <!-- Zona i radi -->
        <div class="bg-white rounded-xl shadow p-6">
          <h2 class="font-semibold text-gray-900 mb-4">Zona de treball</h2>

          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Zona preferida</label
              >
              <select
                name="zona_preferida"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3BB143] focus:border-transparent outline-none"
              >
                <option value="">Sense preferència</option>
                <option
                  value="Ciutat Vella"
                  selected={repartidor?.zona_preferida === "Ciutat Vella"}
                  >Ciutat Vella</option
                >
                <option
                  value="Eixample"
                  selected={repartidor?.zona_preferida === "Eixample"}
                  >Eixample</option
                >
                <option
                  value="Gràcia"
                  selected={repartidor?.zona_preferida === "Gràcia"}
                  >Gràcia</option
                >
                <option
                  value="Sant Martí"
                  selected={repartidor?.zona_preferida === "Sant Martí"}
                  >Sant Martí</option
                >
                <option
                  value="Sants-Montjuïc"
                  selected={repartidor?.zona_preferida === "Sants-Montjuïc"}
                  >Sants-Montjuïc</option
                >
                <option
                  value="Sarrià-Sant Gervasi"
                  selected={repartidor?.zona_preferida ===
                    "Sarrià-Sant Gervasi"}>Sarrià-Sant Gervasi</option
                >
                <option
                  value="Les Corts"
                  selected={repartidor?.zona_preferida === "Les Corts"}
                  >Les Corts</option
                >
                <option
                  value="Horta-Guinardó"
                  selected={repartidor?.zona_preferida === "Horta-Guinardó"}
                  >Horta-Guinardó</option
                >
                <option
                  value="Nou Barris"
                  selected={repartidor?.zona_preferida === "Nou Barris"}
                  >Nou Barris</option
                >
                <option
                  value="Sant Andreu"
                  selected={repartidor?.zona_preferida === "Sant Andreu"}
                  >Sant Andreu</option
                >
              </select>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Radi màxim (km)</label
              >
              <div class="flex items-center gap-4">
                <input
                  type="range"
                  name="radio_km"
                  min="1"
                  max="15"
                  step="0.5"
                  value={repartidor?.radio_km || 5}
                  class="flex-1"
                  id="radio-slider"
                />
                <span
                  id="radio-value"
                  class="text-sm font-medium text-gray-900 w-12 text-right"
                  >{repartidor?.radio_km || 5} km</span
                >
              </div>
            </div>
          </div>
        </div>

        <!-- Missatges -->
        <div
          id="error-message"
          class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm"
        >
        </div>
        <div
          id="success-message"
          class="hidden bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg text-sm"
        >
        </div>

        <button
          type="submit"
          class="w-full py-3 bg-[#3BB143] text-white font-semibold rounded-lg hover:bg-[#32a039] transition-colors"
        >
          Desar canvis
        </button>
      </form>
    </div>
  </div>
</Layout>

<script>
  // Formulari d'informació personal
  const profileForm = document.getElementById(
    "profile-form"
  ) as HTMLFormElement;

  profileForm?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const formData = new FormData(profileForm);
    const data = {
      nombre: formData.get("nombre"),
      telefono: formData.get("telefono"),
      direccion: formData.get("direccion"),
      ciudad: formData.get("ciudad"),
      codigo_postal: formData.get("codigo_postal"),
    };

    try {
      const res = await fetch("/api/user/profile", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });

      const result = await res.json();

      if (result.success) {
        alert("Perfil actualitzat correctament!");
        location.reload();
      } else {
        alert(result.error || "Error actualitzant el perfil");
      }
    } catch (e) {
      alert("Error de connexió");
    }
  });

  // Formulari de contrasenya
  const passwordForm = document.getElementById(
    "password-form"
  ) as HTMLFormElement;

  passwordForm?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const formData = new FormData(passwordForm);
    const currentPassword = formData.get("current_password") as string;
    const newPassword = formData.get("new_password") as string;
    const confirmPassword = formData.get("confirm_password") as string;

    if (!currentPassword || !newPassword || !confirmPassword) {
      alert("Si us plau, omple tots els camps");
      return;
    }

    if (newPassword !== confirmPassword) {
      alert("Les contrasenyes noves no coincideixen");
      return;
    }

    if (newPassword.length < 8) {
      alert("La contrasenya ha de tenir almenys 8 caràcters");
      return;
    }

    try {
      const res = await fetch("/api/user/password", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          currentPassword: currentPassword,
          newPassword: newPassword,
        }),
      });

      const result = await res.json();

      if (result.success) {
        alert("Contrasenya canviada correctament!");
        passwordForm.reset();
      } else {
        alert(result.error || "Error canviant la contrasenya");
      }
    } catch (e) {
      alert("Error de connexió");
    }
  });

  // Toggle de disponibilitat
  const toggleDisponibilitat = document.getElementById("toggle-disponibilitat");
  const estatText = document.getElementById("estat-text");

  async function canviarDisponibilitat() {
    const isActive = toggleDisponibilitat?.dataset.active === "true";
    const newState = !isActive;

    try {
      const res = await fetch("/api/repartidor/disponibilitat", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ disponible: newState }),
      });

      if (res.ok) {
        // Actualitzar UI local
        toggleDisponibilitat!.dataset.active = newState.toString();
        const span = toggleDisponibilitat?.querySelector("span");

        if (newState) {
          toggleDisponibilitat?.classList.remove("bg-gray-300");
          toggleDisponibilitat?.classList.add("bg-[#3BB143]");
          span?.classList.remove("translate-x-1");
          span?.classList.add("translate-x-7");
          if (estatText) {
            estatText.textContent = "Actiu";
            estatText.nextElementSibling!.textContent =
              "Pots rebre comandes per repartir";
          }
        } else {
          toggleDisponibilitat?.classList.remove("bg-[#3BB143]");
          toggleDisponibilitat?.classList.add("bg-gray-300");
          span?.classList.remove("translate-x-7");
          span?.classList.add("translate-x-1");
          if (estatText) {
            estatText.textContent = "Inactiu";
            estatText.nextElementSibling!.textContent =
              "No rebràs comandes fins que activis aquest estat";
          }
        }

        // Actualitzar també el toggle del header
        const headerToggle = parent.document.getElementById("toggle-status");
        if (headerToggle) {
          headerToggle.dataset.active = newState.toString();
          const headerSpan = headerToggle.querySelector("span");
          if (newState) {
            headerToggle.classList.remove("bg-gray-300");
            headerToggle.classList.add("bg-[#3BB143]");
            headerSpan?.classList.remove("translate-x-1");
            headerSpan?.classList.add("translate-x-6");
          } else {
            headerToggle.classList.remove("bg-[#3BB143]");
            headerToggle.classList.add("bg-gray-300");
            headerSpan?.classList.remove("translate-x-6");
            headerSpan?.classList.add("translate-x-1");
          }
        }
      }
    } catch (e) {
      console.error("Error canviant disponibilitat:", e);
    }
  }

  toggleDisponibilitat?.addEventListener("click", canviarDisponibilitat);

  // Gestió de matrícula segons tipus de vehicle
  const vehicleLabels = document.querySelectorAll(
    'label:has(input[name="vehiculo_tipo"])'
  );
  const matriculaContainer = document.getElementById("matricula-container");
  const matriculaInput = document.getElementById(
    "matricula-input"
  ) as HTMLInputElement;
  const matriculaRequired = document.getElementById("matricula-required");

  function actualitzarMatricula() {
    const selectedVehicle = document.querySelector(
      'input[name="vehiculo_tipo"]:checked'
    ) as HTMLInputElement;

    if (selectedVehicle) {
      const vehicleType = selectedVehicle.value;
      const requiresMatricula = ["moto", "coche", "furgoneta"].includes(
        vehicleType
      );

      if (requiresMatricula) {
        matriculaContainer!.style.display = "block";
        matriculaRequired!.style.display = "inline";
        matriculaInput!.required = true;
      } else {
        matriculaContainer!.style.display = "none";
        matriculaRequired!.style.display = "none";
        matriculaInput!.required = false;
        matriculaInput!.value = "";
      }
    }
  }

  // Seleccionar vehicle i actualitzar matrícula
  vehicleLabels.forEach((label) => {
    label.addEventListener("click", () => {
      vehicleLabels.forEach((l) => {
        l.classList.remove("border-[#3BB143]", "bg-green-50");
        l.classList.add("border-gray-200");
      });
      label.classList.remove("border-gray-200");
      label.classList.add("border-[#3BB143]", "bg-green-50");

      // Actualitzar matrícula
      setTimeout(actualitzarMatricula, 50);
    });
  });

  // Actualitzar matrícula al carregar
  actualitzarMatricula();

  // Deixar de ser repartidor
  const deixarBtn = document.getElementById("deixar-repartidor-btn");
  const deixarError = document.getElementById("deixar-error");

  deixarBtn?.addEventListener("click", async () => {
    const confirmat = confirm(
      "Estàs segur que vols deixar de ser repartidor?\n\nAquesta acció convertirà el teu compte en compte de client i no podràs acceptar més comandes.\n\nAssegura't de finalitzar totes les comandes pendents abans de continuar."
    );

    if (!confirmat) return;

    const dobleConfirmacio = confirm(
      "Última confirmació: Aquesta acció és irreversible.\n\nVols continuar?"
    );

    if (!dobleConfirmacio) return;

    try {
      deixarBtn.disabled = true;
      deixarBtn.textContent = "Processant...";

      const res = await fetch("/api/repartidor/deixar-rol", {
        method: "POST",
      });

      const result = await res.json();

      if (result.success) {
        alert(
          "Has deixat de ser repartidor correctament. Seràs redirigit al dashboard de client."
        );
        window.location.href = "/dashboard";
      } else {
        deixarError!.textContent =
          result.error || "Error processant la sol·licitud";
        deixarError!.classList.remove("hidden");
        deixarBtn.disabled = false;
        deixarBtn.textContent = "Deixar de ser repartidor";
      }
    } catch (e) {
      deixarError!.textContent = "Error de connexió";
      deixarError!.classList.remove("hidden");
      deixarBtn.disabled = false;
      deixarBtn.textContent = "Deixar de ser repartidor";
    }
  });

  // Actualitzar valor del slider
  const radioSlider = document.getElementById(
    "radio-slider"
  ) as HTMLInputElement;
  const radioValue = document.getElementById("radio-value");

  radioSlider?.addEventListener("input", () => {
    if (radioValue) {
      radioValue.textContent = `${radioSlider.value} km`;
    }
  });

  // Enviar formulari
  const form = document.getElementById("config-form") as HTMLFormElement;
  const errorMsg = document.getElementById("error-message");
  const successMsg = document.getElementById("success-message");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const vehicleType = formData.get("vehiculo_tipo") as string;
    const matricula = formData.get("matricula") as string;

    // Validar matrícula per vehicles que la requereixen
    if (
      ["moto", "coche", "furgoneta"].includes(vehicleType) &&
      !matricula?.trim()
    ) {
      errorMsg!.textContent =
        "La matrícula és obligatòria per aquest tipus de vehicle";
      errorMsg!.classList.remove("hidden");
      successMsg!.classList.add("hidden");
      return;
    }

    const data = {
      vehiculo_tipo: vehicleType,
      matricula: matricula || null,
      zona_preferida: formData.get("zona_preferida"),
      radio_km: parseFloat(formData.get("radio_km") as string),
    };

    try {
      const res = await fetch("/api/repartidor/configuracio", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });

      const result = await res.json();

      if (result.success) {
        successMsg!.textContent = "Configuració desada correctament!";
        successMsg!.classList.remove("hidden");
        errorMsg!.classList.add("hidden");
        setTimeout(() => successMsg!.classList.add("hidden"), 3000);
      } else {
        errorMsg!.textContent = result.error || "Error desant la configuració";
        errorMsg!.classList.remove("hidden");
        successMsg!.classList.add("hidden");
      }
    } catch (e) {
      errorMsg!.textContent = "Error de connexió";
      errorMsg!.classList.remove("hidden");
    }
  });
</script>
