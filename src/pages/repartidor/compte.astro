---
import Layout from "../../layouts/Layout.astro";
import { verifyToken, getUserById } from "../../lib/auth";
import { queryOperacional } from "../../lib/db";

// Verificar autenticació i rol
const token = Astro.cookies.get("auth_token")?.value;
let user = null;
let repartidor = null;

if (token) {
  const payload = verifyToken(token);
  if (payload) {
    user = await getUserById(payload.userId);
  }
}

if (!user || user.rol !== "repartidor") {
  return Astro.redirect("/dashboard");
}

// Obtenir dades del repartidor
try {
  const repartidorData = await queryOperacional<any[]>(
    "SELECT * FROM repartidores WHERE usuario_id = ? AND (activo IS NULL OR activo = 1)",
    [user.id]
  );
  repartidor = repartidorData[0] || null;

  // Si no existeix el registre, hi ha un problema (hauria d'existir per aprovació admin)
  if (!repartidor) {
    console.error("Registre de repartidor no trobat per a l'usuari", user.id);
    return Astro.redirect("/dashboard");
  }
} catch (error) {
  console.error("Error obtenint dades repartidor:", error);
  return Astro.redirect("/dashboard");
}

// Estadístiques
let stats = {
  entreguesAvui: 0,
  entreguesSetmana: 0,
  entreguesMes: 0,
  totalEntregues: repartidor?.entregas_completadas || 0,
  valoracio: repartidor?.valoracion_media || 5.0,
  guanysAvui: 0,
  guanysSetmana: 0,
  guanysMes: 0,
};

// Últimes entregues
let ultimesEntregues: any[] = [];

try {
  // Entregues d'avui
  const avui = await queryOperacional<any[]>(
    `
    SELECT COUNT(*) as total, COALESCE(SUM(propina), 0) as propines
    FROM pedidos 
    WHERE repartidor_id = ? AND DATE(fecha_entrega) = CURDATE() AND estado = 'entregado'
  `,
    [repartidor?.id || 0]
  );
  stats.entreguesAvui = Number(avui[0]?.total) || 0;
  stats.guanysAvui = stats.entreguesAvui * 2.5 + Number(avui[0]?.propines || 0); // 2.5€ per entrega + propines

  // Entregues setmana
  const setmana = await queryOperacional<any[]>(
    `
    SELECT COUNT(*) as total, COALESCE(SUM(propina), 0) as propines
    FROM pedidos 
    WHERE repartidor_id = ? AND YEARWEEK(fecha_entrega) = YEARWEEK(CURDATE()) AND estado = 'entregado'
  `,
    [repartidor?.id || 0]
  );
  stats.entreguesSetmana = Number(setmana[0]?.total) || 0;
  stats.guanysSetmana =
    stats.entreguesSetmana * 2.5 + Number(setmana[0]?.propines || 0);

  // Entregues mes
  const mes = await queryOperacional<any[]>(
    `
    SELECT COUNT(*) as total, COALESCE(SUM(propina), 0) as propines
    FROM pedidos 
    WHERE repartidor_id = ? AND MONTH(fecha_entrega) = MONTH(CURDATE()) AND YEAR(fecha_entrega) = YEAR(CURDATE()) AND estado = 'entregado'
  `,
    [repartidor?.id || 0]
  );
  stats.entreguesMes = Number(mes[0]?.total) || 0;
  stats.guanysMes = stats.entreguesMes * 2.5 + Number(mes[0]?.propines || 0);

  // Últimes 5 entregues
  ultimesEntregues = await queryOperacional<any[]>(
    `
    SELECT p.*, u.nombre as cliente_nombre
    FROM pedidos p
    JOIN usuarios u ON p.cliente_id = u.id
    WHERE p.repartidor_id = ? AND p.estado = 'entregado'
    ORDER BY p.fecha_entrega DESC
    LIMIT 5
  `,
    [repartidor?.id || 0]
  );
} catch (error) {
  console.error("Error obtenint estadístiques:", error);
}
---

<Layout title="El meu compte - Repartidor - FreshExpress">
  <div class="min-h-screen bg-gray-100 py-6">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Capçalera -->
      <div
        class="bg-gradient-to-r from-orange-500 to-orange-600 rounded-2xl shadow-lg p-6 mb-6 text-white"
      >
        <div
          class="flex flex-col md:flex-row md:items-center md:justify-between"
        >
          <div class="flex items-center mb-4 md:mb-0">
            <div
              class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center text-2xl font-bold"
            >
              {user.nombre.charAt(0).toUpperCase()}
            </div>
            <div class="ml-4">
              <h1 class="text-2xl font-bold">Hola, {user.nombre}!</h1>
              <p class="text-white/80">Repartidor FreshExpress</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="text-right mr-4">
              <p class="text-white/80 text-sm">Valoració</p>
              <div class="flex items-center">
                <svg
                  class="w-5 h-5 text-yellow-300 mr-1"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                  ></path>
                </svg>
                <span class="text-xl font-bold"
                  >{Number(stats.valoracio).toFixed(1)}</span
                >
              </div>
            </div>
            <a
              href="/repartidor/configuracio"
              class="px-4 py-2 bg-white/20 hover:bg-white/30 rounded-lg font-medium transition-colors"
            >
              Editar perfil
            </a>
            <button
              id="logout-btn-header"
              class="px-4 py-2 bg-white text-orange-600 hover:bg-orange-50 rounded-lg font-medium transition-colors"
            >
              Tancar sessió
            </button>
          </div>
        </div>
      </div>

      <!-- Estadístiques ràpides -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-xl shadow p-5">
          <p class="text-gray-500 text-sm mb-1">Avui</p>
          <p class="text-3xl font-bold text-orange-500">
            {stats.entreguesAvui}
          </p>
          <p class="text-sm text-gray-400">entregues</p>
        </div>
        <div class="bg-white rounded-xl shadow p-5">
          <p class="text-gray-500 text-sm mb-1">Aquesta setmana</p>
          <p class="text-3xl font-bold text-[#3BB143]">
            {stats.entreguesSetmana}
          </p>
          <p class="text-sm text-gray-400">entregues</p>
        </div>
        <div class="bg-white rounded-xl shadow p-5">
          <p class="text-gray-500 text-sm mb-1">Aquest mes</p>
          <p class="text-3xl font-bold text-[#0047AB]">{stats.entreguesMes}</p>
          <p class="text-sm text-gray-400">entregues</p>
        </div>
        <div class="bg-white rounded-xl shadow p-5">
          <p class="text-gray-500 text-sm mb-1">Total</p>
          <p class="text-3xl font-bold text-gray-900">{stats.totalEntregues}</p>
          <p class="text-sm text-gray-400">entregues</p>
        </div>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <!-- Guanys -->
        <div class="bg-white rounded-xl shadow p-6">
          <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center">
            <svg
              class="w-5 h-5 mr-2 text-yellow-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
            Guanys estimats
          </h2>
          <div class="space-y-4">
            <div
              class="flex justify-between items-center p-3 bg-orange-50 rounded-lg"
            >
              <span class="text-gray-600">Avui</span>
              <span class="font-bold text-orange-600"
                >{stats.guanysAvui.toFixed(2)} €</span
              >
            </div>
            <div
              class="flex justify-between items-center p-3 bg-green-50 rounded-lg"
            >
              <span class="text-gray-600">Setmana</span>
              <span class="font-bold text-[#3BB143]"
                >{stats.guanysSetmana.toFixed(2)} €</span
              >
            </div>
            <div
              class="flex justify-between items-center p-3 bg-blue-50 rounded-lg"
            >
              <span class="text-gray-600">Mes</span>
              <span class="font-bold text-[#0047AB]"
                >{stats.guanysMes.toFixed(2)} €</span
              >
            </div>
          </div>
          <a
            href="/repartidor/guanys"
            class="block text-center text-sm text-orange-500 hover:underline mt-4"
          >
            Veure detalls →
          </a>
        </div>

        <!-- Accions ràpides -->
        <div class="bg-white rounded-xl shadow p-6">
          <h2 class="text-lg font-bold text-gray-900 mb-4">Accions ràpides</h2>
          <div class="space-y-3">
            <a
              href="/repartidor"
              class="flex items-center p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors"
            >
              <div
                class="w-10 h-10 bg-orange-100 rounded-lg flex items-center justify-center mr-3"
              >
                <svg
                  class="w-5 h-5 text-orange-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                  ></path>
                </svg>
              </div>
              <div>
                <p class="font-medium text-gray-900">Entregues pendents</p>
                <p class="text-sm text-gray-500">Veure comandes assignades</p>
              </div>
            </a>
            <a
              href="/repartidor/ruta"
              class="flex items-center p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors"
            >
              <div
                class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center mr-3"
              >
                <svg
                  class="w-5 h-5 text-green-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
                  ></path>
                </svg>
              </div>
              <div>
                <p class="font-medium text-gray-900">Ruta actual</p>
                <p class="text-sm text-gray-500">Gestionar entregues actives</p>
              </div>
            </a>
            <a
              href="/repartidor/historial"
              class="flex items-center p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors"
            >
              <div
                class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center mr-3"
              >
                <svg
                  class="w-5 h-5 text-blue-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <p class="font-medium text-gray-900">Historial</p>
                <p class="text-sm text-gray-500">Entregues completades</p>
              </div>
            </a>
          </div>
        </div>

        <!-- Últimes entregues -->
        <div class="bg-white rounded-xl shadow p-6">
          <h2 class="text-lg font-bold text-gray-900 mb-4">
            Últimes entregues
          </h2>
          {
            ultimesEntregues.length === 0 ? (
              <div class="text-center py-8 text-gray-500">
                <svg
                  class="w-12 h-12 mx-auto text-gray-300 mb-3"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"
                  />
                </svg>
                <p class="text-sm">Cap entrega encara</p>
              </div>
            ) : (
              <div class="space-y-3">
                {ultimesEntregues.map((entrega) => (
                  <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                    <div>
                      <p class="font-medium text-gray-900 text-sm">
                        {entrega.cliente_nombre}
                      </p>
                      <p class="text-xs text-gray-500">
                        {new Date(entrega.fecha_entrega).toLocaleDateString(
                          "ca-ES"
                        )}
                      </p>
                    </div>
                    <div class="text-right">
                      <p class="font-bold text-gray-900">
                        {Number(entrega.total || 0).toFixed(2)} €
                      </p>
                      {entrega.propina > 0 && (
                        <p class="text-xs text-green-600">
                          +{Number(entrega.propina).toFixed(2)} € propina
                        </p>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            )
          }
          <a
            href="/repartidor/historial"
            class="block text-center text-sm text-orange-500 hover:underline mt-4"
          >
            Veure tot l'historial →
          </a>
        </div>
      </div>

      <!-- Informació del compte -->
      <div class="mt-6 bg-white rounded-xl shadow p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4">
          Informació del compte
        </h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="space-y-4">
            <div>
              <p class="text-sm text-gray-500">Nom complet</p>
              <p class="font-medium text-gray-900">{user.nombre}</p>
            </div>
            <div>
              <p class="text-sm text-gray-500">Correu electrònic</p>
              <p class="font-medium text-gray-900">{user.email}</p>
            </div>
            <div>
              <p class="text-sm text-gray-500">Telèfon</p>
              <p class="font-medium text-gray-900">
                {user.telefono || "No especificat"}
              </p>
            </div>
          </div>
          <div class="space-y-4">
            <div>
              <p class="text-sm text-gray-500">Tipus de vehicle</p>
              <p class="font-medium text-gray-900 capitalize">
                {repartidor?.vehiculo_tipo || "bicicleta"}
              </p>
            </div>
            <div>
              <p class="text-sm text-gray-500">Zona preferida</p>
              <p class="font-medium text-gray-900">
                {repartidor?.zona_preferida || "No especificada"}
              </p>
            </div>
            <div>
              <p class="text-sm text-gray-500">Estat</p>
              <span
                class={`inline-block px-2 py-1 rounded-full text-xs font-medium ${repartidor?.disponible ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-700"}`}
              >
                {repartidor?.disponible ? "🟢 Disponible" : "⚪ No disponible"}
              </span>
            </div>
          </div>
        </div>
        <div class="mt-6 pt-4 border-t flex flex-wrap gap-3">
          <a
            href="/repartidor/configuracio"
            class="px-4 py-2 bg-orange-500 text-white rounded-lg hover:bg-orange-600 transition-colors"
          >
            Editar perfil
          </a>
          <a
            href="/configuracio"
            class="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors"
          >
            Canviar contrasenya
          </a>
          <button
            id="logout-btn"
            class="px-4 py-2 bg-red-50 text-red-600 rounded-lg hover:bg-red-100 transition-colors"
          >
            Tancar sessió
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Funció de logout compartida
  async function handleLogout() {
    try {
      await fetch("/api/auth/logout", { method: "POST" });
      window.location.href = "/";
    } catch (e) {
      console.error("Error tancant sessió:", e);
    }
  }

  // Botó header
  document
    .getElementById("logout-btn-header")
    ?.addEventListener("click", handleLogout);

  // Botó secció informació
  document
    .getElementById("logout-btn")
    ?.addEventListener("click", handleLogout);
</script>
