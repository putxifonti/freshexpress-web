---
import Layout from "../../layouts/Layout.astro";
import { verifyToken, getUserById } from "../../lib/auth";
import { queryOperacional } from "../../lib/db";

// Verificar autenticació i rol
const token = Astro.cookies.get("auth_token")?.value;
let user = null;
let repartidor = null;

if (token) {
  const payload = verifyToken(token);
  if (payload) {
    user = await getUserById(payload.userId);
  }
}

if (!user || user.rol !== "repartidor") {
  return Astro.redirect("/dashboard");
}

// Obtenir dades del repartidor
try {
  const repartidorData = await queryOperacional<any[]>(
    "SELECT * FROM repartidores WHERE usuario_id = ? AND (activo IS NULL OR activo = 1)",
    [user.id]
  );
  repartidor = repartidorData[0] || null;

  // Si no existeix el registre, hi ha un problema (hauria d'existir per aprovació admin)
  if (!repartidor) {
    console.error("Registre de repartidor no trobat per a l'usuari", user.id);
    return Astro.redirect("/dashboard");
  }
} catch (error) {
  console.error("Error obtenint dades repartidor:", error);
  return Astro.redirect("/dashboard");
}

// Comprovar si el repartidor està actiu
const repartidorActiu = repartidor?.disponible === 1;

// Obtenir estadístiques
let stats = {
  entreguesAvui: 0,
  entreguesPendents: 0,
  valoracio: repartidor?.valoracion_media || 5.0,
  totalEntregues: repartidor?.entregas_completadas || 0,
};

let pedidosPendents: any[] = [];
let pedidoActual: any = null;

try {
  // Només mostrar comandes si el repartidor està actiu
  if (repartidorActiu) {
    // Comandes pendents d'assignar o assignades a mi
    pedidosPendents = await queryOperacional<any[]>(
      `
      SELECT p.*, u.nombre as cliente_nombre, u.telefono as cliente_telefono
      FROM pedidos p
      JOIN usuarios u ON p.cliente_id = u.id
      WHERE (p.repartidor_id = ? OR (p.repartidor_id IS NULL AND p.estado IN ('pendiente', 'listo', 'confirmado')))
      AND p.estado NOT IN ('entregado', 'cancelado')
      ORDER BY p.fecha_pedido ASC
      LIMIT 10
    `,
      [repartidor?.id || 0]
    );

    pedidoActual = pedidosPendents.find(
      (p: any) => p.repartidor_id === repartidor?.id && p.estado === "en_camino"
    );
  }

  // Estadístiques d'avui
  const avui = await queryOperacional<any[]>(
    `
    SELECT COUNT(*) as total FROM pedidos 
    WHERE repartidor_id = ? AND DATE(fecha_entrega) = CURDATE() AND estado = 'entregado'
  `,
    [repartidor?.id || 0]
  );
  stats.entreguesAvui = avui[0]?.total || 0;
  stats.entreguesPendents = pedidosPendents.filter(
    (p: any) => p.repartidor_id === repartidor?.id
  ).length;
} catch (error) {
  console.error("Error obtenint pedidos:", error);
}
---

<Layout title="Panell Repartidor - FreshExpress">
  <div class="min-h-screen bg-gray-100 py-6">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Capçalera -->
      <div class="bg-white rounded-xl shadow-md p-6 mb-6">
        <div class="flex items-center justify-between">
          <div class="flex items-center">
            <div
              class="w-14 h-14 bg-gradient-to-br from-orange-400 to-orange-600 rounded-full flex items-center justify-center text-white text-xl font-bold"
            >
              {user.nombre.charAt(0).toUpperCase()}
            </div>
            <div class="ml-4">
              <h1 class="text-xl font-bold text-gray-900">
                Hola, {user.nombre}!
              </h1>
              <p class="text-gray-500 text-sm">Repartidor</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Estadístiques -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-xl shadow p-4 text-center">
          <p class="text-2xl font-bold text-[#3BB143]">{stats.entreguesAvui}</p>
          <p class="text-xs text-gray-500">Avui</p>
        </div>
        <div class="bg-white rounded-xl shadow p-4 text-center">
          <p class="text-2xl font-bold text-orange-500">
            {stats.entreguesPendents}
          </p>
          <p class="text-xs text-gray-500">Pendents</p>
        </div>
        <div class="bg-white rounded-xl shadow p-4 text-center">
          <p class="text-2xl font-bold text-[#0047AB]">
            {stats.totalEntregues}
          </p>
          <p class="text-xs text-gray-500">Total</p>
        </div>
        <div class="bg-white rounded-xl shadow p-4 text-center">
          <div class="flex items-center justify-center">
            <svg
              class="w-5 h-5 text-yellow-400 mr-1"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
            <span class="text-2xl font-bold text-gray-900"
              >{Number(stats.valoracio || 5).toFixed(1)}</span
            >
          </div>
          <p class="text-xs text-gray-500">Valoració</p>
        </div>
      </div>

      {/* Entrega actual */}
      {
        pedidoActual && (
          <div class="bg-gradient-to-r from-orange-500 to-orange-600 rounded-xl shadow-lg p-6 mb-6 text-white">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-lg font-bold">Entrega en curs</h2>
              <span class="px-3 py-1 bg-white/20 rounded-full text-sm">
                #{pedidoActual.numero_pedido}
              </span>
            </div>
            <div class="space-y-3">
              <div class="flex items-start">
                <svg
                  class="w-5 h-5 mr-2 mt-0.5 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                </svg>
                <span class="text-sm">{pedidoActual.direccion_entrega}</span>
              </div>
              <div class="flex items-center">
                <svg
                  class="w-5 h-5 mr-2"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                  />
                </svg>
                <span class="text-sm">{pedidoActual.cliente_nombre}</span>
                {pedidoActual.cliente_telefono && (
                  <a
                    href={`tel:${pedidoActual.cliente_telefono}`}
                    class="ml-3 underline text-sm"
                  >
                    {pedidoActual.cliente_telefono}
                  </a>
                )}
              </div>
            </div>
            <div class="flex gap-3 mt-5">
              <button
                class="flex-1 py-2.5 bg-white text-orange-600 font-medium rounded-lg hover:bg-orange-50 transition-colors btn-entregar"
                data-pedido-id={pedidoActual.id}
              >
                Marcar com entregat
              </button>
              <button
                class="py-2.5 px-4 bg-white/20 text-white font-medium rounded-lg hover:bg-white/30 transition-colors btn-incidencia"
                data-pedido-id={pedidoActual.id}
              >
                Incidència
              </button>
            </div>
          </div>
        )
      }

      <!-- Comandes disponibles -->
      <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="font-semibold text-gray-900">Comandes disponibles</h2>
        </div>

        {
          !repartidorActiu ? (
            <div class="p-8 text-center">
              <div class="w-16 h-16 mx-auto bg-yellow-100 rounded-full flex items-center justify-center mb-4">
                <svg
                  class="w-8 h-8 text-yellow-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                  />
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-gray-900 mb-2">
                No estàs treballant
              </h3>
              <p class="text-gray-600 mb-4">
                Activa el teu estat per començar a rebre comandes
              </p>
              <a
                href="/repartidor/configuracio"
                class="inline-flex items-center px-6 py-3 bg-[#3BB143] text-white font-medium rounded-lg hover:bg-[#32a039] transition-colors"
              >
                <svg
                  class="w-5 h-5 mr-2"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                </svg>
                Anar a Configuració
              </a>
            </div>
          ) : pedidosPendents.length === 0 ? (
            <div class="p-8 text-center">
              <svg
                class="w-16 h-16 mx-auto text-gray-300 mb-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"
                />
              </svg>
              <p class="text-gray-500">
                No hi ha comandes disponibles ara mateix
              </p>
              <p class="text-sm text-gray-400 mt-1">
                Activa la teva disponibilitat per rebre notificacions
              </p>
            </div>
          ) : (
            <div class="divide-y divide-gray-100 pedidos-container">
              {pedidosPendents
                .filter((p: any) => p.id !== pedidoActual?.id)
                .map((pedido: any) => (
                  <div
                    class="p-4 hover:bg-gray-50 transition-colors pedido-item"
                    data-pedido-id={pedido.id}
                  >
                    <div class="flex items-center justify-between mb-2">
                      <span class="text-sm font-medium text-gray-900">
                        #{pedido.numero_pedido}
                      </span>
                      <span
                        class={`px-2 py-0.5 text-xs rounded-full ${
                          pedido.estado === "listo"
                            ? "bg-green-100 text-green-700"
                            : pedido.estado === "confirmado"
                              ? "bg-blue-100 text-blue-700"
                              : pedido.estado === "pendiente"
                                ? "bg-yellow-100 text-yellow-700"
                                : "bg-gray-100 text-gray-600"
                        }`}
                      >
                        {pedido.estado === "listo"
                          ? "Llest per recollir"
                          : pedido.estado === "confirmado"
                            ? "Confirmat"
                            : pedido.estado === "pendiente"
                              ? "Pendent"
                              : pedido.estado}
                      </span>
                    </div>
                    <p class="text-sm text-gray-600 mb-2 line-clamp-1">
                      {pedido.direccion_entrega}
                    </p>
                    <div class="flex items-center justify-between">
                      <span class="text-xs text-gray-400">
                        {new Date(pedido.fecha_pedido).toLocaleTimeString(
                          "ca-ES",
                          { hour: "2-digit", minute: "2-digit" }
                        )}
                      </span>
                      <div class="flex items-center gap-2">
                        <span class="text-sm font-medium text-gray-900">
                          {Number(pedido.total || 0).toFixed(2)} €
                        </span>
                        {!pedido.repartidor_id && (
                          <button
                            class="px-3 py-1 bg-[#3BB143] text-white text-sm font-medium rounded hover:bg-[#32a039] transition-colors btn-acceptar"
                            data-pedido-id={pedido.id}
                          >
                            Acceptar
                          </button>
                        )}
                        {pedido.repartidor_id === repartidor?.id &&
                          pedido.estado !== "en_camino" && (
                            <button
                              class="px-3 py-1 bg-orange-500 text-white text-sm font-medium rounded hover:bg-orange-600 transition-colors btn-iniciar"
                              data-pedido-id={pedido.id}
                            >
                              Iniciar entrega
                            </button>
                          )}
                      </div>
                    </div>
                  </div>
                ))}
            </div>
          )
        }
      </div>

      <!-- Navegació ràpida -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
        <a
          href="/repartidor/ruta"
          class="bg-white rounded-xl shadow p-4 flex items-center hover:shadow-lg transition-shadow"
        >
          <div
            class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center mr-3"
          >
            <svg
              class="w-5 h-5 text-green-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
              ></path>
            </svg>
          </div>
          <span class="font-medium text-gray-900">Ruta</span>
        </a>
        <a
          href="/repartidor/guanys"
          class="bg-white rounded-xl shadow p-4 flex items-center hover:shadow-lg transition-shadow"
        >
          <div
            class="w-10 h-10 bg-yellow-100 rounded-lg flex items-center justify-center mr-3"
          >
            <svg
              class="w-5 h-5 text-yellow-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
          </div>
          <span class="font-medium text-gray-900">Guanys</span>
        </a>
        <a
          href="/repartidor/historial"
          class="bg-white rounded-xl shadow p-4 flex items-center hover:shadow-lg transition-shadow"
        >
          <div
            class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center mr-3"
          >
            <svg
              class="w-5 h-5 text-blue-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
              ></path>
            </svg>
          </div>
          <span class="font-medium text-gray-900">Historial</span>
        </a>
        <a
          href="/repartidor/configuracio"
          class="bg-white rounded-xl shadow p-4 flex items-center hover:shadow-lg transition-shadow"
        >
          <div
            class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center mr-3"
          >
            <svg
              class="w-5 h-5 text-gray-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <span class="font-medium text-gray-900">Configuració</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Modal Incidència -->
  <div
    id="modal-incidencia"
    class="fixed inset-0 bg-black/50 items-center justify-center z-50"
    style="display: none;"
  >
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full mx-4 p-6">
      <h3 class="text-lg font-bold text-gray-900 mb-4">Reportar incidència</h3>
      <input type="hidden" id="incidencia-pedido-id" />

      <div class="space-y-3 mb-4">
        <label
          class="flex items-center gap-3 p-3 border rounded-lg cursor-pointer hover:bg-gray-50"
        >
          <input
            type="radio"
            name="motiu-incidencia"
            value="no_contesta"
            class="text-[#3BB143]"
          />
          <span class="text-sm">El client no contesta</span>
        </label>
        <label
          class="flex items-center gap-3 p-3 border rounded-lg cursor-pointer hover:bg-gray-50"
        >
          <input
            type="radio"
            name="motiu-incidencia"
            value="direccio_incorrecta"
            class="text-[#3BB143]"
          />
          <span class="text-sm">Direcció incorrecta</span>
        </label>
        <label
          class="flex items-center gap-3 p-3 border rounded-lg cursor-pointer hover:bg-gray-50"
        >
          <input
            type="radio"
            name="motiu-incidencia"
            value="client_absent"
            class="text-[#3BB143]"
          />
          <span class="text-sm">Client absent</span>
        </label>
        <label
          class="flex items-center gap-3 p-3 border rounded-lg cursor-pointer hover:bg-gray-50"
        >
          <input
            type="radio"
            name="motiu-incidencia"
            value="producte_danyat"
            class="text-[#3BB143]"
          />
          <span class="text-sm">Producte danyat</span>
        </label>
        <label
          class="flex items-center gap-3 p-3 border rounded-lg cursor-pointer hover:bg-gray-50"
        >
          <input
            type="radio"
            name="motiu-incidencia"
            value="altre"
            class="text-[#3BB143]"
          />
          <span class="text-sm">Altre motiu</span>
        </label>
      </div>

      <textarea
        id="incidencia-notes"
        placeholder="Notes addicionals (opcional)"
        class="w-full px-3 py-2 border rounded-lg text-sm resize-none h-20 mb-4"
      ></textarea>

      <div class="flex gap-3">
        <button
          id="btn-cancel-incidencia"
          class="flex-1 py-2 border border-gray-300 rounded-lg font-medium hover:bg-gray-50 transition-colors"
        >
          Cancel·lar
        </button>
        <button
          id="btn-confirm-incidencia"
          class="flex-1 py-2 bg-red-500 text-white rounded-lg font-medium hover:bg-red-600 transition-colors"
        >
          Reportar
        </button>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ repartidorId: repartidor?.id }}>
  // Variables globals per al polling
  let pollingInterval = null;
  let pedidosActuals = new Set();

  // Inicialitzar pedidos actuals
  document.querySelectorAll("[data-pedido-id]").forEach((el) => {
    pedidosActuals.add(el.getAttribute("data-pedido-id"));
  });

  // Funció per actualitzar la llista de comandes
  async function actualitzarComandes() {
    try {
      const res = await fetch("/api/repartidor/pedidos-disponibles");
      if (!res.ok) return;

      const data = await res.json();
      if (!data.success) return;

      const nousPedidos = new Set(data.pedidos.map((p) => String(p.id)));

      // Comprovar si hi ha canvis
      let hiHaCanvis = false;

      // Eliminar pedidos que ja no estan disponibles
      document.querySelectorAll(".pedido-item").forEach((item) => {
        const pedidoId = item.getAttribute("data-pedido-id");
        const pedido = data.pedidos.find((p) => String(p.id) === pedidoId);

        if (!pedido) {
          // El pedido ja no està disponible (acceptat per un altre)
          item.classList.add("opacity-50", "pointer-events-none");
          item.innerHTML = `
            <div class="p-4 text-center text-gray-500">
              <svg class="w-6 h-6 mx-auto mb-2 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <p class="text-sm">Aquesta comanda ja ha estat acceptada</p>
            </div>
          `;
          setTimeout(() => {
            item.remove();
            // Si no queden items, mostrar missatge buit
            const container = document.querySelector(".pedidos-container");
            if (
              container &&
              container.querySelectorAll(".pedido-item").length === 0
            ) {
              container.innerHTML = `
                <div class="p-8 text-center">
                  <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                      d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                  </svg>
                  <p class="text-gray-500">No hi ha comandes disponibles ara mateix</p>
                </div>
              `;
            }
          }, 2000);
          hiHaCanvis = true;
        } else if (
          pedido.repartidor_id &&
          pedido.repartidor_id !== repartidorId
        ) {
          // El pedido ha estat acceptat per un altre repartidor
          item.classList.add("opacity-50", "pointer-events-none");
          const btnAcceptar = item.querySelector(".btn-acceptar");
          if (btnAcceptar) {
            btnAcceptar.remove();
          }
          hiHaCanvis = true;
        }
      });

      // Actualitzar el badge de pendents si cal
      if (hiHaCanvis) {
        const pendentsBadge = document.getElementById("pendents-count");
        if (pendentsBadge) {
          const meusAssignats = data.pedidos.filter(
            (p) => p.repartidor_id === repartidorId
          ).length;
          pendentsBadge.textContent = meusAssignats;
        }
      }

      pedidosActuals = nousPedidos;
    } catch (error) {
      console.error("Error actualitzant comandes:", error);
    }
  }

  // Iniciar polling (cada 3 segons)
  function iniciarPolling() {
    if (pollingInterval) clearInterval(pollingInterval);
    pollingInterval = setInterval(actualitzarComandes, 3000);
  }

  // Aturar polling quan la pestanya no està visible
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) {
      if (pollingInterval) clearInterval(pollingInterval);
    } else {
      iniciarPolling();
      actualitzarComandes(); // Actualitzar immediatament
    }
  });

  // Iniciar polling al carregar
  iniciarPolling();

  // Acceptar comanda
  document.querySelectorAll(".btn-acceptar").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const pedidoId = btn.getAttribute("data-pedido-id");
      const pedidoItem = btn.closest(".pedido-item");

      // Deshabilitar botó immediatament
      btn.disabled = true;
      btn.textContent = "Acceptant...";
      btn.classList.add("opacity-50");

      try {
        const res = await fetch(`/api/repartidor/pedido/${pedidoId}/acceptar`, {
          method: "POST",
        });
        const data = await res.json();
        if (res.ok && data.success) {
          // Mostrar confirmació i recarregar
          if (pedidoItem) {
            pedidoItem.classList.add("bg-green-50", "border-green-200");
            btn.textContent = "✓ Acceptada";
            btn.classList.remove("bg-[#3BB143]");
            btn.classList.add("bg-green-600");
          }
          setTimeout(() => window.location.reload(), 500);
        } else {
          alert(data.error || "Error acceptant la comanda");
          btn.disabled = false;
          btn.textContent = "Acceptar";
          btn.classList.remove("opacity-50");
        }
      } catch (e) {
        console.error("Error:", e);
        alert("Error de connexió");
        btn.disabled = false;
        btn.textContent = "Acceptar";
        btn.classList.remove("opacity-50");
      }
    });
  });

  // Iniciar entrega
  document.querySelectorAll(".btn-iniciar").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const pedidoId = btn.getAttribute("data-pedido-id");
      try {
        const res = await fetch(`/api/repartidor/pedido/${pedidoId}/iniciar`, {
          method: "POST",
        });
        const data = await res.json();
        if (res.ok && data.success) {
          window.location.reload();
        } else {
          alert(data.error || "Error iniciant la entrega");
        }
      } catch (e) {
        console.error("Error:", e);
        alert("Error de connexió");
      }
    });
  });

  // Marcar com entregat
  document.querySelectorAll(".btn-entregar").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const pedidoId = btn.getAttribute("data-pedido-id");
      if (confirm("Confirmes que has entregat la comanda?")) {
        try {
          const res = await fetch(
            `/api/repartidor/pedido/${pedidoId}/entregar`,
            { method: "POST" }
          );
          const data = await res.json();
          if (res.ok && data.success) {
            window.location.reload();
          } else {
            alert(data.error || "Error marcant com entregat");
          }
        } catch (e) {
          console.error("Error:", e);
          alert("Error de connexió");
        }
      }
    });
  });

  // Reportar incidència - Modal
  const modalIncidencia = document.getElementById("modal-incidencia");
  const incidenciaPedidoId = document.getElementById("incidencia-pedido-id");

  document.querySelectorAll(".btn-incidencia").forEach((btn) => {
    btn.addEventListener("click", () => {
      const pedidoId = btn.getAttribute("data-pedido-id");
      if (incidenciaPedidoId) {
        incidenciaPedidoId.value = pedidoId || "";
      }
      if (modalIncidencia) {
        modalIncidencia.style.display = "flex";
      }
    });
  });

  // Tancar modal amb clic fora
  modalIncidencia?.addEventListener("click", (e) => {
    if (e.target === modalIncidencia) {
      modalIncidencia.style.display = "none";
    }
  });

  document
    .getElementById("btn-cancel-incidencia")
    ?.addEventListener("click", () => {
      if (modalIncidencia) {
        modalIncidencia.style.display = "none";
        // Reset form
        document
          .querySelectorAll('input[name="motiu-incidencia"]')
          .forEach((input) => {
            input.checked = false;
          });
        const notesEl = document.getElementById("incidencia-notes");
        if (notesEl) notesEl.value = "";
      }
    });

  document
    .getElementById("btn-confirm-incidencia")
    ?.addEventListener("click", async () => {
      const id = incidenciaPedidoId?.value;
      const motiuInput = document.querySelector(
        'input[name="motiu-incidencia"]:checked'
      );
      const motiu = motiuInput?.value;
      const notesEl = document.getElementById("incidencia-notes");
      const notes = notesEl?.value || "";
      const btnConfirm = document.getElementById("btn-confirm-incidencia");

      if (!motiu) {
        alert("Selecciona un motiu de la incidència");
        return;
      }

      if (!id) {
        alert("Error: No s'ha identificat la comanda");
        return;
      }

      btnConfirm.disabled = true;
      btnConfirm.textContent = "Enviant...";

      try {
        const res = await fetch(`/api/repartidor/pedido/${id}/problema`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ motiu, notes }),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          alert("Incidència reportada correctament");
          window.location.reload();
        } else {
          alert(data.error || "Error reportant la incidència");
          btnConfirm.disabled = false;
          btnConfirm.textContent = "Reportar";
        }
      } catch (e) {
        console.error("Error:", e);
        alert("Error de connexió");
        btnConfirm.disabled = false;
        btnConfirm.textContent = "Reportar";
      }
    });
</script>
