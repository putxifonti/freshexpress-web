---
import LayoutSessio from "../layouts/LayoutSessio.astro";
---

<LayoutSessio title="Recuperar la contrasenya - FreshExpress">
  <main class="min-h-screen flex items-center justify-center bg-gradient-to-br from-[#f0fdf4] to-[#e0f2fe] px-4 py-12">
    <div class="w-full max-w-md rounded-2xl bg-white p-8 shadow-xl text-center">
      <h1 class="text-2xl font-bold text-gray-900">Recuperar la contrasenya</h1>
      <p class="mt-4 text-gray-700">
        La recuperació per correu electrònic encara no està disponible. Si has perdut l'accés al compte, contacta amb l'administrador del projecte.
      </p>
      <a href="/login" class="mt-6 inline-block font-medium text-[#0047AB] hover:underline">
        Tornar a iniciar sessió
      </a>
    </div>
  </main>
</LayoutSessio>
