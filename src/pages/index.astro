---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import Avantatges from "../components/Avantatges.astro";
import ComFunciona from "../components/ComFunciona.astro";
import Contacte from "../components/Contacte.astro";
import Restreo from "../components/Restreo.astro";
import { verifyToken, getUserById } from "../lib/auth";

// Verificar si l'usuari està loguejat i redirigir segons el rol
const token = Astro.cookies.get("auth_token")?.value;
if (token) {
  const payload = verifyToken(token);
  if (payload) {
    const user = await getUserById(payload.userId);
    if (user) {
      // Redirigir segons el rol
      if (user.rol === "repartidor") {
        return Astro.redirect("/repartidor");
      } else if (user.rol === "admin") {
        return Astro.redirect("/admin/dashboard");
      } else if (user.rol === "cliente") {
        return Astro.redirect("/dashboard");
      }
    }
  }
}
---

<Layout
  title="FreshExpress - Entrega Ultra-ràpida en 30 Minuts"
  description="Frescor. Velocitat. Garantit en Menys de 30 Minuts. La xarxa de microcentres més ràpida per a aliments, farmàcia i productes d'alta rotació a Catalunya."
>
  <!-- Hero Section -->
  <HeroSection />

  <!-- Secció d'Avantatges -->
  <Restreo />

  <!-- Secció d'Avantatges -->
  <Avantatges />

  <!-- Secció Com Funciona  -->
  <ComFunciona />

  <!-- Secció Contacte -->
  <Contacte />
</Layout>
