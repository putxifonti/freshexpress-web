---
import Layout from "../layouts/Layout.astro";
import { verifyToken, getUserById } from "../lib/auth";
import { queryOperacional } from "../lib/db";

// Verificar autenticació
const token = Astro.cookies.get("auth_token")?.value;
let user = null;

if (token) {
  const payload = verifyToken(token);
  if (payload) {
    user = await getUserById(payload.userId);
  }
}

// Redirigir si no està autenticat
if (!user) {
  return Astro.redirect("/login");
}

// Comprovar si l'usuari ha seleccionat mode client
const viewMode = Astro.cookies.get("view_mode")?.value;
const isClientMode = viewMode === "cliente";

// Redirigir repartidors al seu dashboard específic (si no estan en mode client)
if (user.rol === "repartidor" && !isClientMode) {
  return Astro.redirect("/repartidor/compte");
}

// Redirigir admins al seu dashboard específic (si no estan en mode client)
if (user.rol === "admin" && !isClientMode) {
  return Astro.redirect("/admin/dashboard");
}

// Obtenir últimes comandes i estadístiques
let ultimesComandes: any[] = [];
let stats = {
  totalComandes: 0,
  puntsAcumulats: 0,
  impacteEco: 0,
};

try {
  // Últimes 5 comandes
  const comandes = await queryOperacional<any[]>(
    `
    SELECT 
      p.id,
      p.numero_pedido,
      p.fecha_pedido,
      p.estado,
      p.total
    FROM pedidos p
    WHERE p.cliente_id = ?
    ORDER BY p.fecha_pedido DESC
    LIMIT 5
  `,
    [user.id]
  );

  ultimesComandes = comandes.map((c: any) => ({
    id: c.numero_pedido || `FE-${c.id}`,
    data: new Date(c.fecha_pedido).toLocaleDateString("ca-ES"),
    estat: c.estado,
    total: Number(c.total) || 0,
  }));

  // Estadístiques
  const totalRes = await queryOperacional<any[]>(
    "SELECT COUNT(*) as total FROM pedidos WHERE cliente_id = ?",
    [user.id]
  );
  stats.totalComandes = Number(totalRes[0]?.total) || 0;

  // Punts (10 punts per cada euro gastat)
  const puntosRes = await queryOperacional<any[]>(
    'SELECT COALESCE(SUM(total), 0) as totalGastat FROM pedidos WHERE cliente_id = ? AND estado = "entregado"',
    [user.id]
  );
  stats.puntsAcumulats = Math.floor(
    Number(puntosRes[0]?.totalGastat || 0) * 10
  );

  // Impacte ECO (0.5kg CO2 estalviat per comanda)
  stats.impacteEco = stats.totalComandes * 0.5;
} catch (error) {
  console.error("Error obtenint dades dashboard:", error);
}

// Funció per traduir estat
function traduirEstat(estat: string): string {
  const traduccions: Record<string, string> = {
    pendiente: "Pendent",
    confirmado: "Confirmat",
    preparando: "Preparant",
    listo: "Llest",
    en_camino: "En camí",
    entregado: "Lliurat",
    cancelado: "Cancel·lat",
  };
  return traduccions[estat] || estat;
}

function getEstatClass(estat: string): string {
  const classes: Record<string, string> = {
    pendiente: "bg-yellow-100 text-yellow-800",
    confirmado: "bg-blue-100 text-blue-800",
    preparando: "bg-purple-100 text-purple-800",
    listo: "bg-indigo-100 text-indigo-800",
    en_camino: "bg-orange-100 text-orange-800",
    entregado: "bg-green-100 text-green-800",
    cancelado: "bg-red-100 text-red-800",
  };
  return classes[estat] || "bg-gray-100 text-gray-800";
}
