---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Sobre Nosaltres - FreshExpress">
  <div class="min-h-screen bg-gray-50">
    <!-- Hero Section -->
    <section
      class="bg-gradient-to-br from-[#0047AB] to-[#003080] text-white py-20"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-4xl md:text-5xl font-bold mb-6">
            Revolucionem el lliurament d'última milla
          </h1>
          <p class="text-xl text-white/80 max-w-3xl mx-auto">
            Som una empresa catalana compromesa amb el medi ambient que ofereix
            lliuraments ecològics amb vehicles elèctrics.
          </p>
        </div>
      </div>
    </section>

    <!-- Missió i Visió -->
    <section class="py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-12">
          <div class="bg-white rounded-2xl shadow-lg p-8">
            <div
              class="w-14 h-14 bg-[#3BB143]/10 rounded-xl flex items-center justify-center mb-6"
            >
              <svg
                class="w-7 h-7 text-[#3BB143]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">
              La nostra missió
            </h2>
            <p class="text-gray-600 leading-relaxed">
              Transformar el sector de la logística urbana oferint un servei de
              lliurament ràpid, fiable i 100% sostenible. Volem demostrar que es
              pot ser eficient sense comprometre el futur del nostre planeta.
            </p>
          </div>
          <div class="bg-white rounded-2xl shadow-lg p-8">
            <div
              class="w-14 h-14 bg-[#0047AB]/10 rounded-xl flex items-center justify-center mb-6"
            >
              <svg
                class="w-7 h-7 text-[#0047AB]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                ></path>
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">
              La nostra visió
            </h2>
            <p class="text-gray-600 leading-relaxed">
              Ser l'empresa de referència en logística sostenible a tot l'Estat
              espanyol, liderant la transició cap a ciutats més netes i un
              comerç més responsable amb el medi ambient.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Els nostres valors -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">
            Els nostres valors
          </h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Aquests principis guien cada decisió que prenem i cada acció que
            fem.
          </p>
        </div>
        <div class="grid md:grid-cols-4 gap-8">
          <div class="text-center">
            <div
              class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <svg
                class="w-8 h-8 text-green-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">
              Sostenibilitat
            </h3>
            <p class="text-gray-600 text-sm">
              El respecte pel medi ambient és la base de tot el que fem.
            </p>
          </div>
          <div class="text-center">
            <div
              class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <svg
                class="w-8 h-8 text-blue-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                ></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Confiança</h3>
            <p class="text-gray-600 text-sm">
              Complim el que prometem, sempre amb transparència.
            </p>
          </div>
          <div class="text-center">
            <div
              class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <svg
                class="w-8 h-8 text-purple-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Innovació</h3>
            <p class="text-gray-600 text-sm">
              Busquem constantment noves maneres de millorar.
            </p>
          </div>
          <div class="text-center">
            <div
              class="w-16 h-16 bg-orange-100 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <svg
                class="w-8 h-8 text-orange-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                ></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Comunitat</h3>
            <p class="text-gray-600 text-sm">
              Creem impacte positiu a les comunitats on operem.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Estadístiques -->
    <section class="py-16 bg-gradient-to-r from-[#3BB143] to-[#2d8a34]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-4 gap-8 text-center text-white">
          <div>
            <p class="text-4xl md:text-5xl font-bold mb-2">50K+</p>
            <p class="text-white/80">Entregues realitzades</p>
          </div>
          <div>
            <p class="text-4xl md:text-5xl font-bold mb-2">15T</p>
            <p class="text-white/80">CO₂ estalviat</p>
          </div>
          <div>
            <p class="text-4xl md:text-5xl font-bold mb-2">100%</p>
            <p class="text-white/80">Flota elèctrica</p>
          </div>
          <div>
            <p class="text-4xl md:text-5xl font-bold mb-2">98%</p>
            <p class="text-white/80">Clients satisfets</p>
          </div>
        </div>
      </div>
    </section>

    <!-- La nostra història -->
    <section class="py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">
            La nostra història
          </h2>
        </div>
        <div class="bg-white rounded-2xl shadow-lg p-8 md:p-12">
          <div class="space-y-8">
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-16 text-right">
                <span class="text-[#3BB143] font-bold">2023</span>
              </div>
              <div class="flex-grow border-l-2 border-[#3BB143] pl-6 pb-6">
                <h3 class="font-semibold text-gray-900 mb-2">El començament</h3>
                <p class="text-gray-600">
                  FreshExpress neix a Barcelona amb la idea de revolucionar el
                  lliurament d'última milla amb una flota 100% elèctrica.
                  Comencem amb 5 repartidors i un somni: demostrar que la
                  logística pot ser sostenible.
                </p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-16 text-right">
                <span class="text-[#3BB143] font-bold">2024</span>
              </div>
              <div class="flex-grow border-l-2 border-[#3BB143] pl-6 pb-6">
                <h3 class="font-semibold text-gray-900 mb-2">Creixement</h3>
                <p class="text-gray-600">
                  Expandim les operacions a tota l'àrea metropolitana de
                  Barcelona. Incorporem tecnologia de rastreig en temps real i
                  optimització de rutes amb intel·ligència artificial.
                </p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-16 text-right">
                <span class="text-[#0047AB] font-bold">2025</span>
              </div>
              <div class="flex-grow border-l-2 border-[#0047AB] pl-6">
                <h3 class="font-semibold text-gray-900 mb-2">Actualitat</h3>
                <p class="text-gray-600">
                  Avui som més de 50 repartidors compromesos amb el medi
                  ambient. Hem lliurat més de 50.000 comandes i estalviat més de
                  15 tones de CO₂. I això només és el principi!
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Equip -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">
            L'equip darrere de FreshExpress
          </h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Un equip apassionat per la sostenibilitat i la tecnologia.
          </p>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center">
            <div
              class="w-32 h-32 bg-gradient-to-br from-[#0047AB] to-[#3BB143] rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-4xl font-bold text-white">MC</span>
            </div>
            <h3 class="text-lg font-semibold text-gray-900">Maria Costa</h3>
            <p class="text-[#3BB143] text-sm mb-2">CEO & Co-fundadora</p>
            <p class="text-gray-600 text-sm">
              Experta en logística sostenible amb més de 10 anys d'experiència
              en el sector.
            </p>
          </div>
          <div class="text-center">
            <div
              class="w-32 h-32 bg-gradient-to-br from-[#3BB143] to-[#0047AB] rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-4xl font-bold text-white">JP</span>
            </div>
            <h3 class="text-lg font-semibold text-gray-900">Joan Puig</h3>
            <p class="text-[#3BB143] text-sm mb-2">CTO & Co-fundador</p>
            <p class="text-gray-600 text-sm">
              Enginyer de software apassionat per crear solucions tecnològiques
              amb impacte positiu.
            </p>
          </div>
          <div class="text-center">
            <div
              class="w-32 h-32 bg-gradient-to-br from-[#0047AB] to-[#3BB143] rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-4xl font-bold text-white">LF</span>
            </div>
            <h3 class="text-lg font-semibold text-gray-900">Laura Fernández</h3>
            <p class="text-[#3BB143] text-sm mb-2">Directora d'Operacions</p>
            <p class="text-gray-600 text-sm">
              Especialista en optimització de processos i gestió d'equips de
              repartiment.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
          class="bg-gradient-to-r from-[#0047AB] to-[#003080] rounded-2xl p-8 md:p-12 text-center text-white"
        >
          <h2 class="text-2xl md:text-3xl font-bold mb-4">
            Vols formar part del canvi?
          </h2>
          <p class="text-white/80 mb-8 max-w-2xl mx-auto">
            Uneix-te a FreshExpress com a client o repartidor i ajuda'ns a
            construir un futur més sostenible per a les nostres ciutats.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/registre"
              class="inline-flex items-center justify-center px-8 py-3 bg-[#3BB143] text-white rounded-lg hover:bg-[#32a039] transition-colors font-medium"
            >
              Registra't ara
            </a>
            <a
              href="/contacte"
              class="inline-flex items-center justify-center px-8 py-3 border-2 border-white text-white rounded-lg hover:bg-white hover:text-[#0047AB] transition-colors font-medium"
            >
              Contacta'ns
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
