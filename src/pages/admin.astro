                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              Panell d'Administració
            </h1>
            <p class="text-gray-600 mt-1">
              Gestió d'usuaris i dades del sistema
            </p>
          </div>
          <a
