        <div class="bg-white rounded-xl shadow p-5">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-500 text-sm">Total Usuaris</p>
              <p class="text-2xl font-bold text-gray-900">
                {stats.totalUsuaris}
              </p>
            </div>
            <div
              class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center"
            >
              <svg
                class="w-5 h-5 text-blue-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                ></path>
              </svg>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-xl shadow p-5">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-500 text-sm">Usuaris Actius</p>
              <p class="text-2xl font-bold text-green-600">
                {stats.usuarisActius}
              </p>
            </div>
            <div
              class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center"
            >
              <svg
                class="w-5 h-5 text-green-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-xl shadow p-5">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-500 text-sm">Data for Good</p>
              <p class="text-2xl font-bold text-[#3BB143]">
                {stats.usuarisDataBroker}
              </p>
            </div>
            <div
              class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center"
            >
              <svg
                class="w-5 h-5 text-green-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
                ></path></svg
              >
            </div>
          </div>
        </div>

        <div class="bg-white rounded-xl shadow p-5">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-500 text-sm">Sessions Web</p>
              <p class="text-2xl font-bold text-purple-600">
                {stats.totalSessions}
              </p>
            </div>
            <div
              class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center"
            >
              <svg
                class="w-5 h-5 text-purple-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                ></path>
              </svg>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-xl shadow p-5">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-500 text-sm">Events Tracking</p>
              <p class="text-2xl font-bold text-orange-600">
                {stats.totalEvents}
              </p>
            </div>
            <div
              class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center"
            >
              <svg
                class="w-5 h-5 text-orange-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                ></path>
              </svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Navegació per seccions -->
      <div class="bg-white rounded-xl shadow mb-6">
        <div class="border-b border-gray-200">
          <nav class="flex -mb-px">
            <button
              class="tab-btn active px-6 py-4 text-sm font-medium border-b-2 border-[#3BB143] text-[#3BB143]"
              data-tab="usuaris"
            >
              Usuaris
            </button>
            <button
              class="tab-btn px-6 py-4 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700"
              data-tab="databroker"
            >
              Data Broker
            </button>
            <button
              class="tab-btn px-6 py-4 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700"
              data-tab="configuracio"
            >
              Configuració
            </button>
          </nav>
        </div>
      </div>

      <!-- Tab: Usuaris -->
      <div id="tab-usuaris" class="tab-content">
        <div class="bg-white rounded-xl shadow overflow-hidden">
          <div
            class="px-6 py-4 border-b border-gray-200 flex items-center justify-between"
          >
            <h2 class="text-lg font-semibold text-gray-900">
              Gestió d'Usuaris
            </h2>
            <div class="flex items-center space-x-2">
              <input
                type="text"
                id="search-users"
                placeholder="Cercar usuaris..."
                class="px-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#3BB143]"
              />
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th
                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                    >Usuari</th
                  >
                  <th
                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                    >Email</th
                  >
                  <th
                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                    >Rol</th
                  >
                  <th
                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                    >Estat</th
                  >
                  <th
                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                    >Data Broker</th
                  >
                  <th
                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                    >Registre</th
                  >
                  <th
                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                    >Accions</th
                  >
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                {
                  usuaris.map((u) => (
                    <tr class="hover:bg-gray-50" data-user-id={u.id}>
                      <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center">
                          <div class="w-8 h-8 bg-gradient-to-br from-[#3BB143] to-[#0047AB] rounded-full flex items-center justify-center text-white text-sm font-bold">
                            {u.nombre?.charAt(0).toUpperCase() || "?"}
                          </div>
                          <div class="ml-3">
                            <div class="text-sm font-medium text-gray-900">
                              {u.nombre}
                            </div>
                          </div>
                        </div>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                        {u.email}
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        <span
                          class={`px-2 py-1 text-xs font-medium rounded-full ${
                            u.rol === "admin"
                              ? "bg-red-100 text-red-800"
                              : u.rol === "repartidor"
                                ? "bg-blue-100 text-blue-800"
                                : "bg-gray-100 text-gray-800"
                          }`}
                        >
                          {u.rol || "cliente"}
                        </span>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        <span
                          class={`px-2 py-1 text-xs font-medium rounded-full ${
                            u.estado === "activo"
                              ? "bg-green-100 text-green-800"
                              : "bg-red-100 text-red-800"
                          }`}
                        >
                          {u.estado}
                        </span>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        {u.compartir_datos ? (
                          <span class="text-green-600">✓ Actiu</span>
                        ) : (
                          <span class="text-gray-400">No</span>
                        )}
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                        {u.fecha_registro
                          ? new Date(u.fecha_registro).toLocaleDateString(
                              "ca-ES"
                            )
                          : "-"}
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm">
                        <button
                          class="text-blue-600 hover:text-blue-800 mr-3 edit-user-btn"
                          data-user-id={u.id}
                          data-user-nombre={u.nombre || ""}
                          data-user-email={u.email}
                          data-user-rol={u.rol || "cliente"}
                        >
                          Editar
                        </button>
                        {u.estado === "activo" ? (
                          <button
                            class="text-red-600 hover:text-red-800 suspend-user-btn"
                            data-user-id={u.id}
                          >
                            Suspendre
                          </button>
                        ) : (
                          <button
                            class="text-green-600 hover:text-green-800 activate-user-btn"
                            data-user-id={u.id}
                          >
                            Activar
                          </button>
                        )}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Tab: Data Broker -->
      <div id="tab-databroker" class="tab-content hidden">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div class="bg-white rounded-xl shadow p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">
              Resum Data Broker
            </h3>
            <div class="space-y-4">
              <div
                class="flex justify-between items-center p-3 bg-gray-50 rounded-lg"
              >
                <span class="text-gray-600">Usuaris amb consentiment</span>
                <span class="font-bold text-[#3BB143]"
                  >{stats.usuarisDataBroker}</span
                >
              </div>
              <div
                class="flex justify-between items-center p-3 bg-gray-50 rounded-lg"
              >
                <span class="text-gray-600">% de participació</span>
                <span class="font-bold text-[#0047AB]">
                  {
                    stats.totalUsuaris > 0
                      ? Math.round(
                          (stats.usuarisDataBroker / stats.totalUsuaris) * 100
                        )
                      : 0
                  }%
                </span>
              </div>
              <div
                class="flex justify-between items-center p-3 bg-gray-50 rounded-lg"
              >
                <span class="text-gray-600">Events recollits</span>
                <span class="font-bold text-purple-600"
                  >{stats.totalEvents}</span
                >
              </div>
            </div>
          </div>

          <div class="bg-white rounded-xl shadow p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">
              Accions del Data Broker
            </h3>
            <div class="space-y-3">
              <button
                class="w-full px-4 py-3 bg-blue-50 text-blue-700 rounded-lg hover:bg-blue-100 transition-colors text-left"
              >
                Exportar dades anonimitzades (CSV)
              </button>
              <button
                class="w-full px-4 py-3 bg-green-50 text-green-700 rounded-lg hover:bg-green-100 transition-colors text-left"
              >
                Generar informe de tendències
              </button>
              <button
                class="w-full px-4 py-3 bg-purple-50 text-purple-700 rounded-lg hover:bg-purple-100 transition-colors text-left"
              >
                Veure patrons de comportament
              </button>
              <button
                class="w-full px-4 py-3 bg-red-50 text-red-700 rounded-lg hover:bg-red-100 transition-colors text-left"
              >
                Purgar dades antigues (>1 any)
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Tab: Configuració -->
      <div id="tab-configuracio" class="tab-content hidden">
        <div class="bg-white rounded-xl shadow p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-6">
            Configuració del Sistema
          </h3>

          <div class="space-y-6">
            <div class="p-4 border border-gray-200 rounded-lg">
              <h4 class="font-medium text-gray-900 mb-2">
                Informació del Sistema
              </h4>
              <div class="grid grid-cols-2 gap-4 text-sm">
                <div>
                  <span class="text-gray-500">Versió:</span>
                  <span class="ml-2 font-medium">1.0.0</span>
                </div>
                <div>
                  <span class="text-gray-500">Entorn:</span>
                  <span class="ml-2 font-medium">{import.meta.env.MODE}</span>
                </div>
              </div>
            </div>

            <div class="p-4 border border-yellow-200 bg-yellow-50 rounded-lg">
              <h4 class="font-medium text-yellow-800 mb-2">
                Zona de Manteniment
              </h4>
              <p class="text-sm text-yellow-700 mb-3">
                Aquestes accions poden afectar el rendiment del sistema. Usa-les
                amb precaució.
              </p>
              <div class="flex flex-wrap gap-2">
                <button
                  class="px-4 py-2 bg-yellow-100 text-yellow-800 rounded-lg hover:bg-yellow-200 text-sm"
                >
                  Netejar cache
                </button>
                <button
                  class="px-4 py-2 bg-yellow-100 text-yellow-800 rounded-lg hover:bg-yellow-200 text-sm"
                >
                  Reindexar BD
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal d'Edició d'Usuari -->
  <div
    id="edit-modal"
    class="fixed inset-0 bg-black/50 z-50 items-center justify-center p-4"
    style="display: none;"
  >
    <div class="bg-white rounded-xl shadow-2xl max-w-md w-full p-6">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-xl font-bold text-gray-900">Editar Usuari</h3>
        <button id="close-modal" class="text-gray-400 hover:text-gray-600">
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <form id="edit-user-form" class="space-y-4">
        <input type="hidden" id="edit-user-id" />

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1"
              >Nom</label
            >
            <input
              type="text"
              id="edit-nombre"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3BB143]"
            />
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1"
            >Email</label
          >
          <input
            type="email"
            id="edit-email"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3BB143]"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Rol</label
          >
          <select
            id="edit-rol"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3BB143]"
          >
            <option value="cliente">Client</option>
            <option value="repartidor">Repartidor</option>
            <option value="admin">Administrador</option>
          </select>
        </div>

        <div
          id="edit-error"
          class="hidden bg-red-50 text-red-700 p-3 rounded-lg text-sm"
        >
        </div>
        <div
          id="edit-success"
          class="hidden bg-green-50 text-green-700 p-3 rounded-lg text-sm"
        >
        </div>

        <div class="flex justify-end space-x-3 pt-4">
          <button
            type="button"
            id="cancel-edit"
            class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50"
          >
            Cancel·lar
          </button>
          <button
            type="submit"
            class="px-4 py-2 bg-[#3BB143] text-white rounded-lg hover:bg-[#2d8a33]"
          >
            Guardar Canvis
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  // Gestió de tabs
  document.querySelectorAll(".tab-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      // Desactivar tots
      document.querySelectorAll(".tab-btn").forEach((b) => {
        b.classList.remove("active", "border-[#3BB143]", "text-[#3BB143]");
        b.classList.add("border-transparent", "text-gray-500");
      });
      document
        .querySelectorAll(".tab-content")
        .forEach((c) => c.classList.add("hidden"));

      // Activar seleccionat
      btn.classList.add("active", "border-[#3BB143]", "text-[#3BB143]");
      btn.classList.remove("border-transparent", "text-gray-500");

      const tabId = (btn as HTMLElement).dataset.tab;
      document.getElementById(`tab-${tabId}`)?.classList.remove("hidden");
    });
  });

  // Cerca d'usuaris
  document.getElementById("search-users")?.addEventListener("input", (e) => {
    const search = (e.target as HTMLInputElement).value.toLowerCase();
    document.querySelectorAll("tbody tr").forEach((row) => {
      const text = row.textContent?.toLowerCase() || "";
      (row as HTMLElement).style.display = text.includes(search) ? "" : "none";
    });
  });

  // Suspendre usuari
  document.querySelectorAll(".suspend-user-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const userId = (btn as HTMLElement).dataset.userId;
      if (!confirm("Segur que vols suspendre aquest usuari?")) return;

      try {
        const res = await fetch(`/api/admin/users/${userId}/status`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ estado: "suspendido" }),
        });
        if (res.ok) location.reload();
        else alert("Error suspenent usuari");
      } catch {
        alert("Error de connexió");
      }
    });
  });

  // Activar usuari
  document.querySelectorAll(".activate-user-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const userId = (btn as HTMLElement).dataset.userId;

      try {
        const res = await fetch(`/api/admin/users/${userId}/status`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ estado: "activo" }),
        });
        if (res.ok) location.reload();
        else alert("Error activant usuari");
      } catch {
        alert("Error de connexió");
      }
    });
  });

  // Modal d'edició
  const modal = document.getElementById("edit-modal");
  const closeModalBtn = document.getElementById("close-modal");
  const cancelEditBtn = document.getElementById("cancel-edit");
  const editForm = document.getElementById("edit-user-form") as HTMLFormElement;

  function openModal() {
    if (modal) {
      modal.style.display = "flex";
    }
  }

  function closeModal() {
    if (modal) {
      modal.style.display = "none";
    }
    document.getElementById("edit-error")?.classList.add("hidden");
    document.getElementById("edit-success")?.classList.add("hidden");
  }

  closeModalBtn?.addEventListener("click", closeModal);
  cancelEditBtn?.addEventListener("click", closeModal);
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  // Obrir modal amb dades de l'usuari
  document.querySelectorAll(".edit-user-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const dataset = (btn as HTMLElement).dataset;
      (document.getElementById("edit-user-id") as HTMLInputElement).value =
        dataset.userId || "";
      (document.getElementById("edit-nombre") as HTMLInputElement).value =
        dataset.userNombre || "";
      (document.getElementById("edit-email") as HTMLInputElement).value =
        dataset.userEmail || "";
      (document.getElementById("edit-rol") as HTMLSelectElement).value =
        dataset.userRol || "cliente";
      openModal();
    });
  });

  // Enviar formulari d'edició
  editForm?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const userId = (document.getElementById("edit-user-id") as HTMLInputElement)
      .value;
    const nombre = (document.getElementById("edit-nombre") as HTMLInputElement)
      .value;
    const email = (document.getElementById("edit-email") as HTMLInputElement)
      .value;
    const rol = (document.getElementById("edit-rol") as HTMLSelectElement)
      .value;

    const errorDiv = document.getElementById("edit-error");
    const successDiv = document.getElementById("edit-success");

    try {
      const res = await fetch(`/api/admin/users/${userId}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ nombre, email, rol }),
      });

      const data = await res.json();

      if (res.ok) {
        successDiv?.classList.remove("hidden");
        if (successDiv)
          successDiv.textContent = "Usuari actualitzat correctament";
        setTimeout(() => location.reload(), 1000);
      } else {
        errorDiv?.classList.remove("hidden");
        if (errorDiv)
          errorDiv.textContent = data.error || "Error actualitzant usuari";
      }
    } catch {
      errorDiv?.classList.remove("hidden");
      if (errorDiv) errorDiv.textContent = "Error de connexió";
    }
  });
</script>
