---
import Layout from "../layouts/Layout.astro";
import { verifyToken, getUserById } from "../lib/auth";
import { queryOperacional, queryBroker } from "../lib/db";

// Verificar autenticació i rol admin
const token = Astro.cookies.get("auth_token")?.value;
let user = null;

if (token) {
  const payload = verifyToken(token);
  if (payload) {
    user = await getUserById(payload.userId);
  }
}

// Redirigir si no és admin
if (!user || user.rol !== "admin") {
  return Astro.redirect("/dashboard");
}

// Obtenir estadístiques
let stats = {
  totalUsuaris: 0,
  usuarisActius: 0,
  usuarisDataBroker: 0,
  totalSessions: 0,
  totalEvents: 0,
};

try {
  const usersCount = await queryOperacional<any[]>(
    "SELECT COUNT(*) as count FROM usuarios"
  );
  const activeCount = await queryOperacional<any[]>(
    "SELECT COUNT(*) as count FROM usuarios WHERE estado = 'activo'"
  );
  const dataBrokerCount = await queryOperacional<any[]>(
    "SELECT COUNT(*) as count FROM consentimientos WHERE compartir_datos = 1"
  );

  stats.totalUsuaris = usersCount[0]?.count || 0;
  stats.usuarisActius = activeCount[0]?.count || 0;
  stats.usuarisDataBroker = dataBrokerCount[0]?.count || 0;

  try {
    const sessionsCount = await queryBroker<any[]>(
      "SELECT COUNT(*) as count FROM sesiones_web"
    );
    const eventsCount = await queryBroker<any[]>(
      "SELECT COUNT(*) as count FROM eventos_web"
    );
    stats.totalSessions = sessionsCount[0]?.count || 0;
    stats.totalEvents = eventsCount[0]?.count || 0;
  } catch {
    // Data broker tables might not exist yet
  }
} catch (error) {
  console.error("Error obtenint estadístiques:", error);
}

// Obtenir llista d'usuaris
let usuaris: any[] = [];
try {
  usuaris = await queryOperacional<any[]>(`
    SELECT u.id, u.email, u.nombre, u.estado, u.rol, u.fecha_registro, u.ultimo_login,
           c.compartir_datos, c.acepta_comunicaciones
    FROM usuarios u
    LEFT JOIN consentimientos c ON u.id = c.usuario_id
    ORDER BY u.fecha_registro DESC
    LIMIT 50
  `);
} catch (error) {
  console.error("Error obtenint usuaris:", error);
}
