---
import Layout from "../layouts/Layout.astro";
import { verifyToken, getUserById } from "../lib/auth";

// Verificar autenticació
const token = Astro.cookies.get("auth_token")?.value;
let user = null;

if (token) {
  const payload = verifyToken(token);
  if (payload) {
    user = await getUserById(payload.userId);
  }
}

if (!user) {
  return Astro.redirect("/login");
}
---

<Layout title="Suport - FreshExpress">
  <div class="min-h-screen bg-gray-100 py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Navegació -->
      <div class="mb-6">
        <a
          href="/dashboard"
          class="text-[#3BB143] hover:text-[#32a039] text-sm font-medium flex items-center"
        >
          <svg
            class="w-4 h-4 mr-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"></path>
          </svg>
          Tornar al Dashboard
        </a>
      </div>

      <div class="bg-white rounded-xl shadow-lg p-6 md:p-8">
        <h1 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
          <svg
            class="w-7 h-7 mr-3 text-purple-600"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>
          Centre de Suport
        </h1>

        <!-- Opcions de contacte -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
          <a
            href="tel:+34938506064"
            class="p-6 border border-gray-200 rounded-xl hover:shadow-md transition-all text-center"
          >
            <div
              class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-3"
            >
              <svg
                class="w-6 h-6 text-[#3BB143]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
            </div>
            <h3 class="font-medium text-gray-900">Telèfon</h3>
            <p class="text-sm text-gray-500 mt-1">+34 938 506 064</p>
            <p class="text-xs text-gray-400 mt-1">Dill-Div 9h-20h</p>
          </a>

          <a
            href="mailto:contacte@freshexpress.com"
            class="p-6 border border-gray-200 rounded-xl hover:shadow-md transition-all text-center"
          >
            <div
              class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-3"
            >
              <svg
                class="w-6 h-6 text-[#0047AB]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3 class="font-medium text-gray-900">Email</h3>
            <p class="text-sm text-gray-500 mt-1">contacte@freshexpress.com</p>
            <p class="text-xs text-gray-400 mt-1">Resposta en 24h</p>
          </a>

          <button
            id="chat-btn"
            class="p-6 border border-gray-200 rounded-xl hover:shadow-md transition-all text-center"
          >
            <div
              class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-3"
            >
              <svg
                class="w-6 h-6 text-purple-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                ></path>
              </svg>
            </div>
            <h3 class="font-medium text-gray-900">Xat en viu</h3>
            <p class="text-sm text-gray-500 mt-1">Parla amb nosaltres</p>
            <p class="text-xs text-green-600 mt-1">● En línia</p>
          </button>
        </div>

        <!-- FAQ -->
        <div class="mb-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">
            Preguntes Freqüents
          </h2>
          <div class="space-y-3">
            <details class="border border-gray-200 rounded-lg">
              <summary
                class="px-4 py-3 cursor-pointer hover:bg-gray-50 font-medium text-gray-900"
              >
                Com puc fer seguiment de la meva comanda?
              </summary>
              <div class="px-4 py-3 bg-gray-50 text-gray-600 text-sm">
                Pots fer seguiment de la teva comanda des del <a
                  href="/seguiment"
                  class="text-[#3BB143] hover:underline">panell de seguiment</a
                >. Només necessites introduir el codi de seguiment que t'hem
                enviat per email.
              </div>
            </details>

            <details class="border border-gray-200 rounded-lg">
              <summary
                class="px-4 py-3 cursor-pointer hover:bg-gray-50 font-medium text-gray-900"
              >
                Quins són els horaris de lliurament?
              </summary>
              <div class="px-4 py-3 bg-gray-50 text-gray-600 text-sm">
                Lliurem de dilluns a dissabte, de 8h a 21h. Pots seleccionar la
                franja horària que prefereixis durant el procés de compra.
              </div>
            </details>

            <details class="border border-gray-200 rounded-lg">
              <summary
                class="px-4 py-3 cursor-pointer hover:bg-gray-50 font-medium text-gray-900"
              >
                Com funciona el lliurament ecològic?
              </summary>
              <div class="px-4 py-3 bg-gray-50 text-gray-600 text-sm">
                Tots els nostres lliuraments es fan amb vehicles elèctrics o
                bicicletes de càrrega. Això ens permet reduir les emissions de
                CO₂ i contribuir a una ciutat més neta.
              </div>
            </details>

            <details class="border border-gray-200 rounded-lg">
              <summary
                class="px-4 py-3 cursor-pointer hover:bg-gray-50 font-medium text-gray-900"
              >
                Puc cancel·lar o modificar una comanda?
              </summary>
              <div class="px-4 py-3 bg-gray-50 text-gray-600 text-sm">
                Pots cancel·lar o modificar la teva comanda fins a 2 hores abans
                del lliurament programat. Contacta'ns per telèfon o xat per
                fer-ho.
              </div>
            </details>

            <details class="border border-gray-200 rounded-lg">
              <summary
                class="px-4 py-3 cursor-pointer hover:bg-gray-50 font-medium text-gray-900"
              >
                Quina és la vostra política de devolucions?
              </summary>
              <div class="px-4 py-3 bg-gray-50 text-gray-600 text-sm">
                Si no estàs satisfet amb el producte rebut, pots sol·licitar una
                devolució o reemborsament dins de les primeres 24 hores després
                del lliurament. Els productes frescos s'han de mantenir en les
                condicions adequades.
              </div>
            </details>
          </div>
        </div>

        <!-- Formulari de contacte -->
        <div class="border-t border-gray-200 pt-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">
            Envia'ns un missatge
          </h2>

          <form id="support-form" class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Assumpte</label
              >
              <select
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3BB143]"
              >
                <option>Problema amb una comanda</option>
                <option>Consulta general</option>
                <option>Suggeriment</option>
                <option>Reclamació</option>
                <option>Altres</option>
              </select>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Número de comanda (opcional)</label
              >
              <input
                type="text"
                placeholder="FE-2024-XXXXX"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3BB143]"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Missatge</label
              >
              <textarea
                rows="4"
                placeholder="Explica'ns com podem ajudar-te..."
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3BB143]"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-3 bg-[#3BB143] text-white font-medium rounded-lg hover:bg-[#32a039] transition-colors"
            >
              Enviar missatge
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  document.getElementById("support-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    alert("Missatge enviat! Et respondrem el més aviat possible.");
  });

  document.getElementById("chat-btn")?.addEventListener("click", () => {
    alert("El xat en viu estarà disponible pròximament.");
  });
</script>
