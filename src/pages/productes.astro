---
import Layout from '../layouts/Layout.astro';
import { verifyToken, getUserById } from '../lib/auth';
import { queryOperacional, getEmpreses } from '../lib/db';

// Verificar autenticació
const token = Astro.cookies.get('auth_token')?.value;
let user = null;

if (token) {
  const payload = verifyToken(token);
  if (payload) {
    user = await getUserById(payload.userId);
  }
}

if (!user) {
  return Astro.redirect('/login');
}

// Obtenir empresa si s'ha seleccionat
const empresaId = Astro.url.searchParams.get('empresa');
let empresaActual: any = null;
let productes: any[] = [];
let empreses: any[] = [];
let errorCarregant = false;

try {
  // Carregar les empreses des de la base de dades.
  empreses = await getEmpreses();

  // Si hi ha empresa seleccionada, obtenir els seus productes
  if (empresaId) {
    const empresaData = await queryOperacional<any[]>(
      'SELECT id, nombre, descripcion, categoria, logo, direccion, telefono, email, valoracion_media FROM empresas WHERE id = ? AND activo = 1',
      [empresaId]
    );
    empresaActual = empresaData[0] || null;

    if (empresaActual) {
      productes = await queryOperacional<any[]>(`
        SELECT id, nombre, descripcion, categoria, precio, precio_oferta, unidad, imagen, destacado
        FROM productos 
        WHERE empresa_id = ? AND activo = 1 
        ORDER BY categoria, nombre
      `, [empresaId]);
    }
  }
} catch (error) {
  console.error('Error carregant dades:', error);
  errorCarregant = true;
}

// Agrupar empreses per categoria
const empresesPerCategoria = empreses.reduce((acc: any, emp: any) => {
  if (!acc[emp.categoria]) acc[emp.categoria] = [];
  acc[emp.categoria].push(emp);
  return acc;
}, {});
---

<Layout title={empresaActual ? `${empresaActual.nombre} - FreshExpress` : 'Productes - FreshExpress'}>
  <div class="min-h-screen bg-gray-100 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {!empresaActual ? (
        <!-- Vista d'empreses -->
        <div>
          <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Botigues i Proveïdors</h1>
            <p class="text-gray-600 mt-2">Descobreix les millors empreses de Catalunya i fes la teva comanda</p>
          </div>

          {Object.keys(empresesPerCategoria).length === 0 ? (
            <div class="bg-white rounded-xl shadow p-12 text-center">
              <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
              <p class="text-gray-500">No hi ha empreses disponibles en aquest moment.</p>
              <p class="text-sm text-gray-400 mt-2">Si us plau, torna-ho a intentar més tard.</p>
            </div>
          ) : (
            Object.entries(empresesPerCategoria).map(([categoria, emps]: [string, any]) => (
              <div class="mb-10">
                <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center">
                  <span class="w-2 h-6 bg-[#3BB143] rounded mr-3"></span>
                  {categoria}
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                  {emps.map((empresa: any) => (
                    <a 
                      href={`/productes?empresa=${empresa.id}`}
                      class="bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden group"
                    >
                      <div class="h-32 bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center p-6">
                        {empresa.logo ? (
                          <img 
                            src={empresa.logo} 
                            alt={`Logo ${empresa.nombre}`}
                            class="w-20 h-20 object-contain group-hover:scale-110 transition-transform"
                          />
                        ) : (
                          <div class="w-20 h-20 bg-white rounded-xl shadow flex items-center justify-center text-2xl font-bold text-[#0047AB] group-hover:scale-110 transition-transform">
                            {empresa.nombre.charAt(0)}
                          </div>
                        )}
                      </div>
                      <div class="p-5">
                        <h3 class="font-semibold text-lg text-gray-900 group-hover:text-[#3BB143] transition-colors">
                          {empresa.nombre}
                        </h3>
                        <p class="text-sm text-gray-500 mt-1 line-clamp-2">
                          {empresa.descripcion || 'Sense descripció'}
                        </p>
                        <div class="mt-3 flex items-center justify-between">
                          <div class="flex items-center">
                            <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                            </svg>
                            <span class="text-sm text-gray-600 ml-1">{empresa.valoracion_media || '5.0'}</span>
                          </div>
                          <span class="text-[#3BB143] text-sm font-medium group-hover:translate-x-1 transition-transform">
                            Veure productes →
                          </span>
                        </div>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            ))
          )}
        </div>
      ) : (
        <!-- Vista de productes d'una empresa -->
        <div>
          <!-- Breadcrumb -->
          <div class="mb-6">
            <a href="/productes" class="text-[#3BB143] hover:text-[#32a039] text-sm font-medium flex items-center">
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
              Tornar a totes les botigues
            </a>
          </div>

          <!-- Capçalera empresa -->
          <div class="bg-white rounded-xl shadow-md p-6 mb-8">
            <div class="flex items-center">
              <div class="w-16 h-16 bg-gradient-to-br from-[#3BB143] to-[#0047AB] rounded-xl flex items-center justify-center text-white text-2xl font-bold mr-5">
                {empresaActual.nombre.charAt(0)}
              </div>
              <div class="flex-1">
                <h1 class="text-2xl font-bold text-gray-900">{empresaActual.nombre}</h1>
                <p class="text-gray-600 mt-1">{empresaActual.descripcion}</p>
                <div class="flex items-center gap-4 mt-2 text-sm text-gray-500">
                  <span class="capitalize">{empresaActual.categoria}</span>
                  <span>•</span>
                  <div class="flex items-center">
                    <svg class="w-4 h-4 text-yellow-400 mr-1" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                    </svg>
                    <span>{empresaActual.valoracion_media || '5.0'}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Llistat de productes -->
          {productes.length === 0 ? (
            <div class="bg-white rounded-xl shadow p-12 text-center">
              <p class="text-gray-500">No hi ha productes disponibles per aquesta empresa.</p>
            </div>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
              {productes.map((producte: any) => (
                <div class="product-card bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-shadow" data-product-id={producte.id}>
                  <div class="h-40 bg-gray-100 flex items-center justify-center relative">
                    {producte.imagen ? (
                      <img 
                        src={producte.imagen} 
                        alt={producte.nombre}
                        class="w-full h-full object-cover"
                        loading="lazy"
                      />
                    ) : (
                      <div class="flex flex-col items-center justify-center text-gray-300">
                        <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                        <span class="text-xs mt-1">Sense imatge</span>
                      </div>
                    )}
                    {producte.destacado === 1 && (
                      <span class="absolute top-2 left-2 px-2 py-1 bg-yellow-500 text-white text-xs font-medium rounded">
                        ⭐ Destacat
                      </span>
                    )}
                    {producte.precio_oferta && (
                      <span class="absolute top-2 right-2 px-2 py-1 bg-red-500 text-white text-xs font-medium rounded">
                        Oferta
                      </span>
                    )}
                  </div>
                  <div class="p-4">
                    <span class="text-xs text-gray-400 uppercase">{producte.categoria}</span>
                    <h3 class="font-medium text-gray-900 mt-1 line-clamp-2">{producte.nombre}</h3>
                    <p class="text-sm text-gray-500 mt-1 line-clamp-2">{producte.descripcion}</p>
                    <div class="mt-4">
                      <div class="flex items-center justify-between mb-3">
                        <div>
                          {producte.precio_oferta ? (
                            <div class="flex items-center gap-2">
                              <span class="text-lg font-bold text-[#3BB143]">{Number(producte.precio_oferta).toFixed(2)} €</span>
                              <span class="text-sm text-gray-400 line-through">{Number(producte.precio).toFixed(2)} €</span>
                            </div>
                          ) : (
                            <span class="text-lg font-bold text-gray-900">{Number(producte.precio).toFixed(2)} €</span>
                          )}
                          <span class="text-xs text-gray-400">/ {producte.unidad}</span>
                        </div>
                      </div>
                      <!-- Selector de quantitat i botó afegir -->
                      <div class="flex items-center gap-2">
                        <div class="flex items-center border border-gray-300 rounded-lg">
                          <button 
                            class="qty-decrease w-8 h-8 flex items-center justify-center text-gray-600 hover:bg-gray-100 rounded-l-lg transition-colors"
                            data-product-id={producte.id}
                          >
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
                            </svg>
                          </button>
                          <span class="qty-value w-10 text-center font-medium text-gray-900" data-product-id={producte.id}>1</span>
                          <button 
                            class="qty-increase w-8 h-8 flex items-center justify-center text-gray-600 hover:bg-gray-100 rounded-r-lg transition-colors"
                            data-product-id={producte.id}
                          >
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                            </svg>
                          </button>
                        </div>
                        <button 
                          class="add-to-cart add-to-cart-btn flex-1 h-8 bg-[#3BB143] text-white text-sm font-medium rounded-lg hover:bg-[#32a039] transition-colors flex items-center justify-center gap-1"
                          data-product-id={producte.id}
                          data-product-name={producte.nombre}
                          data-product-price={producte.precio_oferta || producte.precio}
                          data-action="add-to-cart"
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                          </svg>
                          Afegir
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  // Gestionar selector de quantitat
  document.querySelectorAll('.qty-decrease').forEach(btn => {
    btn.addEventListener('click', () => {
      const productId = (btn as HTMLElement).dataset.productId;
      const qtySpan = document.querySelector(`.qty-value[data-product-id="${productId}"]`);
      if (qtySpan) {
        const current = parseInt(qtySpan.textContent || '1');
        if (current > 1) qtySpan.textContent = String(current - 1);
      }
    });
  });

  document.querySelectorAll('.qty-increase').forEach(btn => {
    btn.addEventListener('click', () => {
      const productId = (btn as HTMLElement).dataset.productId;
      const qtySpan = document.querySelector(`.qty-value[data-product-id="${productId}"]`);
      if (qtySpan) {
        const current = parseInt(qtySpan.textContent || '1');
        if (current < 99) qtySpan.textContent = String(current + 1);
      }
    });
  });

  // Afegir producte a la cistella
  document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const btnEl = btn as HTMLButtonElement;
      const productId = btnEl.dataset.productId;
      const qtySpan = document.querySelector(`.qty-value[data-product-id="${productId}"]`);
      const quantity = parseInt(qtySpan?.textContent || '1');
      const originalContent = btnEl.innerHTML;
      
      // Disabled i loading state
      btnEl.disabled = true;
      btnEl.innerHTML = `<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>`;
      
      try {
        const res = await fetch('/api/cart/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId, quantity })
        });

        if (res.ok) {
          // Actualitzar comptador de la cistella
          const cartCount = document.getElementById('cart-count');
          if (cartCount) {
            const current = parseInt(cartCount.textContent || '0');
            cartCount.textContent = String(current + quantity);
            cartCount.classList.remove('hidden');
            cartCount.classList.add('flex');
          }
          
          // Feedback visual de èxit
          btnEl.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Afegit!`;
          btnEl.classList.remove('bg-[#3BB143]');
          btnEl.classList.add('bg-green-600');
          
          // Reset quantitat a 1
          if (qtySpan) qtySpan.textContent = '1';
          
          setTimeout(() => {
            btnEl.innerHTML = originalContent;
            btnEl.classList.remove('bg-green-600');
            btnEl.classList.add('bg-[#3BB143]');
            btnEl.disabled = false;
          }, 1500);
          
        } else {
          throw new Error('Error');
        }
      } catch {
        // Error feedback
        btnEl.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg> Error`;
        btnEl.classList.remove('bg-[#3BB143]');
        btnEl.classList.add('bg-red-500');
        
        setTimeout(() => {
          btnEl.innerHTML = originalContent;
          btnEl.classList.remove('bg-red-500');
          btnEl.classList.add('bg-[#3BB143]');
          btnEl.disabled = false;
        }, 1500);
      }
    });
  });
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

</Layout>
