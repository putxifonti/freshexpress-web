---
import Layout from '../layouts/Layout.astro';
import { verifyToken, getUserById } from '../lib/auth';
import { queryOperacional } from '../lib/db';

// Verificar autenticació
const token = Astro.cookies.get('auth_token')?.value;
let user = null;

if (token) {
  const payload = verifyToken(token);
  if (payload) {
    user = await getUserById(payload.userId);
  }
}

if (!user) {
  return Astro.redirect('/login');
}

// Obtenir empresa si s'ha seleccionat
const empresaId = Astro.url.searchParams.get('empresa');
let empresaActual: any = null;
let productes: any[] = [];
let empreses: any[] = [];

try {
  // Obtenir totes les empreses
  empreses = await queryOperacional<any[]>(`
    SELECT id, nombre, descripcion, categoria, logo_url, horario
    FROM empresas 
    WHERE activo = 1 
    ORDER BY nombre ASC
  `);

  // Si hi ha empresa seleccionada, obtenir els seus productes
  if (empresaId) {
    const empresaData = await queryOperacional<any[]>(
      'SELECT * FROM empresas WHERE id = ? AND activo = 1',
      [empresaId]
    );
    empresaActual = empresaData[0] || null;

    if (empresaActual) {
      productes = await queryOperacional<any[]>(`
        SELECT id, nombre, descripcion, categoria, precio, precio_oferta, unidad, eco, imagen_url
        FROM productos 
        WHERE empresa_id = ? AND activo = 1 
        ORDER BY categoria, nombre
      `, [empresaId]);
    }
  }
} catch (error) {
  console.error('Error carregant dades:', error);
}

// Agrupar empreses per categoria
const empresesPerCategoria = empreses.reduce((acc: any, emp: any) => {
  if (!acc[emp.categoria]) acc[emp.categoria] = [];
  acc[emp.categoria].push(emp);
  return acc;
}, {});
---

<Layout title={empresaActual ? `${empresaActual.nombre} - FreshExpress` : 'Productes - FreshExpress'}>
  <div class="min-h-screen bg-gray-100 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {!empresaActual ? (
        <!-- Vista d'empreses -->
        <div>
          <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Botigues i Proveïdors</h1>
            <p class="text-gray-600 mt-2">Descobreix les millors empreses de Catalunya i fes la teva comanda</p>
          </div>

          {Object.keys(empresesPerCategoria).length === 0 ? (
            <div class="bg-white rounded-xl shadow p-12 text-center">
              <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
              <p class="text-gray-500">No hi ha empreses disponibles en aquest moment.</p>
              <p class="text-sm text-gray-400 mt-2">Executa l'script SQL per afegir les dades.</p>
            </div>
          ) : (
            Object.entries(empresesPerCategoria).map(([categoria, emps]: [string, any]) => (
              <div class="mb-10">
                <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center">
                  <span class="w-2 h-6 bg-[#3BB143] rounded mr-3"></span>
                  {categoria}
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                  {emps.map((empresa: any) => (
                    <a 
                      href={`/productes?empresa=${empresa.id}`}
                      class="bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden group"
                    >
                      <div class="h-32 bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center p-6">
                        <div class="w-20 h-20 bg-white rounded-xl shadow flex items-center justify-center text-2xl font-bold text-[#0047AB] group-hover:scale-110 transition-transform">
                          {empresa.nombre.charAt(0)}
                        </div>
                      </div>
                      <div class="p-5">
                        <h3 class="font-semibold text-lg text-gray-900 group-hover:text-[#3BB143] transition-colors">
                          {empresa.nombre}
                        </h3>
                        <p class="text-sm text-gray-500 mt-1 line-clamp-2">
                          {empresa.descripcion}
                        </p>
                        <div class="mt-3 flex items-center justify-between">
                          <span class="text-xs text-gray-400">{empresa.horario}</span>
                          <span class="text-[#3BB143] text-sm font-medium group-hover:translate-x-1 transition-transform">
                            Veure productes →
                          </span>
                        </div>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            ))
          )}
        </div>
      ) : (
        <!-- Vista de productes d'una empresa -->
        <div>
          <!-- Breadcrumb -->
          <div class="mb-6">
            <a href="/productes" class="text-[#3BB143] hover:text-[#32a039] text-sm font-medium flex items-center">
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
              Tornar a totes les botigues
            </a>
          </div>

          <!-- Capçalera empresa -->
          <div class="bg-white rounded-xl shadow-md p-6 mb-8">
            <div class="flex items-center">
              <div class="w-16 h-16 bg-gradient-to-br from-[#3BB143] to-[#0047AB] rounded-xl flex items-center justify-center text-white text-2xl font-bold mr-5">
                {empresaActual.nombre.charAt(0)}
              </div>
              <div class="flex-1">
                <h1 class="text-2xl font-bold text-gray-900">{empresaActual.nombre}</h1>
                <p class="text-gray-600 mt-1">{empresaActual.descripcion}</p>
                <div class="flex items-center gap-4 mt-2 text-sm text-gray-500">
                  <span>{empresaActual.categoria}</span>
                  <span>•</span>
                  <span>{empresaActual.horario}</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Llistat de productes -->
          {productes.length === 0 ? (
            <div class="bg-white rounded-xl shadow p-12 text-center">
              <p class="text-gray-500">No hi ha productes disponibles per aquesta empresa.</p>
            </div>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
              {productes.map((producte: any) => (
                <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-shadow">
                  <div class="h-40 bg-gray-100 flex items-center justify-center relative">
                    <svg class="w-12 h-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    {producte.eco === 1 && (
                      <span class="absolute top-2 left-2 px-2 py-1 bg-green-500 text-white text-xs font-medium rounded">
                        ECO
                      </span>
                    )}
                    {producte.precio_oferta && (
                      <span class="absolute top-2 right-2 px-2 py-1 bg-red-500 text-white text-xs font-medium rounded">
                        Oferta
                      </span>
                    )}
                  </div>
                  <div class="p-4">
                    <span class="text-xs text-gray-400 uppercase">{producte.categoria}</span>
                    <h3 class="font-medium text-gray-900 mt-1 line-clamp-2">{producte.nombre}</h3>
                    <p class="text-sm text-gray-500 mt-1 line-clamp-2">{producte.descripcion}</p>
                    <div class="flex items-center justify-between mt-4">
                      <div>
                        {producte.precio_oferta ? (
                          <div class="flex items-center gap-2">
                            <span class="text-lg font-bold text-[#3BB143]">{producte.precio_oferta.toFixed(2)} €</span>
                            <span class="text-sm text-gray-400 line-through">{producte.precio.toFixed(2)} €</span>
                          </div>
                        ) : (
                          <span class="text-lg font-bold text-gray-900">{producte.precio.toFixed(2)} €</span>
                        )}
                        <span class="text-xs text-gray-400">/ {producte.unidad}</span>
                      </div>
                      <button 
                        class="add-to-cart-btn w-10 h-10 bg-[#3BB143] text-white rounded-lg hover:bg-[#32a039] transition-colors flex items-center justify-center"
                        data-product-id={producte.id}
                        data-product-name={producte.nombre}
                        data-product-price={producte.precio_oferta || producte.precio}
                      >
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  // Afegir producte a la cistella
  document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const productId = (btn as HTMLElement).dataset.productId;
      const productName = (btn as HTMLElement).dataset.productName;
      
      try {
        const res = await fetch('/api/cart/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId, quantity: 1 })
        });

        if (res.ok) {
          // Actualitzar comptador de la cistella
          const cartCount = document.getElementById('cart-count');
          if (cartCount) {
            const current = parseInt(cartCount.textContent || '0');
            cartCount.textContent = String(current + 1);
            cartCount.classList.remove('hidden');
          }
          
          // Feedback visual
          btn.classList.add('bg-green-600');
          setTimeout(() => btn.classList.remove('bg-green-600'), 500);
          
        } else {
          alert('Error afegint el producte a la cistella');
        }
      } catch {
        alert('Error de connexió');
      }
    });
  });
</script>
