---
import Layout from "../../layouts/Layout.astro";
import { verifyToken, getUserById } from "../../lib/auth";
import { queryOperacional } from "../../lib/db";

// Verificar autenticació i rol admin
const token = Astro.cookies.get("auth_token")?.value;
let user = null;

if (token) {
  const payload = verifyToken(token);
  if (payload) {
    user = await getUserById(payload.userId);
  }
}

if (!user || user.rol !== "admin") {
  return Astro.redirect("/dashboard");
}

// Estadístiques generals
let stats = {
  totalComandes: 0,
  comandesPendents: 0,
  comandesAvui: 0,
  comandesSetmana: 0,
  totalRepartidors: 0,
  repartidorsActius: 0,
  totalClients: 0,
  vendesAvui: 0,
  vendesSetmana: 0,
  vendesMes: 0,
};

// Últimes comandes
let ultimesComandes: any[] = [];

// Repartidors actius
let repartidorsActius: any[] = [];

try {
  // Total comandes
  const totalRes = await queryOperacional<any[]>(
    "SELECT COUNT(*) as total FROM pedidos"
  );
  stats.totalComandes = Number(totalRes[0]?.total) || 0;

  // Comandes pendents
  const pendentsRes = await queryOperacional<any[]>(
    "SELECT COUNT(*) as total FROM pedidos WHERE estado NOT IN ('entregado', 'cancelado')"
  );
  stats.comandesPendents = Number(pendentsRes[0]?.total) || 0;

  // Comandes avui
  const avuiRes = await queryOperacional<any[]>(
    "SELECT COUNT(*) as total, COALESCE(SUM(total), 0) as vendes FROM pedidos WHERE DATE(fecha_pedido) = CURDATE()"
  );
  stats.comandesAvui = Number(avuiRes[0]?.total) || 0;
  stats.vendesAvui = Number(avuiRes[0]?.vendes) || 0;

  // Comandes setmana
  const setmanaRes = await queryOperacional<any[]>(
    "SELECT COUNT(*) as total, COALESCE(SUM(total), 0) as vendes FROM pedidos WHERE YEARWEEK(fecha_pedido) = YEARWEEK(CURDATE())"
  );
  stats.comandesSetmana = Number(setmanaRes[0]?.total) || 0;
  stats.vendesSetmana = Number(setmanaRes[0]?.vendes) || 0;

  // Vendes mes
  const mesRes = await queryOperacional<any[]>(
    "SELECT COALESCE(SUM(total), 0) as vendes FROM pedidos WHERE MONTH(fecha_pedido) = MONTH(CURDATE()) AND YEAR(fecha_pedido) = YEAR(CURDATE())"
  );
  stats.vendesMes = Number(mesRes[0]?.vendes) || 0;

  // Total repartidors
  const repartidorsRes = await queryOperacional<any[]>(
    "SELECT COUNT(*) as total FROM repartidores"
  );
  stats.totalRepartidors = Number(repartidorsRes[0]?.total) || 0;

  // Repartidors actius (disponibles)
  const repartidorsActiusRes = await queryOperacional<any[]>(
    "SELECT COUNT(*) as total FROM repartidores WHERE disponible = 1 AND (activo IS NULL OR activo = 1)"
  );
  stats.repartidorsActius = Number(repartidorsActiusRes[0]?.total) || 0;

  // Total clients
  const clientsRes = await queryOperacional<any[]>(
    "SELECT COUNT(*) as total FROM usuarios WHERE rol = 'cliente'"
  );
  stats.totalClients = Number(clientsRes[0]?.total) || 0;

  // Últimes 10 comandes
  ultimesComandes = await queryOperacional<any[]>(`
    SELECT 
      p.id, p.numero_pedido, p.fecha_pedido, p.estado, p.total,
      u.nombre as cliente_nombre,
      r.id as repartidor_id,
      ur.nombre as repartidor_nombre
    FROM pedidos p
    JOIN usuarios u ON p.cliente_id = u.id
    LEFT JOIN repartidores r ON p.repartidor_id = r.id
    LEFT JOIN usuarios ur ON r.usuario_id = ur.id
    ORDER BY p.fecha_pedido DESC
    LIMIT 10
  `);

  // Repartidors actius amb entregues
  repartidorsActius = await queryOperacional<any[]>(`
    SELECT 
      r.id, r.disponible, r.valoracion_media,
      u.nombre, u.email,
      (SELECT COUNT(*) FROM pedidos WHERE repartidor_id = r.id AND estado = 'en_camino') as entregues_actives,
      (SELECT COUNT(*) FROM pedidos WHERE repartidor_id = r.id AND DATE(fecha_entrega) = CURDATE() AND estado = 'entregado') as entregues_avui
    FROM repartidores r
    JOIN usuarios u ON r.usuario_id = u.id
    ORDER BY r.disponible DESC, entregues_actives DESC
    LIMIT 10
  `);
} catch (error) {
  console.error("Error obtenint estadístiques:", error);
}

function traduirEstat(estat: string): string {
  const traduccions: Record<string, string> = {
    pendiente: "Pendent",
    confirmado: "Confirmat",
    preparando: "Preparant",
    listo: "Llest",
    en_camino: "En camí",
    entregado: "Lliurat",
    cancelado: "Cancel·lat",
  };
  return traduccions[estat] || estat;
}

function getEstatClass(estat: string): string {
  const classes: Record<string, string> = {
    pendiente: "bg-yellow-100 text-yellow-800",
    confirmado: "bg-blue-100 text-blue-800",
    preparando: "bg-purple-100 text-purple-800",
    listo: "bg-indigo-100 text-indigo-800",
    en_camino: "bg-orange-100 text-orange-800",
    entregado: "bg-green-100 text-green-800",
    cancelado: "bg-red-100 text-red-800",
  };
  return classes[estat] || "bg-gray-100 text-gray-800";
}
---

<Layout title="Dashboard Admin - FreshExpress">
  <div class="min-h-screen bg-gray-100 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Capçalera -->
      <div
        class="bg-gradient-to-r from-red-600 to-red-700 rounded-2xl shadow-lg p-6 mb-6 text-white"
      >
        <div
          class="flex flex-col md:flex-row md:items-center md:justify-between"
        >
          <div class="flex items-center mb-4 md:mb-0">
            <div
              class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center"
            >
              <svg
                class="w-8 h-8"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                ></path>
              </svg>
            </div>
            <div class="ml-4">
              <h1 class="text-2xl font-bold">Dashboard Administrador</h1>
              <p class="text-white/80">Visió general del sistema</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <a
              href="/admin"
              class="px-4 py-2 bg-white/20 hover:bg-white/30 rounded-lg font-medium transition-colors"
            >
              Panell Admin
            </a>
            <button
              id="logout-btn"
              class="px-4 py-2 bg-white text-red-600 hover:bg-red-50 rounded-lg font-medium transition-colors"
            >
              Tancar sessió
            </button>
          </div>
        </div>
      </div>

      <!-- Estadístiques principals -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-xl shadow p-5">
          <p class="text-gray-500 text-sm mb-1">Comandes avui</p>
          <p class="text-3xl font-bold text-blue-600">{stats.comandesAvui}</p>
          <p class="text-sm text-gray-400">
            {stats.vendesAvui.toFixed(2)} € en vendes
          </p>
        </div>
        <div class="bg-white rounded-xl shadow p-5">
          <p class="text-gray-500 text-sm mb-1">Comandes pendents</p>
          <p class="text-3xl font-bold text-orange-500">
            {stats.comandesPendents}
          </p>
          <p class="text-sm text-gray-400">per processar</p>
        </div>
        <div class="bg-white rounded-xl shadow p-5">
          <p class="text-gray-500 text-sm mb-1">Vendes setmana</p>
          <p class="text-3xl font-bold text-[#3BB143]">
            {stats.vendesSetmana.toFixed(2)} €
          </p>
          <p class="text-sm text-gray-400">{stats.comandesSetmana} comandes</p>
        </div>
        <div class="bg-white rounded-xl shadow p-5">
          <p class="text-gray-500 text-sm mb-1">Vendes mes</p>
          <p class="text-3xl font-bold text-purple-600">
            {stats.vendesMes.toFixed(2)} €
          </p>
          <p class="text-sm text-gray-400">aquest mes</p>
        </div>
      </div>

      <!-- Segona fila d'stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-xl shadow p-5">
          <p class="text-gray-500 text-sm mb-1">Total comandes</p>
          <p class="text-3xl font-bold text-gray-900">{stats.totalComandes}</p>
        </div>
        <div class="bg-white rounded-xl shadow p-5">
          <p class="text-gray-500 text-sm mb-1">Total clients</p>
          <p class="text-3xl font-bold text-gray-900">{stats.totalClients}</p>
        </div>
        <div class="bg-white rounded-xl shadow p-5">
          <p class="text-gray-500 text-sm mb-1">Repartidors</p>
          <p class="text-3xl font-bold text-gray-900">
            {stats.totalRepartidors}
          </p>
          <p class="text-sm text-green-600">
            {stats.repartidorsActius} actius ara
          </p>
        </div>
        <div
          class="bg-white rounded-xl shadow p-5 flex items-center justify-center"
        >
          <a
            href="/admin/historial"
            class="text-center hover:opacity-80 transition-opacity"
          >
            <svg
              class="w-8 h-8 mx-auto text-red-600 mb-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
              ></path>
            </svg>
            <p class="font-medium text-gray-900">Veure historial</p>
            <p class="text-xs text-gray-500">Totes les entregues</p>
          </a>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- Últimes comandes -->
        <div class="bg-white rounded-xl shadow overflow-hidden">
          <div
            class="px-6 py-4 border-b border-gray-200 flex items-center justify-between"
          >
            <h2 class="font-semibold text-gray-900">Últimes comandes</h2>
            <a
              href="/admin/historial"
              class="text-sm text-red-600 hover:underline">Veure totes →</a
            >
          </div>
          {
            ultimesComandes.length === 0 ? (
              <div class="p-8 text-center text-gray-500">
                <p>No hi ha comandes encara</p>
              </div>
            ) : (
              <div class="divide-y divide-gray-100 max-h-96 overflow-y-auto">
                {ultimesComandes.map((comanda) => (
                  <div class="p-4 hover:bg-gray-50">
                    <div class="flex items-center justify-between mb-1">
                      <span class="font-medium text-gray-900">
                        #{comanda.numero_pedido}
                      </span>
                      <span
                        class={`px-2 py-0.5 text-xs rounded-full ${getEstatClass(comanda.estado)}`}
                      >
                        {traduirEstat(comanda.estado)}
                      </span>
                    </div>
                    <p class="text-sm text-gray-600">
                      {comanda.cliente_nombre}
                    </p>
                    <div class="flex items-center justify-between mt-1">
                      <span class="text-xs text-gray-400">
                        {new Date(comanda.fecha_pedido).toLocaleString(
                          "ca-ES",
                          {
                            day: "2-digit",
                            month: "2-digit",
                            hour: "2-digit",
                            minute: "2-digit",
                          }
                        )}
                      </span>
                      <span class="font-bold text-gray-900">
                        {Number(comanda.total || 0).toFixed(2)} €
                      </span>
                    </div>
                    {comanda.repartidor_nombre && (
                      <p class="text-xs text-orange-600 mt-1">
                        🛵 {comanda.repartidor_nombre}
                      </p>
                    )}
                  </div>
                ))}
              </div>
            )
          }
        </div>

        <!-- Repartidors -->
        <div class="bg-white rounded-xl shadow overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="font-semibold text-gray-900">Repartidors</h2>
          </div>
          {
            repartidorsActius.length === 0 ? (
              <div class="p-8 text-center text-gray-500">
                <p>No hi ha repartidors registrats</p>
              </div>
            ) : (
              <div class="divide-y divide-gray-100 max-h-96 overflow-y-auto">
                {repartidorsActius.map((rep) => (
                  <div class="p-4 hover:bg-gray-50">
                    <div class="flex items-center justify-between">
                      <div class="flex items-center">
                        <div
                          class={`w-3 h-3 rounded-full mr-3 ${rep.disponible ? "bg-green-500" : "bg-gray-300"}`}
                        />
                        <div>
                          <p class="font-medium text-gray-900">{rep.nombre}</p>
                          <p class="text-xs text-gray-500">{rep.email}</p>
                        </div>
                      </div>
                      <div class="text-right">
                        <div class="flex items-center justify-end">
                          <svg
                            class="w-4 h-4 text-yellow-400 mr-1"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                          >
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                          </svg>
                          <span class="text-sm font-medium">
                            {Number(rep.valoracion_media || 5).toFixed(1)}
                          </span>
                        </div>
                        <p class="text-xs text-gray-500 mt-1">
                          {rep.entregues_actives > 0 ? (
                            <span class="text-orange-600">
                              {rep.entregues_actives} en curs
                            </span>
                          ) : (
                            <span>{rep.entregues_avui} avui</span>
                          )}
                        </p>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )
          }
        </div>
      </div>

      <!-- Accions ràpides -->
      <div class="mt-6 bg-white rounded-xl shadow p-6">
        <h2 class="font-semibold text-gray-900 mb-4">Accions ràpides</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <a
            href="/admin"
            class="flex items-center p-4 bg-red-50 rounded-lg hover:bg-red-100 transition-colors"
          >
            <div
              class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center mr-3"
            >
              <svg
                class="w-5 h-5 text-red-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
                ></path>
              </svg>
            </div>
            <div>
              <p class="font-medium text-gray-900">Gestió usuaris</p>
              <p class="text-xs text-gray-500">Panell admin</p>
            </div>
          </a>
          <a
            href="/admin/historial"
            class="flex items-center p-4 bg-blue-50 rounded-lg hover:bg-blue-100 transition-colors"
          >
            <div
              class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center mr-3"
            >
              <svg
                class="w-5 h-5 text-blue-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                ></path>
              </svg>
            </div>
            <div>
              <p class="font-medium text-gray-900">Historial</p>
              <p class="text-xs text-gray-500">Totes les entregues</p>
            </div>
          </a>
          <a
            href="/productes"
            class="flex items-center p-4 bg-green-50 rounded-lg hover:bg-green-100 transition-colors"
          >
            <div
              class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center mr-3"
            >
              <svg
                class="w-5 h-5 text-green-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                ></path>
              </svg>
            </div>
            <div>
              <p class="font-medium text-gray-900">Productes</p>
              <p class="text-xs text-gray-500">Catàleg</p>
            </div>
          </a>
          <a
            href="/"
            class="flex items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors"
          >
            <div
              class="w-10 h-10 bg-gray-200 rounded-lg flex items-center justify-center mr-3"
            >
              <svg
                class="w-5 h-5 text-gray-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                ></path>
              </svg>
            </div>
            <div>
              <p class="font-medium text-gray-900">Web pública</p>
              <p class="text-xs text-gray-500">Inici</p>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  document.getElementById("logout-btn")?.addEventListener("click", async () => {
    try {
      await fetch("/api/auth/logout", { method: "POST" });
      window.location.href = "/";
    } catch (e) {
      console.error("Error tancant sessió:", e);
    }
  });
</script>
