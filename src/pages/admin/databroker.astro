        </div>

        <!-- Segments i consentiments -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div class="bg-white rounded-xl shadow overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
              <h3 class="text-lg font-semibold text-gray-900">
                Segments de Clients
              </h3>
            </div>
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                  <tr>
                    <th
                      class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                      >Segment</th
                    >
                    <th
                      class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase"
                      >Usuaris</th
                    >
                    <th
                      class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase"
                      >Gasto Mitjà</th
                    >
                  </tr>
                </thead>
                <tbody
                  id="table-segments"
                  class="bg-white divide-y divide-gray-200"
                >
                  <tr
                    ><td colspan="3" class="px-6 py-4 text-center text-gray-500"
                      >Carregant...</td
                    ></tr
                  >
                </tbody>
              </table>
            </div>
          </div>

          <div class="bg-white rounded-xl shadow overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200 bg-green-50">
              <h3 class="text-lg font-semibold text-gray-900">Consentiments</h3>
            </div>
            <div class="p-6" id="consentiments-container">
              <p class="text-gray-500">Carregant...</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Tab: Tracking -->
      <div id="tab-tracking" class="tab-content hidden">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
          <!-- Events per hora -->
          <div class="bg-white rounded-xl shadow p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">
              Events per Hora del Dia
            </h3>
            <div class="h-64">
              <canvas id="canvas-events-hora"></canvas>
            </div>
          </div>

          <!-- Navegadors -->
          <div class="bg-white rounded-xl shadow p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">
              Distribució per Navegador
            </h3>
            <div class="h-64">
              <canvas id="canvas-navegadors"></canvas>
            </div>
          </div>
        </div>

        <!-- Clicks en productes -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div class="bg-white rounded-xl shadow overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
              <h3 class="text-lg font-semibold text-gray-900">
                Clicks en Productes
              </h3>
            </div>
            <div class="overflow-x-auto max-h-80">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50 sticky top-0">
                  <tr>
                    <th
                      class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                      >Producte</th
                    >
                    <th
                      class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase"
                      >Clics</th
                    >
                  </tr>
                </thead>
                <tbody
                  id="table-clicks-productes"
                  class="bg-white divide-y divide-gray-200"
                >
                  <tr
                    ><td colspan="2" class="px-6 py-4 text-center text-gray-500"
                      >Carregant...</td
                    ></tr
                  >
                </tbody>
              </table>
            </div>
          </div>

          <div class="bg-white rounded-xl shadow overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
              <h3 class="text-lg font-semibold text-gray-900">
                Afegits al Carret
              </h3>
            </div>
            <div class="overflow-x-auto max-h-80">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50 sticky top-0">
                  <tr>
                    <th
                      class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                      >Producte</th
                    >
                    <th
                      class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase"
                      >Vegades</th
                    >
                  </tr>
                </thead>
                <tbody
                  id="table-carret"
                  class="bg-white divide-y divide-gray-200"
                >
                  <tr
                    ><td colspan="2" class="px-6 py-4 text-center text-gray-500"
                      >Carregant...</td
                    ></tr
                  >
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script>
    // @ts-nocheck
    // Variables globals
    let currentPeriodo = "30d";
    let statsData = null;
    let productesData = null;
    let usuarisData = null;
    let charts = {};

    // Funcions d'utilitat
    function formatNumber(num) {
      if (num >= 1000000) return (num / 1000000).toFixed(1) + "M";
      if (num >= 1000) return (num / 1000).toFixed(1) + "K";
      return num?.toLocaleString() || "0";
    }

    function formatCurrency(num) {
      return new Intl.NumberFormat("ca-ES", {
        style: "currency",
        currency: "EUR",
      }).format(num || 0);
    }

    function formatDate(dateStr) {
      const date = new Date(dateStr);
      return date.toLocaleDateString("ca-ES", {
        day: "2-digit",
        month: "short",
      });
    }

    function truncateText(text, maxLength = 30) {
      if (!text) return "-";
      return text.length > maxLength
        ? text.substring(0, maxLength) + "..."
        : text;
    }

    // Gestió de tabs
    document.querySelectorAll(".tab-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const tabId = btn.dataset.tab;

        // Actualitzar botons
        document.querySelectorAll(".tab-btn").forEach((b) => {
          b.classList.remove("border-[#3BB143]", "text-[#3BB143]");
          b.classList.add("border-transparent", "text-gray-500");
        });
        btn.classList.add("border-[#3BB143]", "text-[#3BB143]");
        btn.classList.remove("border-transparent", "text-gray-500");

        // Mostrar tab
        document
          .querySelectorAll(".tab-content")
          .forEach((t) => t.classList.add("hidden"));
        document.getElementById("tab-" + tabId)?.classList.remove("hidden");
      });
    });

    // Selector de període
    document
      .getElementById("periodo-selector")
      ?.addEventListener("change", (e) => {
        currentPeriodo = e.target.value;
        loadAllData();
      });

    // Botó refresh
    document.getElementById("refresh-btn")?.addEventListener("click", () => {
      loadAllData();
    });

    // Carregar dades
    async function loadAllData() {
      document.getElementById("loading")?.classList.remove("hidden");
      document
        .querySelectorAll(".tab-content")
        .forEach((t) => t.classList.add("hidden"));

      await Promise.all([loadStats(), loadProductes(), loadUsuaris()]);

      document.getElementById("loading")?.classList.add("hidden");
      document.getElementById("tab-general")?.classList.remove("hidden");
    }

    async function loadStats() {
      try {
        const res = await fetch(
          `/api/admin/databroker/stats?periodo=${currentPeriodo}`
        );
        statsData = await res.json();

        if (statsData.success) {
          // Actualitzar stats
          document.getElementById("stat-sessions").textContent = formatNumber(
            statsData.stats.totalSessions
          );
          document.getElementById("stat-events").textContent = formatNumber(
            statsData.stats.totalEvents
          );
          document.getElementById("stat-clicks").textContent = formatNumber(
            statsData.stats.totalClicks
          );
          document.getElementById("stat-pageviews").textContent = formatNumber(
            statsData.stats.totalPageviews
          );

          // Taula pàgines
          const tablePagines = document.getElementById("table-pagines");
          if (statsData.paginasVisitades?.length > 0) {
            tablePagines.innerHTML = statsData.paginasVisitades
              .map(
                (p) => `
              <tr>
                <td class="px-6 py-3 text-sm text-gray-900 w-3/5">${truncateText(p.pagina, 80)}</td>
                <td class="px-6 py-3 text-sm text-gray-600 text-right w-1/5">${formatNumber(p.visites)}</td>
                <td class="px-6 py-3 text-sm text-gray-600 text-right w-1/5">${formatNumber(p.sessions_uniques)}</td>
              </tr>
            `
              )
              .join("");
          } else {
            tablePagines.innerHTML =
              '<tr><td colspan="3" class="px-6 py-4 text-center text-gray-500">No hi ha dades</td></tr>';
          }

          // Gràfics
          renderEventsPerDiaChart(statsData.eventsPerDia);
          renderDispositiusChart(statsData.dispositius);
          renderEventsPerHoraChart(statsData.eventsPerHora);
          renderNavegadorsChart(statsData.navegadors);
        }
      } catch (error) {
        console.error("Error carregant stats:", error);
      }
    }

    async function loadProductes() {
      try {
        const res = await fetch(
          `/api/admin/databroker/productes?periodo=${currentPeriodo}`
        );
        productesData = await res.json();

        if (productesData.success) {
          // Stats
          document.getElementById("stat-total-productes").textContent =
            formatNumber(productesData.resum.totalProductes);
          document.getElementById("stat-productes-venuts").textContent =
            formatNumber(productesData.resum.productesVenuts);
          document.getElementById("stat-ingressos").textContent =
            formatCurrency(productesData.resum.ingressosTotals);

          // Taula productes top
          const tableTop = document.getElementById("table-productes-top");
          if (productesData.productesMesDemands?.length > 0) {
            tableTop.innerHTML = productesData.productesMesDemands
              .map(
                (p, i) => `
              <tr class="${i < 3 ? "bg-green-50" : ""}">
                <td class="px-4 py-3 text-sm">
                  <div class="flex items-center">
                    <span class="mr-2 font-bold text-gray-600">${i < 3 ? ["#1", "#2", "#3"][i] : ""}</span>
                    <span class="font-medium text-gray-900">${truncateText(p.nombre, 25)}</span>
                  </div>
                </td>
                <td class="px-4 py-3 text-sm text-gray-600">${p.categoria || "-"}</td>
                <td class="px-4 py-3 text-sm text-gray-900 text-right font-semibold">${p.vegades_demanat}</td>
                <td class="px-4 py-3 text-sm text-gray-600 text-right">${p.unitats_venudes || 0}</td>
                <td class="px-4 py-3 text-sm text-[#3BB143] text-right font-semibold">${formatCurrency(p.ingressos)}</td>
              </tr>
            `
              )
              .join("");
          } else {
            tableTop.innerHTML =
              '<tr><td colspan="5" class="px-6 py-4 text-center text-gray-500">No hi ha dades</td></tr>';
          }

          // Taula productes bottom
          const tableBottom = document.getElementById("table-productes-bottom");
          if (productesData.productesMenysDemands?.length > 0) {
            tableBottom.innerHTML = productesData.productesMenysDemands
              .map(
                (p) => `
              <tr>
                <td class="px-4 py-3 text-sm text-gray-900">${truncateText(p.nombre, 25)}</td>
                <td class="px-4 py-3 text-sm text-gray-600">${p.categoria || "-"}</td>
                <td class="px-4 py-3 text-sm text-red-600 text-right font-semibold">${p.vegades_demanat}</td>
                <td class="px-4 py-3 text-sm text-gray-600 text-right">${p.unitats_venudes || 0}</td>
              </tr>
            `
              )
              .join("");
          } else {
            tableBottom.innerHTML =
              '<tr><td colspan="4" class="px-6 py-4 text-center text-gray-500">No hi ha dades</td></tr>';
          }

          // Productes no venuts
          const tableNoVenuts = document.getElementById(
            "table-productes-no-venuts"
          );
          if (productesData.productesNoVenuts?.length > 0) {
            tableNoVenuts.innerHTML = productesData.productesNoVenuts
              .map(
                (p) => `
              <tr>
                <td class="px-4 py-3 text-sm text-gray-900">${truncateText(p.nombre, 25)}</td>
                <td class="px-4 py-3 text-sm text-gray-600">${p.empresa || "-"}</td>
                <td class="px-4 py-3 text-sm text-gray-600 text-right">${formatCurrency(p.precio)}</td>
              </tr>
            `
              )
              .join("");
          } else {
            tableNoVenuts.innerHTML =
              '<tr><td colspan="3" class="px-6 py-4 text-center text-gray-500">Tots els productes tenen vendes!</td></tr>';
          }

          // Clicks i carret
          const tableClicks = document.getElementById("table-clicks-productes");
          if (productesData.clicksProductes?.length > 0) {
            tableClicks.innerHTML = productesData.clicksProductes
              .map(
                (p) => `
              <tr>
                <td class="px-6 py-3 text-sm text-gray-900">${p.product_name || `Producte #${p.product_id}` || "-"}</td>
                <td class="px-6 py-3 text-sm text-gray-600 text-right">${formatNumber(p.clics)}</td>
              </tr>
            `
              )
              .join("");
          } else {
            tableClicks.innerHTML =
              '<tr><td colspan="2" class="px-6 py-4 text-center text-gray-500">No hi ha dades de tracking</td></tr>';
          }

          const tableCarret = document.getElementById("table-carret");
          if (productesData.productesCarret?.length > 0) {
            tableCarret.innerHTML = productesData.productesCarret
              .map(
                (p) => `
              <tr>
                <td class="px-6 py-3 text-sm text-gray-900">${p.product_name || `Producte #${p.product_id}` || "-"}</td>
                <td class="px-6 py-3 text-sm text-gray-600 text-right">${formatNumber(p.vegades_afegit)}</td>
              </tr>
            `
              )
              .join("");
          } else {
            tableCarret.innerHTML =
              '<tr><td colspan="2" class="px-6 py-4 text-center text-gray-500">No hi ha dades de tracking</td></tr>';
          }

          // Gràfic categories
          renderCategoriesChart(productesData.vendesPerCategoria);
        }
      } catch (error) {
        console.error("Error carregant productes:", error);
      }
    }

    async function loadUsuaris() {
      try {
        const res = await fetch(
          `/api/admin/databroker/usuaris?periodo=${currentPeriodo}`
        );
        usuarisData = await res.json();

        if (usuarisData.success) {
          // Stats
          document.getElementById("stat-total-usuaris").textContent =
            formatNumber(usuarisData.resum.totalUsuaris);
          document.getElementById("stat-usuaris-compres").textContent =
            formatNumber(usuarisData.resum.usuarisAmbCompres);
          document.getElementById("stat-data-good").textContent = formatNumber(
            usuarisData.resum.consentimentsDataBroker
          );

          // Segments
          const tableSegments = document.getElementById("table-segments");
          if (usuarisData.segments?.length > 0) {
            tableSegments.innerHTML = usuarisData.segments
              .map(
                (s) => `
              <tr>
                <td class="px-6 py-3 text-sm">
                  <span class="font-medium text-gray-900">${s.segment}</span>
                </td>
                <td class="px-6 py-3 text-sm text-gray-600 text-right">${formatNumber(s.usuaris)}</td>
                <td class="px-6 py-3 text-sm text-[#3BB143] text-right font-semibold">${formatCurrency(s.gasto_medio)}</td>
              </tr>
            `
              )
              .join("");
          } else {
            tableSegments.innerHTML =
              '<tr><td colspan="3" class="px-6 py-4 text-center text-gray-500">No hi ha dades</td></tr>';
          }

          // Consentiments
          const consentimentsContainer = document.getElementById(
            "consentiments-container"
          );
          if (usuarisData.consentiments) {
            const c = usuarisData.consentiments;
            consentimentsContainer.innerHTML = `
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <span class="text-gray-700">Compartir Dades (Data for Good)</span>
                  <span class="text-lg font-bold text-[#3BB143]">${c.compartir_datos || 0}</span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-gray-700">Comunicacions</span>
                  <span class="text-lg font-bold text-blue-600">${c.acepta_comunicaciones || 0}</span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-gray-700">Analytics</span>
                  <span class="text-lg font-bold text-purple-600">${c.analytics || 0}</span>
                </div>
                <div class="pt-4 border-t">
                  <div class="flex items-center justify-between">
                    <span class="text-gray-700 font-medium">Total Usuaris amb Consentiment</span>
                    <span class="text-xl font-bold text-gray-900">${c.total || 0}</span>
                  </div>
                </div>
              </div>
            `;
          }

          // Gràfics
          renderUsuarisPerDiaChart(usuarisData.usuarisPerDia);
          renderRolsChart(usuarisData.usuarisPerRol);
        }
      } catch (error) {
        console.error("Error carregant usuaris:", error);
      }
    }

    // Funcions de gràfics
    function renderEventsPerDiaChart(data) {
      if (!data || data.length === 0) return;

      const ctx = document.getElementById("canvas-events-dia");
      if (charts.eventsDia) charts.eventsDia.destroy();

      charts.eventsDia = new Chart(ctx, {
        type: "line",
        data: {
          labels: data.map((d) => formatDate(d.dia)),
          datasets: [
            {
              label: "Events",
              data: data.map((d) => d.total),
              borderColor: "#3BB143",
              backgroundColor: "rgba(59, 177, 67, 0.1)",
              fill: true,
              tension: 0.4,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: "bottom" } },
        },
      });
    }

    function renderDispositiusChart(data) {
      if (!data || data.length === 0) return;

      const ctx = document.getElementById("canvas-dispositius");
      if (charts.dispositius) charts.dispositius.destroy();

      charts.dispositius = new Chart(ctx, {
        type: "doughnut",
        data: {
          labels: data.map((d) => d.dispositiu),
          datasets: [
            {
              data: data.map((d) => d.total),
              backgroundColor: ["#3BB143", "#6366f1", "#f59e0b"],
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: "bottom" } },
        },
      });
    }

    function renderEventsPerHoraChart(data) {
      if (!data || data.length === 0) return;

      const ctx = document.getElementById("canvas-events-hora");
      if (charts.eventsHora) charts.eventsHora.destroy();

      charts.eventsHora = new Chart(ctx, {
        type: "bar",
        data: {
          labels: data.map((d) => d.hora + ":00"),
          datasets: [
            {
              label: "Events",
              data: data.map((d) => d.total),
              backgroundColor: "#3BB143",
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
        },
      });
    }

    function renderNavegadorsChart(data) {
      if (!data || data.length === 0) return;

      const ctx = document.getElementById("canvas-navegadors");
      if (charts.navegadors) charts.navegadors.destroy();

      charts.navegadors = new Chart(ctx, {
        type: "pie",
        data: {
          labels: data.map((d) => d.navegador),
          datasets: [
            {
              data: data.map((d) => d.total),
              backgroundColor: [
                "#3BB143",
                "#6366f1",
                "#f59e0b",
                "#ef4444",
                "#8b5cf6",
              ],
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: "bottom" } },
        },
      });
    }

    function renderCategoriesChart(data) {
      if (!data || data.length === 0) return;

      const ctx = document.getElementById("canvas-categories");
      if (charts.categories) charts.categories.destroy();

      charts.categories = new Chart(ctx, {
        type: "bar",
        data: {
          labels: data.map((d) => d.categoria || "Altres"),
          datasets: [
            {
              label: "Ingressos (€)",
              data: data.map((d) => d.ingressos),
              backgroundColor: "#3BB143",
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          indexAxis: "y",
          plugins: { legend: { display: false } },
        },
      });
    }

    function renderUsuarisPerDiaChart(data) {
      if (!data || data.length === 0) return;

      const ctx = document.getElementById("canvas-usuaris-dia");
      if (charts.usuarisDia) charts.usuarisDia.destroy();

      charts.usuarisDia = new Chart(ctx, {
        type: "line",
        data: {
          labels: data.map((d) => formatDate(d.dia)),
          datasets: [
            {
              label: "Nous Usuaris",
              data: data.map((d) => d.nous_usuaris),
              borderColor: "#6366f1",
              backgroundColor: "rgba(99, 102, 241, 0.1)",
              fill: true,
              tension: 0.4,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
        },
      });
    }

    function renderRolsChart(data) {
      if (!data || data.length === 0) return;

      const ctx = document.getElementById("canvas-rols");
      if (charts.rols) charts.rols.destroy();

      charts.rols = new Chart(ctx, {
        type: "doughnut",
        data: {
          labels: data.map((d) => d.rol),
          datasets: [
            {
              data: data.map((d) => d.total),
              backgroundColor: ["#3BB143", "#6366f1", "#f59e0b"],
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: "bottom" } },
        },
      });
    }

    function getCategoryColor(category) {
      const colors = {
        navigation: "bg-blue-100 text-blue-800",
        product: "bg-green-100 text-green-800",
        cart: "bg-orange-100 text-orange-800",
        form: "bg-purple-100 text-purple-800",
        eco: "bg-emerald-100 text-emerald-800",
        interactive: "bg-yellow-100 text-yellow-800",
        footer: "bg-gray-100 text-gray-800",
        content: "bg-slate-100 text-slate-800",
      };
      return colors[category] || "bg-gray-100 text-gray-800";
    }

    // Carregar dades al iniciar
    loadAllData();
  </script>
</Layout>
