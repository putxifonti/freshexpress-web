---
import Layout from "../layouts/Layout.astro";
import { verifyToken, getUserById } from "../lib/auth";
import { queryOperacional } from "../lib/db";

// Verificar autenticació
const token = Astro.cookies.get("auth_token")?.value;
let user = null;

if (token) {
  const payload = verifyToken(token);
  if (payload) {
    user = await getUserById(payload.userId);
  }
}

if (!user) {
  return Astro.redirect("/login");
}

// Obtenir items de la cistella per verificar
let totalItems = 0;
let subtotal = 0;

try {
  const items = await queryOperacional<any[]>(
    `
    SELECT c.cantidad, p.precio, p.precio_oferta
    FROM carrito c
    JOIN productos p ON c.producto_id = p.id
    WHERE c.usuario_id = ?
  `,
    [user.id]
  );

  items.forEach((item) => {
    const precio = Number(item.precio_oferta || item.precio);
    subtotal += precio * Number(item.cantidad);
    totalItems += Number(item.cantidad);
  });
  subtotal = Math.round(subtotal * 100) / 100;
} catch (error) {
  console.error("Error verificant cistella:", error);
}

if (totalItems === 0) {
  return Astro.redirect("/cistella");
}

// Obtenir adreça guardada de l'usuari
const direccioGuardada = user.direccion || "";
const costEnviament = subtotal >= 30 ? 0 : 3.99;
const total = Math.round((subtotal + costEnviament) * 100) / 100;
---

<Layout title="Direcció d'entrega - FreshExpress">
  <div class="min-h-screen bg-gray-100 py-8">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Navegació -->
      <div class="mb-6">
        <a
          href="/cistella"
          class="text-[#3BB143] hover:text-[#32a039] text-sm font-medium flex items-center"
        >
          <svg
            class="w-4 h-4 mr-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"></path>
          </svg>
          Tornar a la cistella
        </a>
      </div>

      <!-- Progrés -->
      <div class="flex items-center justify-center mb-8">
        <div class="flex items-center">
          <div
            class="w-8 h-8 bg-[#3BB143] text-white rounded-full flex items-center justify-center font-bold text-sm"
          >
            ✓
          </div>
          <span class="ml-2 text-sm font-medium text-gray-900">Cistella</span>
        </div>
        <div class="w-12 h-1 bg-[#3BB143] mx-2"></div>
        <div class="flex items-center">
          <div
            class="w-8 h-8 bg-[#3BB143] text-white rounded-full flex items-center justify-center font-bold text-sm"
          >
            2
          </div>
          <span class="ml-2 text-sm font-medium text-gray-900">Direcció</span>
        </div>
        <div class="w-12 h-1 bg-gray-300 mx-2"></div>
        <div class="flex items-center">
          <div
            class="w-8 h-8 bg-gray-300 text-gray-600 rounded-full flex items-center justify-center font-bold text-sm"
          >
            3
          </div>
          <span class="ml-2 text-sm font-medium text-gray-500">Confirmar</span>
        </div>
      </div>

      <h1 class="text-2xl font-bold text-gray-900 mb-6">
        On vols rebre la comanda?
      </h1>

      <div class="space-y-6">
        <!-- Opció 1: Direcció guardada -->
        {
          direccioGuardada && (
            <div
              id="option-saved"
              class="bg-white rounded-xl shadow p-6 border-2 border-transparent hover:border-[#3BB143] cursor-pointer transition-colors address-option"
              data-address={direccioGuardada}
            >
              <div class="flex items-start">
                <div class="flex-shrink-0">
                  <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                    <svg
                      class="w-5 h-5 text-[#3BB143]"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                      />
                    </svg>
                  </div>
                </div>
                <div class="ml-4 flex-1">
                  <div class="flex items-center justify-between">
                    <h3 class="font-semibold text-gray-900">
                      Direcció guardada
                    </h3>
                    <div class="w-5 h-5 border-2 border-gray-300 rounded-full check-indicator" />
                  </div>
                  <p class="text-gray-600 mt-1">{direccioGuardada}</p>
                </div>
              </div>
            </div>
          )
        }

        <!-- Opció 2: Nova direcció -->
        <div
          id="option-new"
          class={`bg-white rounded-xl shadow p-6 border-2 transition-colors address-option ${!direccioGuardada ? "border-[#3BB143]" : "border-transparent hover:border-[#3BB143]"}`}
          data-address=""
        >
          <div class="flex items-start">
            <div class="flex-shrink-0">
              <div
                class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-5 h-5 text-[#0047AB]"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
            </div>
            <div class="ml-4 flex-1">
              <div class="flex items-center justify-between mb-3">
                <h3 class="font-semibold text-gray-900">
                  {
                    direccioGuardada
                      ? "Introduir nova direcció"
                      : "Direcció d'entrega"
                  }
                </h3>
                <div
                  class={`w-5 h-5 border-2 rounded-full check-indicator ${!direccioGuardada ? "bg-[#3BB143] border-[#3BB143]" : "border-gray-300"}`}
                >
                  {
                    !direccioGuardada && (
                      <svg
                        class="w-full h-full text-white p-0.5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="3"
                          d="M5 13l4 4L19 7"
                        />
                      </svg>
                    )
                  }
                </div>
              </div>
              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1"
                    >Direcció completa *</label
                  >
                  <input
                    type="text"
                    id="address-input"
                    placeholder="Carrer, número, pis, porta..."
                    class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-[#3BB143] focus:border-[#3BB143] transition-colors"
                  />
                </div>
                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1"
                      >Codi postal *</label
                    >
                    <input
                      type="text"
                      id="postal-code-input"
                      placeholder="08001"
                      maxlength="5"
                      class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-[#3BB143] focus:border-[#3BB143] transition-colors"
                    />
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1"
                      >Població *</label
                    >
                    <input
                      type="text"
                      id="city-input"
                      placeholder="Barcelona"
                      class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-[#3BB143] focus:border-[#3BB143] transition-colors"
                    />
                  </div>
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1"
                    >Notes pel repartidor (opcional)</label
                  >
                  <textarea
                    id="notes-input"
                    placeholder="Instruccions especials, timbre, etc..."
                    rows="2"
                    class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-[#3BB143] focus:border-[#3BB143] transition-colors resize-none"
                  ></textarea>
                </div>

                <!-- Guardar direcció -->
                <label class="flex items-center cursor-pointer">
                  <input
                    type="checkbox"
                    id="save-address"
                    class="w-4 h-4 text-[#3BB143] border-gray-300 rounded focus:ring-[#3BB143]"
                  />
                  <span class="ml-2 text-sm text-gray-600"
                    >Guardar aquesta direcció al meu perfil per a futures
                    comandes</span
                  >
                </label>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Resum -->
      <div class="bg-white rounded-xl shadow p-6 mt-6">
        <h3 class="font-semibold text-gray-900 mb-4">Resum de la comanda</h3>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between">
            <span class="text-gray-600">Subtotal ({totalItems} articles)</span>
            <span class="font-medium">{subtotal.toFixed(2)} €</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">Enviament</span>
            {
              costEnviament === 0 ? (
                <span class="font-medium text-[#3BB143]">Gratis</span>
              ) : (
                <span class="font-medium">{costEnviament.toFixed(2)} €</span>
              )
            }
          </div>
          <div class="border-t pt-2 mt-2 flex justify-between">
            <span class="font-semibold text-gray-900">Total</span>
            <span class="text-xl font-bold text-gray-900"
              >{total.toFixed(2)} €</span
            >
          </div>
        </div>
      </div>

      <!-- Botó continuar -->
      <button
        id="continue-btn"
        data-action="purchase"
        class="w-full mt-6 py-4 bg-[#3BB143] text-white font-bold rounded-xl hover:bg-[#32a039] transition-colors text-lg disabled:opacity-50 disabled:cursor-not-allowed"
      >
        Continuar
      </button>

      <p class="text-center text-sm text-gray-500 mt-4">
        El pagament es realitzarà contra reemborsament (efectiu a l'entrega)
      </p>
    </div>
  </div>
</Layout>

<style>
  .address-option.selected {
    border-color: #3bb143 !important;
  }
  .address-option.selected .check-indicator {
    background-color: #3bb143;
    border-color: #3bb143;
  }
</style>

<script define:vars={{ direccioGuardada, total }}>
  let selectedOption = direccioGuardada ? "saved" : "new";

  // Event listeners per les opcions
  document.querySelectorAll(".address-option").forEach((option) => {
    option.addEventListener("click", (e) => {
      // Si cliquem dins d'un input, no canviar selecció
      if (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA")
        return;

      const optionEl = option;
      const id = optionEl.id;

      // Deseleccionar tots
      document.querySelectorAll(".address-option").forEach((opt) => {
        opt.classList.remove("selected");
        opt.classList.remove("border-[#3BB143]");
        opt.classList.add("border-transparent");
        const check = opt.querySelector(".check-indicator");
        if (check) {
          check.innerHTML = "";
          check.classList.remove("bg-[#3BB143]", "border-[#3BB143]");
          check.classList.add("border-gray-300");
        }
      });

      // Seleccionar aquest
      optionEl.classList.add("selected", "border-[#3BB143]");
      optionEl.classList.remove("border-transparent");
      const check = optionEl.querySelector(".check-indicator");
      if (check) {
        check.classList.add("bg-[#3BB143]", "border-[#3BB143]");
        check.classList.remove("border-gray-300");
        check.innerHTML =
          '<svg class="w-full h-full text-white p-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>';
      }

      selectedOption = id === "option-saved" ? "saved" : "new";
    });
  });

  // Focus en inputs activa opció nova
  document
    .querySelectorAll("#option-new input, #option-new textarea")
    .forEach((input) => {
      input.addEventListener("focus", () => {
        const newOption = document.getElementById("option-new");
        if (newOption && selectedOption !== "new") {
          newOption.click();
        }
      });
    });

  // Botó continuar
  document
    .getElementById("continue-btn")
    ?.addEventListener("click", async () => {
      const btn = document.getElementById("continue-btn");
      if (!btn) return;

      let direccio = "";
      let notes = "";
      let saveAddress = false;

      if (selectedOption === "saved") {
        direccio = direccioGuardada;
      } else {
        const address = document.getElementById("address-input").value.trim();
        const postalCode = document
          .getElementById("postal-code-input")
          .value.trim();
        const city = document.getElementById("city-input").value.trim();
        notes = document.getElementById("notes-input").value.trim();
        saveAddress = document.getElementById("save-address").checked;

        if (!address || !postalCode || !city) {
          alert(
            "Si us plau, completa tots els camps obligatoris de la direcció"
          );
          return;
        }

        if (!/^\d{5}$/.test(postalCode)) {
          alert("El codi postal ha de tenir 5 dígits");
          return;
        }

        direccio = `${address}, ${postalCode} ${city}`;
      }

      btn.disabled = true;
      btn.textContent = "Processant...";

      try {
        // Primer guardar direcció si cal
        if (saveAddress && selectedOption === "new") {
          try {
            const addressRes = await fetch("/api/user/update-address", {
              method: "PUT",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ direccion: direccio }),
            });

            if (!addressRes.ok) {
              console.warn(
                "No s'ha pogut guardar la direcció, però continuem amb la comanda"
              );
            }
          } catch (addressError) {
            console.warn("Error guardant direcció:", addressError);
            // Continuem igualment amb la comanda
          }
        }

        // Finalitzar comanda
        const res = await fetch("/api/checkout/finalitzar", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            direccion: direccio,
            notas: notes,
          }),
        });

        if (!res.ok) {
          const errorData = await res
            .json()
            .catch(() => ({ error: "Error de connexió" }));
          throw new Error(
            errorData.error || `Error del servidor (${res.status})`
          );
        }

        const data = await res.json();

        if (data.success) {
          // Tracking de compra completada
          if (window.FreshExpressTracking) {
            try {
              window.FreshExpressTracking.trackCheckoutComplete({
                orderId: data.numeroPedido,
                total: data.total,
                items: data.items || [],
              });
              // Flush immediat abans de redirigir (sense await per no bloquejar)
              if (window.FreshExpressTracking.flush) {
                window.FreshExpressTracking.flush();
              }
            } catch (trackError) {
              console.warn("Error en tracking:", trackError);
            }
          }

          alert(
            `✅ Comanda realitzada correctament!\n\nNúmero de comanda: ${data.numeroPedido}\nTotal: ${data.total.toFixed(2)} €\n\nRebràs la teva comanda aviat!`
          );
          window.location.href = "/seguiment?code=" + data.numeroPedido;
        } else {
          throw new Error(data.error || "Error desconegut");
        }
      } catch (error) {
        console.error("Error en checkout:", error);

        // Tracking d'error en checkout
        if (window.FreshExpressTracking) {
          try {
            window.FreshExpressTracking.trackError("checkout_error", {
              message: error.message || "Error desconegut",
              step: "finalitzar_comanda",
            });
          } catch (trackError) {
            console.warn("Error en tracking d'error:", trackError);
          }
        }

        alert(
          "❌ Error: " + (error.message || "No s'ha pogut processar la comanda")
        );
        btn.disabled = false;
        btn.textContent = "Continuar";
      }
    });
</script>
