---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Zones de Cobertura - FreshExpress">
  <div class="min-h-screen bg-gray-50">
    <!-- Hero Section -->
    <div class="bg-gradient-to-br from-[#3BB143] to-[#0047AB] text-white py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Zones de Cobertura</h1>
        <p class="text-xl text-green-100 max-w-2xl mx-auto">
          Descobreix on lliurem i quan arribarem a la teva zona amb els nostres
          vehicles elèctrics
        </p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <!-- Mapa placeholder -->
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden mb-12">
        <div
          class="aspect-video bg-gray-200 relative flex items-center justify-center"
        >
          <div class="text-center p-8">
            <svg
              class="w-16 h-16 text-gray-400 mx-auto mb-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
              ></path>
            </svg>
            <p class="text-gray-500">Mapa interactiu de zones de cobertura</p>
            <p class="text-sm text-gray-400 mt-2">
              Integració amb Google Maps pròximament
            </p>
          </div>
          <!-- Overlay decoratiu -->
          <div
            class="absolute inset-0 bg-gradient-to-r from-green-500/10 to-blue-500/10"
          >
          </div>
        </div>
      </div>

      <!-- Zones actives -->
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Zones Actives</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        <!-- Barcelona Ciutat -->
        <div
          class="bg-white rounded-xl shadow-md p-6 border-l-4 border-[#3BB143]"
        >
          <div class="flex items-start justify-between">
            <div>
              <h3 class="text-lg font-semibold text-gray-900">
                Barcelona Ciutat
              </h3>
              <p class="text-gray-500 text-sm mt-1">Tots els districtes</p>
            </div>
            <span
              class="px-2 py-1 bg-green-100 text-green-800 text-xs font-medium rounded-full"
            >
              Actiu
            </span>
          </div>
          <div class="mt-4 space-y-2 text-sm text-gray-600">
            <div class="flex items-center">
              <svg
                class="w-4 h-4 mr-2 text-[#3BB143]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Lliurament en 1-2 hores
            </div>
            <div class="flex items-center">
              <svg
                class="w-4 h-4 mr-2 text-[#3BB143]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              100% vehicles elèctrics
            </div>
          </div>
        </div>

        <!-- L'Hospitalet -->
        <div
          class="bg-white rounded-xl shadow-md p-6 border-l-4 border-[#3BB143]"
        >
          <div class="flex items-start justify-between">
            <div>
              <h3 class="text-lg font-semibold text-gray-900">
                L'Hospitalet de Llobregat
              </h3>
              <p class="text-gray-500 text-sm mt-1">Zona urbana</p>
            </div>
            <span
              class="px-2 py-1 bg-green-100 text-green-800 text-xs font-medium rounded-full"
            >
              Actiu
            </span>
          </div>
          <div class="mt-4 space-y-2 text-sm text-gray-600">
            <div class="flex items-center">
              <svg
                class="w-4 h-4 mr-2 text-[#3BB143]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Lliurament en 2-3 hores
            </div>
            <div class="flex items-center">
              <svg
                class="w-4 h-4 mr-2 text-[#3BB143]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              Vehicles elèctrics i càrrega
            </div>
          </div>
        </div>

        <!-- Badalona -->
        <div
          class="bg-white rounded-xl shadow-md p-6 border-l-4 border-[#3BB143]"
        >
          <div class="flex items-start justify-between">
            <div>
              <h3 class="text-lg font-semibold text-gray-900">Badalona</h3>
              <p class="text-gray-500 text-sm mt-1">Centre i costa</p>
            </div>
            <span
              class="px-2 py-1 bg-green-100 text-green-800 text-xs font-medium rounded-full"
            >
              Actiu
            </span>
          </div>
          <div class="mt-4 space-y-2 text-sm text-gray-600">
            <div class="flex items-center">
              <svg
                class="w-4 h-4 mr-2 text-[#3BB143]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Lliurament en 2-3 hores
            </div>
            <div class="flex items-center">
              <svg
                class="w-4 h-4 mr-2 text-[#3BB143]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              Bicicletes i furgonetes elèctriques
            </div>
          </div>
        </div>
      </div>

      <!-- Zones pròximament -->
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Pròximament</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-16">
        {
          [
            "Sabadell",
            "Terrassa",
            "Mataró",
            "Girona",
            "Tarragona",
            "Lleida",
            "Sant Cugat",
            "Castelldefels",
          ].map((ciutat) => (
            <div class="bg-white rounded-lg shadow p-4 border-l-4 border-gray-300">
              <div class="flex items-center justify-between">
                <span class="font-medium text-gray-700">{ciutat}</span>
                <span class="px-2 py-1 bg-gray-100 text-gray-600 text-xs font-medium rounded-full">
                  2025
                </span>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Comprova el teu codi postal -->
      <div
        class="bg-gradient-to-r from-[#3BB143]/10 to-[#0047AB]/10 rounded-2xl p-8"
      >
        <div class="max-w-xl mx-auto text-center">
          <h3 class="text-2xl font-bold text-gray-900 mb-4">
            Comprova si lliurem a casa teva
          </h3>
          <p class="text-gray-600 mb-6">
            Introdueix el teu codi postal per veure si FreshExpress arriba a la
            teva zona
          </p>

          <form
            id="check-coverage"
            class="flex flex-col sm:flex-row gap-4 justify-center"
          >
            <input
              type="text"
              id="postal-code"
              placeholder="Codi postal (ex: 08001)"
              pattern="[0-9]{5}"
              maxlength="5"
              class="px-6 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3BB143] text-center text-lg w-full sm:w-48"
            />
            <button
              type="submit"
              class="px-6 py-3 bg-[#3BB143] text-white font-medium rounded-lg hover:bg-[#2d8a33] transition-colors"
            >
              Comprovar
            </button>
          </form>

          <div id="coverage-result" class="mt-6 hidden"></div>
        </div>
      </div>

      <!-- Informació addicional -->
      <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center p-6">
          <div
            class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <svg
              class="w-8 h-8 text-[#3BB143]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h4 class="font-semibold text-gray-900 mb-2">100% Elèctric</h4>
          <p class="text-gray-600 text-sm">
            Tots els nostres vehicles són elèctrics o de zero emissions
          </p>
        </div>

        <div class="text-center p-6">
          <div
            class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <svg
              class="w-8 h-8 text-[#0047AB]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h4 class="font-semibold text-gray-900 mb-2">Lliurament Ràpid</h4>
          <p class="text-gray-600 text-sm">
            Rebràs la teva comanda el mateix dia en zones actives
          </p>
        </div>

        <div class="text-center p-6">
          <div
            class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <svg
              class="w-8 h-8 text-purple-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"
              ></path>
            </svg>
          </div>
          <h4 class="font-semibold text-gray-900 mb-2">Seguiment en Directe</h4>
          <p class="text-gray-600 text-sm">
            Rastreig en temps real del teu lliurament
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById("check-coverage") as HTMLFormElement;
  const resultDiv = document.getElementById(
    "coverage-result"
  ) as HTMLDivElement;

  // Codis postals amb cobertura (simulació)
  const zonesActives = [
    "08001",
    "08002",
    "08003",
    "08004",
    "08005",
    "08006",
    "08007",
    "08008",
    "08009",
    "08010",
    "08011",
    "08012",
    "08013",
    "08014",
    "08015",
    "08016",
    "08017",
    "08018",
    "08019",
    "08020",
    "08021",
    "08022",
    "08023",
    "08024",
    "08025",
    "08026",
    "08027",
    "08028",
    "08029",
    "08030",
    "08031",
    "08032",
    "08033",
    "08034",
    "08035",
    "08036",
    "08037",
    "08038",
    "08039",
    "08040",
    "08041",
    "08042",
    "08901",
    "08902",
    "08903",
    "08904",
    "08905",
    "08906",
    "08911",
    "08912",
    "08913",
    "08914",
    "08915",
    "08916",
    "08917",
    "08918",
  ];

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const postalCode = (
      document.getElementById("postal-code") as HTMLInputElement
    ).value;

    if (postalCode.length !== 5 || !/^\d+$/.test(postalCode)) {
      resultDiv.innerHTML = `
        <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 rounded-lg p-4">
          Si us plau, introdueix un codi postal vàlid de 5 dígits.
        </div>
      `;
      resultDiv.classList.remove("hidden");
      return;
    }

    if (zonesActives.includes(postalCode)) {
      resultDiv.innerHTML = `
        <div class="bg-green-50 border border-green-200 text-green-800 rounded-lg p-4">
          <div class="flex items-center justify-center">
            <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="font-medium">Bona notícia! Lliurem a la zona ${postalCode}</span>
          </div>
          <p class="mt-2 text-sm">Temps estimat de lliurament: 1-3 hores</p>
          <a href="/registre" class="inline-block mt-4 px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">
            Crea el teu compte →
          </a>
        </div>
      `;
    } else {
      resultDiv.innerHTML = `
        <div class="bg-gray-50 border border-gray-200 text-gray-700 rounded-lg p-4">
          <div class="flex items-center justify-center">
            <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="font-medium">Encara no lliurem a ${postalCode}</span>
          </div>
          <p class="mt-2 text-sm">Estem expandint-nos! Deixa'ns el teu email per avisar-te quan arribem.</p>
          <input type="email" placeholder="El teu email" class="mt-3 px-4 py-2 border rounded-lg w-full max-w-xs" />
        </div>
      `;
    }
    resultDiv.classList.remove("hidden");
  });
</script>
