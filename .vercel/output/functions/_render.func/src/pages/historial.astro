---
import Layout from "../layouts/Layout.astro";
import { verifyToken, getUserById } from "../lib/auth";
import { queryOperacional } from "../lib/db";

// Verificar autenticació
const token = Astro.cookies.get("auth_token")?.value;
let user = null;

if (token) {
  const payload = verifyToken(token);
  if (payload) {
    user = await getUserById(payload.userId);
  }
}

if (!user) {
  return Astro.redirect("/login");
}

// Obtenir comandes reals de la BD amb info de repartidor i notes
let comandes: any[] = [];
try {
  const pedidos = await queryOperacional<any[]>(
    `
    SELECT 
      p.id,
      p.numero_pedido,
      p.fecha_pedido,
      p.estado,
      p.total,
      p.notas_repartidor,
      p.valoracion_cliente,
      p.comentario_valoracion,
      p.repartidor_id,
      u.nombre as repartidor_nombre,
      GROUP_CONCAT(DISTINCT pr.nombre SEPARATOR ', ') as productes
    FROM pedidos p
    LEFT JOIN detalle_pedido dp ON p.id = dp.pedido_id
    LEFT JOIN productos pr ON dp.producto_id = pr.id
    LEFT JOIN repartidores r ON p.repartidor_id = r.id
    LEFT JOIN usuarios u ON r.usuario_id = u.id
    WHERE p.cliente_id = ?
    GROUP BY p.id
    ORDER BY p.fecha_pedido DESC
    LIMIT 20
  `,
    [user.id]
  );

  comandes = pedidos.map((p: any) => ({
    id: p.numero_pedido || `FE-${p.id}`,
    pedidoId: p.id,
    data: new Date(p.fecha_pedido).toLocaleDateString("ca-ES"),
    estat: traduirEstat(p.estado),
    estatOriginal: p.estado,
    productes: p.productes || "Comanda sense productes",
    total: Number(p.total) || 0,
    notesRepartidor: p.notas_repartidor,
    valoracioClient: p.valoracion_cliente,
    comentariValoracio: p.comentario_valoracion,
    repartidorId: p.repartidor_id,
    repartidorNom: p.repartidor_nombre,
  }));
} catch (error) {
  console.error("Error carregant historial:", error);
}

// Funció per traduir estat al català
function traduirEstat(estat: string): string {
  const traduccions: Record<string, string> = {
    pendiente: "Pendent",
    confirmado: "Confirmat",
    preparando: "Preparant",
    listo: "Llest",
    en_camino: "En camí",
    entregado: "Lliurat",
    cancelado: "Cancel·lat",
  };
  return traduccions[estat] || estat;
}

// Funció per obtenir color estat
function getEstatColor(estat: string): string {
  const colors: Record<string, string> = {
    pendiente: "bg-yellow-100 text-yellow-800",
    confirmado: "bg-blue-100 text-blue-800",
    preparando: "bg-purple-100 text-purple-800",
    listo: "bg-indigo-100 text-indigo-800",
    en_camino: "bg-orange-100 text-orange-800",
    entregado: "bg-green-100 text-green-800",
    cancelado: "bg-red-100 text-red-800",
  };
  return colors[estat] || "bg-gray-100 text-gray-800";
}
---

<Layout title="Historial de Comandes - FreshExpress">
  <div class="min-h-screen bg-gray-100 py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Navegació -->
      <div class="mb-6">
        <a
          href="/dashboard"
          class="text-[#3BB143] hover:text-[#32a039] text-sm font-medium flex items-center"
        >
          <svg
            class="w-4 h-4 mr-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"></path>
          </svg>
          Tornar al Dashboard
        </a>
      </div>

      <div class="bg-white rounded-xl shadow-lg p-6 md:p-8">
        <h1 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
          <svg
            class="w-7 h-7 mr-3 text-[#0047AB]"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
            ></path>
          </svg>
          Historial de Comandes
        </h1>

        <!-- Filtres -->
        <div class="flex flex-wrap gap-4 mb-6">
          <select
            class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3BB143]"
          >
            <option>Tots els estats</option>
            <option>Lliurat</option>
            <option>En trànsit</option>
            <option>Cancel·lat</option>
          </select>
          <input
            type="month"
            class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3BB143]"
            value="2024-12"
          />
        </div>

        <!-- Llista de comandes -->
        <div class="space-y-4">
          {
            comandes.length === 0 ? (
              <div class="text-center py-12">
                <svg
                  class="w-16 h-16 mx-auto text-gray-300 mb-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"
                  />
                </svg>
                <p class="text-gray-500 mb-4">Encara no tens cap comanda</p>
                <a
                  href="/productes"
                  class="inline-block px-6 py-2 bg-[#3BB143] text-white rounded-lg hover:bg-[#32a039] transition-colors"
                >
                  Descobreix els nostres productes
                </a>
              </div>
            ) : (
              comandes.map((comanda) => (
                <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
                  <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center">
                      <span class="font-mono font-medium text-gray-900">
                        {comanda.id}
                      </span>
                      <span
                        class={`ml-3 px-2 py-1 rounded-full text-xs font-medium ${getEstatColor(comanda.estatOriginal)}`}
                      >
                        {comanda.estat}
                      </span>
                    </div>
                    <span class="text-sm text-gray-500">{comanda.data}</span>
                  </div>

                  <p class="text-sm text-gray-600 mb-3 line-clamp-2">
                    {comanda.productes}
                  </p>

                  {/* Mostrar notes del repartidor si hi ha problemes */}
                  {comanda.notesRepartidor &&
                    comanda.estatOriginal === "cancelado" && (
                      <div class="mb-3 p-3 bg-red-50 border border-red-200 rounded-lg">
                        <div class="flex items-start gap-2">
                          <svg
                            class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                            />
                          </svg>
                          <div>
                            <p class="text-sm font-medium text-red-800">
                              Problema reportat
                            </p>
                            <p class="text-sm text-red-600">
                              {comanda.notesRepartidor}
                            </p>
                          </div>
                        </div>
                      </div>
                    )}

                  {/* Mostrar info del repartidor si va ser entregat */}
                  {comanda.estatOriginal === "entregado" &&
                    comanda.repartidorNom && (
                      <div class="mb-3 text-sm text-gray-500 flex items-center gap-1">
                        <svg
                          class="w-4 h-4"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                          />
                        </svg>
                        Entregat per: {comanda.repartidorNom}
                      </div>
                    )}

                  {/* Mostrar valoració existent */}
                  {comanda.valoracioClient && (
                    <div class="mb-3 flex items-center gap-2">
                      <span class="text-sm text-gray-500">
                        La teva valoració:
                      </span>
                      <div class="flex items-center">
                        {[1, 2, 3, 4, 5].map((star) => (
                          <svg
                            class={`w-4 h-4 ${star <= comanda.valoracioClient ? "text-yellow-400" : "text-gray-300"}`}
                            fill="currentColor"
                            viewBox="0 0 20 20"
                          >
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                          </svg>
                        ))}
                      </div>
                      {comanda.comentariValoracio && (
                        <span class="text-xs text-gray-400 italic">
                          "{comanda.comentariValoracio}"
                        </span>
                      )}
                    </div>
                  )}

                  <div class="flex items-center justify-between">
                    <span class="font-bold text-lg text-gray-900">
                      {Number(comanda.total || 0).toFixed(2)} €
                    </span>
                    <div class="flex gap-2 flex-wrap justify-end">
                      <a
                        href={`/seguiment?code=${comanda.id}`}
                        class="px-3 py-1.5 text-sm text-[#3BB143] border border-[#3BB143] rounded-lg hover:bg-[#3BB143] hover:text-white transition-colors"
                      >
                        Veure detalls
                      </a>

                      {/* Botó valorar - només si entregat, té repartidor i no s'ha valorat */}
                      {comanda.estatOriginal === "entregado" &&
                        comanda.repartidorId &&
                        !comanda.valoracioClient && (
                          <button
                            class="btn-valorar px-3 py-1.5 text-sm text-yellow-600 border border-yellow-400 rounded-lg hover:bg-yellow-50 transition-colors flex items-center gap-1"
                            data-pedido={comanda.id}
                            data-repartidor={comanda.repartidorNom}
                          >
                            <svg
                              class="w-4 h-4"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
                              />
                            </svg>
                            Valorar
                          </button>
                        )}

                      {/* Botó repetir comanda - només si entregat */}
                      {comanda.estatOriginal === "entregado" && (
                        <button
                          class="btn-repetir px-3 py-1.5 text-sm text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-100 transition-colors"
                          data-pedido={comanda.id}
                        >
                          Repetir comanda
                        </button>
                      )}
                    </div>
                  </div>
                </div>
              ))
            )
          }
        </div>

        <!-- Resum -->
        <div class="mt-8 p-4 bg-gray-50 rounded-lg">
          <div class="grid grid-cols-3 gap-4 text-center">
            <div>
              <p class="text-2xl font-bold text-gray-900">{comandes.length}</p>
              <p class="text-sm text-gray-500">Comandes totals</p>
            </div>
            <div>
              <p class="text-2xl font-bold text-[#3BB143]">
                {
                  comandes
                    .reduce((sum, c) => sum + Number(c.total || 0), 0)
                    .toFixed(2)
                } €
              </p>
              <p class="text-sm text-gray-500">Total gastat</p>
            </div>
            <div>
              <p class="text-2xl font-bold text-[#0047AB]">
                {(comandes.length * 0.8).toFixed(1)} kg
              </p>
              <p class="text-sm text-gray-500">CO₂ estalviat</p>
            </div>
          </div>
        </div>

        <!-- Paginació -->
        <div class="mt-6 flex justify-center">
          <nav class="flex gap-2">
            <button class="px-3 py-1 text-gray-500 hover:bg-gray-100 rounded"
              >←</button
            >
            <button class="px-3 py-1 bg-[#3BB143] text-white rounded">1</button>
            <button class="px-3 py-1 text-gray-600 hover:bg-gray-100 rounded"
              >2</button
            >
            <button class="px-3 py-1 text-gray-600 hover:bg-gray-100 rounded"
              >3</button
            >
            <button class="px-3 py-1 text-gray-500 hover:bg-gray-100 rounded"
              >→</button
            >
          </nav>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal de valoració -->
  <div
    id="modal-valoracio"
    class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50"
  >
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full mx-4 p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-bold text-gray-900">Valora el repartidor</h3>
        <button id="close-modal" class="text-gray-400 hover:text-gray-600">
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <p class="text-gray-600 mb-4">
        Com ha estat l'experiència amb <span
          id="repartidor-nom"
          class="font-medium"></span>?
      </p>

      <input type="hidden" id="valoracio-pedido" value="" />

      <!-- Estrelles -->
      <div class="flex justify-center gap-2 mb-4">
        {
          [1, 2, 3, 4, 5].map((star) => (
            <button
              class="star-btn text-gray-300 hover:text-yellow-400 transition-colors"
              data-value={star}
            >
              <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            </button>
          ))
        }
      </div>

      <p id="valoracio-text" class="text-center text-gray-500 mb-4">
        Selecciona una puntuació
      </p>

      <!-- Comentari opcional -->
      <textarea
        id="valoracio-comentari"
        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#3BB143] focus:border-transparent resize-none"
        rows="3"
        placeholder="Deixa un comentari (opcional)..."></textarea>

      <div class="flex gap-3 mt-4">
        <button
          id="cancel-valoracio"
          class="flex-1 px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-100 transition-colors"
        >
          Cancel·lar
        </button>
        <button
          id="submit-valoracio"
          class="flex-1 px-4 py-2 bg-[#3BB143] text-white rounded-lg hover:bg-[#32a039] transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          disabled
        >
          Enviar valoració
        </button>
      </div>
    </div>
  </div>

  <script is:inline>
    // Repetir comanda
    document.querySelectorAll(".btn-repetir").forEach((btn) => {
      btn.addEventListener("click", async function () {
        const pedido = this.dataset.pedido;
        const originalText = this.innerHTML;

        this.innerHTML =
          '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';
        this.disabled = true;

        try {
          const response = await fetch("/api/cart/repetir", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ numeroPedido: pedido }),
          });

          const data = await response.json();

          if (data.success) {
            window.location.href = data.redirect || "/cistella";
          } else {
            alert(data.error || "Error repetint la comanda");
            this.innerHTML = originalText;
            this.disabled = false;
          }
        } catch (error) {
          alert("Error de connexió");
          this.innerHTML = originalText;
          this.disabled = false;
        }
      });
    });

    // Valorar repartidor
    const modal = document.getElementById("modal-valoracio");
    const repartidorNom = document.getElementById("repartidor-nom");
    const valoracioPedido = document.getElementById("valoracio-pedido");
    const valoracioText = document.getElementById("valoracio-text");
    const submitBtn = document.getElementById("submit-valoracio");
    const starBtns = document.querySelectorAll(".star-btn");
    let selectedRating = 0;

    const ratingTexts = {
      1: "Molt dolent 😞",
      2: "Dolent 😕",
      3: "Normal 😐",
      4: "Bé 🙂",
      5: "Excel·lent! 🌟",
    };

    // Obrir modal
    document.querySelectorAll(".btn-valorar").forEach((btn) => {
      btn.addEventListener("click", function () {
        valoracioPedido.value = this.dataset.pedido;
        repartidorNom.textContent = this.dataset.repartidor || "el repartidor";
        selectedRating = 0;
        updateStars(0);
        valoracioText.textContent = "Selecciona una puntuació";
        document.getElementById("valoracio-comentari").value = "";
        submitBtn.disabled = true;
        modal.classList.remove("hidden");
        modal.classList.add("flex");
      });
    });

    // Tancar modal
    document
      .getElementById("close-modal")
      .addEventListener("click", closeModal);
    document
      .getElementById("cancel-valoracio")
      .addEventListener("click", closeModal);
    modal.addEventListener("click", function (e) {
      if (e.target === modal) closeModal();
    });

    function closeModal() {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    }

    // Gestionar estrelles
    function updateStars(rating) {
      starBtns.forEach((btn, index) => {
        if (index < rating) {
          btn.classList.remove("text-gray-300");
          btn.classList.add("text-yellow-400");
        } else {
          btn.classList.add("text-gray-300");
          btn.classList.remove("text-yellow-400");
        }
      });
    }

    starBtns.forEach((btn) => {
      btn.addEventListener("click", function () {
        selectedRating = parseInt(this.dataset.value);
        updateStars(selectedRating);
        valoracioText.textContent = ratingTexts[selectedRating];
        submitBtn.disabled = false;
      });

      btn.addEventListener("mouseenter", function () {
        const hoverRating = parseInt(this.dataset.value);
        updateStars(hoverRating);
      });

      btn.addEventListener("mouseleave", function () {
        updateStars(selectedRating);
      });
    });

    // Enviar valoració
    submitBtn.addEventListener("click", async function () {
      if (selectedRating === 0) return;

      const originalText = this.innerHTML;
      this.innerHTML = "Enviant...";
      this.disabled = true;

      try {
        const response = await fetch("/api/user/valorar-repartidor", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            numeroPedido: valoracioPedido.value,
            valoracion: selectedRating,
            comentario: document.getElementById("valoracio-comentari").value,
          }),
        });

        const data = await response.json();

        if (data.success) {
          closeModal();
          // Recarregar per veure la valoració
          window.location.reload();
        } else {
          alert(data.error || "Error enviant la valoració");
          this.innerHTML = originalText;
          this.disabled = false;
        }
      } catch (error) {
        alert("Error de connexió");
        this.innerHTML = originalText;
        this.disabled = false;
      }
    });
  </script>
</Layout>
