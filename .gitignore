# ===========================================
# FreshExpress - .gitignore
# ===========================================
# Aquest fitxer defineix què NO es puja a GitHub per seguretat
# Més info: https://git-scm.com/docs/gitignore

# PATTERNS VÀLIDS (sense comentaris en línia)
.env
.env.local
.env.*.local
.env.production
.env.development.local
.env.test.local
!.env.example
build.log
.astro/
.vercel/
dist/
node_modules/
logs/
*.log
*.log.*
*.tmp
*.temp
.cache/
ML/
*.ipynb
*.keras
*.h5
*.pkl
*.csv

# ===========================================
# 🔒 SEGURETAT - FITXERS SENSIBLES
# ===========================================
# ⚠️ MOLT IMPORTANT: Aquests fitxers contenen secrets i NO s'han de publicar MAI

# -----------------------------------------
# VARIABLES D'ENTORN (Credencials)
# -----------------------------------------
# Fitxers amb contrasenyes, API keys i secrets
.env                    # Configuració local amb secrets REALS
.env.local              # Variables d'entorn locals
.env.*.local            # Variants locals per entorn
.env.production         # Configuració de producció amb secrets
.env.development.local  # Desenvolupament local
.env.test.local         # Testing local

# ✅ Excepció: .env.example SÍ es puja (només plantilla sense secrets)
!.env.example

# -----------------------------------------
# CREDENCIALS I CLAUS
# -----------------------------------------
# Claus privades i certificats SSL/TLS
*.pem                   # Certificats privats
*.key                   # Claus privades
*.p12                   # Certificats PKCS#12
*.pfx                   # Certificats Windows
.ssh/                   # Claus SSH
credentials.json        # Credencials de serveis (Google, AWS, etc.)
serviceAccount*.json    # Service accounts
.secrets/               # Carpeta de secrets

# ===========================================
# 🗄️ BASES DE DADES
# ===========================================

# -----------------------------------------
# BACKUPS DE BD (Dades personals)
# -----------------------------------------
# Backups poden contenir informació sensible d'usuaris
*.sql                   # Dumps de MySQL/PostgreSQL amb dades reals
*.sql.gz                # Backups comprimits
*.sql.zip               # Backups zipats
*.dump                  # PostgreSQL dumps
*.sqlite                # Bases de dades SQLite locals
*.db                    # Altres formats de BD
backups/                # Carpeta de backups
dumps/                  # Carpeta de dumps

# -----------------------------------------
# DADES CSV I DATASETS
# -----------------------------------------
# Poden contenir informació personal o propietària
*.csv                   # Dades en CSV
*.xlsx                  # Fulls de càlcul Excel
*.xls                   # Fulls de càlcul Excel vells
data/                   # Carpeta de dades
datasets/               # Datasets
exports/                # Exportacions

# ===========================================
# 🤖 MACHINE LEARNING
# ===========================================
# Models entrenats i notebooks amb dades sensibles
ML/                     # Carpeta ML completa
*.keras                 # Models Keras/TensorFlow
*.h5                    # Models HDF5
*.pkl                   # Models pickle Python
*.joblib                # Models scikit-learn
*.pt                    # Models PyTorch
*.pth                   # PyTorch checkpoints
*.onnx                  # Models ONNX
*.ipynb                 # Jupyter Notebooks (poden tenir outputs amb dades)
*.ipynb_checkpoints/    # Checkpoints de Jupyter
models/                 # Carpeta de models entrenats
*.model                 # Altres formats de models

# ===========================================
# 📝 LOGS I TRACES
# ===========================================

# -----------------------------------------
# LOGS D'APLICACIÓ
# -----------------------------------------
# Logs poden contenir informació sensible (IPs, emails, errors amb dades)
logs/                   # Carpeta de logs
*.log                   # Fitxers de log genèrics
*.log.*                 # Logs rotats
npm-debug.log*          # Logs de npm
yarn-debug.log*         # Logs de Yarn
yarn-error.log*         # Errors de Yarn
pnpm-debug.log*         # Logs de pnpm
lerna-debug.log*        # Logs de Lerna
build.log               # Logs de build d'Astro

# -----------------------------------------
# TRACES I DEBUGGING
# -----------------------------------------
trace/                  # Traces d'execució
*.trace                 # Fitxers de trace
*.heapsnapshot          # Heap snapshots de Node.js
*.cpuprofile            # CPU profiles

# ===========================================
# 🏗️ BUILD I COMPILACIÓ
# ===========================================
dist/                   # Build de producció
build/                  # Build alternatiu
out/                    # Output de builds
.astro/                 # Cache d'Astro
.next/                  # Next.js build
.nuxt/                  # Nuxt.js build
.output/                # Output generat
.vercel/                # Configuració Vercel
.netlify/               # Configuració Netlify

# ===========================================
# 📦 DEPENDÈNCIES
# ===========================================
node_modules/           # Dependències npm (massa grans)
bower_components/       # Dependències Bower (legacy)
jspm_packages/          # JSPM packages
vendor/                 # Vendors de tercers

# ===========================================
# 🔧 CONFIGURACIÓ DE PRODUCCIÓ
# ===========================================
# Fitxers de configuració amb secrets per producció
ecosystem.config.js     # PM2 config amb secrets
docker-compose.override.yml  # Docker overrides locals
.dockerignore           # Pot tenir info sensible
kubernetes-secrets.yaml # Secrets de Kubernetes
helm-values.yaml        # Values de Helm amb secrets

# ===========================================
# 💾 CACHE I TEMPORALS
# ===========================================
.cache/                 # Cache genèrica
.temp/                  # Fitxers temporals
.tmp/                   # Temporals alternatius
*.tmp                   # Fitxers temporals
*.temp                  # Temporals
*.swp                   # Vim swap files
*.swo                   # Vim swap alternatius
*~                      # Backup files
.sass-cache/            # Cache de Sass
.eslintcache            # Cache d'ESLint
.stylelintcache         # Cache de Stylelint
*.tsbuildinfo           # TypeScript build info

# ===========================================
# 🧪 TESTING
# ===========================================
coverage/               # Reports de cobertura de tests
.nyc_output/            # NYC coverage output
test-results/           # Resultats de tests
.coverage/              # Cobertura alternativa
*.lcov                  # LCOV coverage files

# ===========================================
# 👨‍💻 EDITORS I IDEs
# ===========================================

# -----------------------------------------
# Visual Studio Code
# -----------------------------------------
.vscode/*               # Configuració VSCode
!.vscode/extensions.json    # ✅ Extensions recomanades SÍ
!.vscode/settings.json      # ✅ Settings del projecte SÍ
!.vscode/launch.json        # ✅ Debug config SÍ (si no té secrets)
!.vscode/tasks.json         # ✅ Tasks SÍ

# -----------------------------------------
# JetBrains IDEs (WebStorm, IntelliJ, etc.)
# -----------------------------------------
.idea/                  # Configuració IntelliJ/WebStorm
*.iml                   # Mòduls IntelliJ
*.ipr                   # Projectes IntelliJ
*.iws                   # Workspace IntelliJ

# -----------------------------------------
# Altres editors
# -----------------------------------------
.vim/                   # Configuració Vim
.vimrc.local            # Vimrc local
*.sublime-project       # Projectes Sublime
*.sublime-workspace     # Workspaces Sublime

# ===========================================
# 🖥️ SISTEMA OPERATIU
# ===========================================

# -----------------------------------------
# macOS
# -----------------------------------------
.DS_Store               # Metadades de carpetes macOS
.DS_Store?              # Variants
.AppleDouble            # AppleDouble
.LSOverride             # Launch Services
._*                     # Fitxers de recursos
.Spotlight-V100         # Spotlight
.Trashes                # Paperera
.AppleDB                # Apple DB
.AppleDesktop           # Apple Desktop
Network Trash Folder    # Network trash
Temporary Items         # Temporals
.apdisk                 # Apple disk image

# -----------------------------------------
# Windows
# -----------------------------------------
Thumbs.db               # Cache de miniatures
Thumbs.db:encryptable   # Thumbs encriptables
ehthumbs.db             # Explorer miniatures
ehthumbs_vista.db       # Vista miniatures
*.stackdump             # Stack dumps
[Dd]esktop.ini          # Desktop.ini
$RECYCLE.BIN/           # Paperera Windows
*.cab                   # Fitxers cabinet
*.msi                   # Windows installers
*.msix                  # MSIX packages
*.msm                   # Merge modules
*.msp                   # Patch packages
*.lnk                   # Shortcuts

# -----------------------------------------
# Linux
# -----------------------------------------
*~                      # Backup files
.fuse_hidden*           # FUSE
.directory              # Dolphin
.Trash-*                # Paperera
.nfs*                   # NFS

# ===========================================
# 📱 ALTRES FITXERS SENSIBLES
# ===========================================

# -----------------------------------------
# Fitxers pujats per usuaris
# -----------------------------------------
uploads/                # Carpeta d'uploads (poden tenir dades personals)
public/uploads/         # Uploads públics
storage/                # Storage local
user-content/           # Contingut d'usuaris

# -----------------------------------------
# Sessions i tokens
# -----------------------------------------
sessions/               # Sessions locals
.session                # Fitxers de sessió
tokens/                 # Tokens guardats

# -----------------------------------------
# Misc
# -----------------------------------------
*.local                 # Qualsevol fitxer .local
.envrc                  # direnv config
.env.*.local            # Totes les variants locals

# ===========================================
# ℹ️ NOTES IMPORTANTS
# ===========================================
# 
# 📖 Què és el .gitignore?
# Aquest fitxer indica a Git quins fitxers i carpetes NO s'han de pujar
# al repositori per raons de seguretat, privacitat o rendiment.
#
# 🔒 Seguretat CRÍTICA:
# - .env conté contrasenyes i API keys REALS → MAI pujar-lo
# - Backups de BD tenen dades personals → MAI pujar-los
# - Logs poden tenir IPs i emails → MAI pujar-los
# - Models ML entrenats amb dades privades → MAI pujar-los
#
# ✅ Què SÍ es puja:
# - .env.example (plantilla sense secrets)
# - Codi font (.ts, .astro, .js, etc.)
# - Fitxers de configuració genèrics
# - Documentació (README, etc.)
# - SQL d'estructura (sense dades reals)
#
# 🆘 Si has pujat secrets per error:
# 1. NO només eliminar el commit (queda a l'històric!)
# 2. Regenerar TOTS els secrets exposats
# 3. Netejar l'històric de Git (git filter-branch)
# 4. Revocar API keys compromeses
#
# 📚 Més info:
# - Documentació Git: https://git-scm.com/docs/gitignore
# - GitHub Security: https://docs.github.com/en/code-security
# - Guia de seguretat: SECURITY.md
#
# ===========================================
node_modules
