# ===========================================
# FreshExpress - Variables d'entorn
# ===========================================
# Copia aquest fitxer a .env i configura els valors

# -----------------------------------------
# BASE DE DADES MYSQL
# -----------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=la_teva_contrasenya
DB_NAME_OPERACIONAL=freshexpress_operacional
DB_NAME_BROKER=freshexpress_databroker

# -----------------------------------------
# AUTENTICACIÓ JWT
# -----------------------------------------
# Genera un string aleatori segur (mínim 32 caràcters)
# Pots usar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=canvia_aixo_per_un_secret_aleatori_molt_llarg_i_segur_123456

# -----------------------------------------
# ENTORN
# -----------------------------------------
NODE_ENV=development

# -----------------------------------------
# ANONIMITZACIÓ (Data Broker)
# -----------------------------------------
# Salt per anonimitzar dades (genera un string aleatori)
ANONYMIZATION_SALT=canvia_aixo_per_un_salt_aleatori_segur

# -----------------------------------------
# GOOGLE MAPS (Opcional)
# -----------------------------------------
# Necessari per la funcionalitat de mapes i navegació
# Obtén una API key a: https://console.cloud.google.com/
# GOOGLE_MAPS_API_KEY=la_teva_api_key

# -----------------------------------------
# EMAIL (Opcional - per notificacions)
# -----------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=el_teu_email
# SMTP_PASSWORD=la_teva_contrasenya
# SMTP_FROM=noreply@freshexpress.cat
